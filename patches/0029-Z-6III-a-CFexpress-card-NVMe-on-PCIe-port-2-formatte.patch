+/*
+ * The CFexpress slot: PCIe port 2. This image's PCIe is ../z9-qemu's: four
+ * DesignWare root ports with DBI windows at 0x1a000000 + 0x400000 * n,
+ * unrolled iATU at DBI + 0x300000 (nikon-z63-usb.h, "two things that are
+ * not part of this complex"), link wrappers at 0x17b00000/0x17b80000, and
+ * the CFexpress card on port 2 -- its detect is index 2 * 2 + 13 of the
+ * EXS offset table, +0x044 (sub_4028C1CC) -- the port ../z9-qemu's adapter
+ * models: DBI 0x1a800000, its CPU aperture 0x600000000, the port's
+ * legacy-interrupt wrapper and INTID 0x95 (EXS_PCIE10_PCIE_MISC, SPI 117,
+ * in this image's interrupt-name table). z9_pcie_init puts QEMU's
+ * DesignWare host behind those windows; an NVMe device on its bus
+ * (-device nvme,bus=dw-pcie,addr=0) is the card.
+ *
+ * DMA. The adapter shows the device the board's DRAM at 0xa00000000
+ * (pcie-ram-dma-input, through z63_dram) and, where ../z9-qemu aliases its
+ * two image-bank RAM objects, this board has one BUFFER_EXT region at
+ * 0x840000000; it is aliased here instead (pcie-image-ram-dma-input is
+ * refused). DECLARED, as there: inbound addresses are identity.
+ */
+static void z63_z9lab_pcie_init(NikonZ9State *s, DeviceState *gic,
+                                MemoryRegion *buffer_ext)
+{
+    DesignwarePCIEHost *host;
+    MemoryRegion *alias;
+
+    z9_pcie_init(s, get_system_memory(), gic);
+    host = DESIGNWARE_PCIE_HOST(s->pcie_dbi_host);
+    if (buffer_ext) {
+        alias = g_new0(MemoryRegion, 1);
+        memory_region_init_alias(alias, OBJECT(s), "z63.pcie-buffer-ext",
+                                 buffer_ext, 0,
+                                 memory_region_size(buffer_ext));
+        memory_region_add_subregion_overlap(&host->pci.address_space_root,
+                                            UINT64_C(0x840000000), alias, -2);
+    }
+}
