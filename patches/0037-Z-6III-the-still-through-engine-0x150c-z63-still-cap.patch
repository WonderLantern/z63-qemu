     return !s->compat_miss;
 }
 
+/*
+ * z63-miss-log=on: name the writes the models decline. A declined write
+ * falls through to the board's own window, which stores it and says
+ * nothing -- so a model refusing a start (its admission rules) and a
+ * register no model covers look the same from outside. Each address is
+ * named for its first four distinct values, the PC with it; a declined
+ * write to engine 0x150c's control words also prints the model's admission
+ * state (active/latched/stop/reset), which is what decides. A debugging
+ * aid; off by default.
+ */
+static GHashTable *z63_z9lab_missed;
+
+static void z63_z9lab_log_miss(hwaddr addr, uint64_t value, unsigned size)
+{
+    uint64_t key = addr ^ (value << 32);
+    unsigned n;
+
+    if (!z63_z9lab_missed) {
+        z63_z9lab_missed = g_hash_table_new(g_int64_hash, g_int64_equal);
+    }
+    n = GPOINTER_TO_UINT(g_hash_table_lookup(z63_z9lab_missed, &addr));
+    if (n >= 4 || g_hash_table_contains(z63_z9lab_missed, &key)) {
+        return;
+    }
+    g_hash_table_insert(z63_z9lab_missed, g_memdup2(&addr, sizeof(addr)),
+                        GUINT_TO_POINTER(n + 1));
+    g_hash_table_insert(z63_z9lab_missed, g_memdup2(&key, sizeof(key)),
+                        GUINT_TO_POINTER(1));
+    fprintf(stderr, "Z63_Z9LAB_MISS write 0x%" HWADDR_PRIx " = 0x%" PRIx64
+            " (%u) pc=0x%" PRIx64 "\n", addr, value, size,
+            current_cpu ? ARM_CPU(current_cpu)->env.pc : 0);
+}
+
 bool z63_z9lab_write(Object *obj, hwaddr addr, uint64_t value, unsigned size)
 {
     NikonZ9State *s = NIKON_Z9_LAB(obj);
@@ -18874,6 +19007,23 @@ bool z63_z9lab_write(Object *obj, hwaddr addr, uint64_t value, unsigned size)
 
     s->compat_miss = false;
     unknown_write(s, addr, value, size);
+    if (s->compat_miss && z63_z9lab_miss_log_on) {
+        z63_z9lab_log_miss(addr, value, size);
+        if ((addr & ~0x7cull) == 0x150c0000 || addr == 0x150c0064) {
+            fprintf(stderr, "Z63_Z9LAB_MISS 150c state: active=%x latched=%x "
+                    "configured=%x req=%x done=%x dstop_done=%x idle_done=%x "
+                    "empty_end=%x reset_stage=%u resets=%" PRIu64
+                    " prev=%x timing=%d d980_submits=%" PRIu64 " d980_ready=%d\n",
+                    s->engine150c_active, s->engine150c_latched,
+                    s->engine150c_configured,
+                    s->engine150c_stop_requested, s->engine150c_stop_done,
+                    s->engine150c_direct_stop_done, s->primary_idle_direct_done,
+                    s->primary_empty_end_pending, s->primary_reset_stage,
+                    (uint64_t)s->primary_reset_count,
+                    s->primary_reset_previous_units, s->event_timing_active,
+                    (uint64_t)s->primary_d980_submits, primary_d980_ready(s));
+        }
+    }
     if (addr == 0x150c0008 && s->zr_primary_bank1_model &&
         (s->engine150c_active & ~was & 2)) {
         z63_z9lab_150c_started(s);
