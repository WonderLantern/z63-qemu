@@ -4874,6 +4876,16 @@ static void z63_prop_set_li_wait_ipc(Object *obj, bool value, Error **errp)
     s->li_wait_ipc = value;
 }
 
+static bool z63_prop_get_gfx_skip(Object *obj, Error **errp)
+{
+    return NIKON_Z63(obj)->gfx_skip_unmodelled;
+}
+
+static void z63_prop_set_gfx_skip(Object *obj, bool value, Error **errp)
+{
+    NIKON_Z63(obj)->gfx_skip_unmodelled = value;
+}
+
 static bool z63_prop_get_image_in_dram(Object *obj, Error **errp)
 {
     NikonZ63State *s = NIKON_Z63(obj);
@@ -5207,6 +5219,15 @@ static void z63_machine_class_init(ObjectClass *oc, const void *data)
         "wire is logged; empty (the default) leaves the pins as they were, "
         "which is what the two chips' own firmware reads. See nikon-z63.c's "
         "Z63McuWire.");
+    object_class_property_add_bool(oc, "gfx-skip-unmodelled",
+                                   z63_prop_get_gfx_skip,
+                                   z63_prop_set_gfx_skip);
+    object_class_property_set_description(oc, "gfx-skip-unmodelled",
+        "Drop a graphics draw the model cannot do, at its commit, instead of "
+        "stopping the machine: no pixels are written, fences complete, and "
+        "each distinct reason is named once on stderr. For runs that have to "
+        "get past the GUI; the picture is then knowingly incomplete. Off by "
+        "default. See nikon-z63-gfx.h.");
     object_class_property_add_bool(oc, "li-wait-ipc",
                                    z63_prop_get_li_wait_ipc,
                                    z63_prop_set_li_wait_ipc);
diff --git a/z63-tools/gui.sh b/z63-tools/gui.sh
index 522411d..52949bf 100755
--- a/z63-tools/gui.sh
+++ b/z63-tools/gui.sh
@@ -25,6 +25,11 @@
 # drive. Declared, and each wire is logged as Z63_MCU_WIRE.
 #
 #
+# Z63_LOG=<file> loads z63-tools/plugins/libz63log (build it with
+# z63-tools/plugins/build.sh) and writes the firmwares' own log calls there,
+# one line each: the RTOS's binary module logs, its kernel syslog and the
+# body MCU's error log. The build must be configured with -Dplugins=true.
+#
 # NAND is copied before every run (to $NAND.run) because the firmware
 # writes to it; the original is never touched. Without NAND the RTOS does
 # not get as far as the display.
@@ -62,9 +67,15 @@ if [ -n "${MCU:-}" ]; then
     [ -n "${MCU_SPI_PEER:-}" ] && OPT="$OPT,mcu-spi-peer=$MCU_SPI_PEER"
     SMP=4,maxcpus=5
 fi
+PLUGIN=""
+if [ -n "${Z63_LOG:-}" ]; then
+    lib=$(cd "$(dirname "$0")" && pwd)/plugins/libz63log
+    [ -f "$lib.dylib" ] && lib=$lib.dylib || lib=$lib.so
+    PLUGIN="-plugin $lib,out=$Z63_LOG"
+fi
 rm -f /tmp/z63-gui.sock
 exec "$QEMU" -name z63-gui -machine "nikon-z63$OPT" \
     -cpu cortex-a53 -smp "$SMP" -bios "$DIR/eg2010_0200i1.bi" \
     -serial file:/tmp/z63-gui-serial.log -monitor none \
     -qmp unix:/tmp/z63-gui.sock,server=on,wait=off \
-    -display cocoa -action shutdown=pause "$@"
+    -display cocoa -action shutdown=pause $PLUGIN "$@"
