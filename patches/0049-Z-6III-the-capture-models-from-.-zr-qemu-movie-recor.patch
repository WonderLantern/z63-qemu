+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Explicit functional FAST-9 and integer SAD translation, not Nikon KRAN.
+ * Original messages19/1a/1b name initialization/KLT-RANSAC/FAST. The static
+ * output view has32 header bytes,128x16 point records and20 trailer bytes.
+ * Arithmetic, threshold, age word and translation classification below are
+ * declared functional conventions; no CEVA instruction is executed.
+ */
+#define WL_MOTION_POINTS 128
+#define WL_MOTION_RESULT_BYTES 0x834
+typedef struct WlMotionPoint { uint16_t x, y, age; } WlMotionPoint;
+typedef struct WlMotionHistory {
+    uint8_t *previous;
+    unsigned width, height, stride, count;
+    WlMotionPoint points[WL_MOTION_POINTS];
+} WlMotionHistory;
+
+/* Functional MovingDetector adapter. Grid/descriptor ownership follows the
+ * original ARM ABI; integer block SAD and threshold arithmetic below are
+ * authored approximations, not executed XM6 instructions or Nikon MVD. */
+typedef struct WlMovingWork {
+    uint8_t *input[2];
+    uint64_t sources[2], destinations[8], workspace;
+    unsigned widths[2], heights[2], strides[2], pitches[8];
+    unsigned center_x, center_y, threshold, workspace_bytes;
+    int hint_x, hint_y;
+    unsigned valid_cells, foreground_cells;
+} WlMovingWork;
+typedef struct WlMotionJob {
+    QEMUTimer *timer;
+    uint8_t *input;
+    uint64_t config, source, result, workspace;
+    unsigned width, height, stride, input_bytes, result_bytes, opcode, group;
+    bool scheduled, ready, rx;
+    WlMotionHistory history[2];
+    WlMovingWork moving;
+    uint64_t requests, completed, replies, acks, cancelled, bytes_read, bytes_written;
+    uint32_t input_crc, result_crc, features, tracks, inliers, reject;
+    int32_t dx, dy;
+} WlMotionJob;
+
+static void motion_history_clear(WlMotionHistory *h)
+{ g_free(h->previous); memset(h, 0, sizeof(*h)); }
+
+static void motion_job_reset(WlMotionJob *m)
+{
+    if (m->scheduled || m->ready || m->rx) { m->cancelled++; }
+    if (m->timer) { timer_del(m->timer); }
+    g_free(m->input); m->input = NULL;
+    for (unsigned i = 0; i < 2; i++) {
+        g_free(m->moving.input[i]); m->moving.input[i] = NULL;
+    }
+    m->scheduled = m->ready = m->rx = false;
+    for (unsigned i = 0; i < 2; i++) { motion_history_clear(&m->history[i]); }
+}
+
+static unsigned motion_corner_score(const uint8_t *input, unsigned stride,
+                                     unsigned x, unsigned y)
+{
+    static const int ring[16][2] = {
+        {0,-3},{1,-3},{2,-2},{3,-1},{3,0},{3,1},{2,2},{1,3},
+        {0,3},{-1,3},{-2,2},{-3,1},{-3,0},{-3,-1},{-2,-2},{-1,-3}
+    };
+    int center = input[(size_t)y * stride + x], values[16];
+    for (unsigned i = 0; i < 16; i++) {
+        values[i] = (int)input[(size_t)((int)y + ring[i][1]) * stride + (int)x + ring[i][0]] - center;
+    }
+    unsigned best = 0;
+    for (unsigned start = 0; start < 16; start++) {
+        int bright = 255, dark = 255;
+        for (unsigned n = 0; n < 9; n++) {
+            int difference = values[(start + n) & 15];
+            bright = MIN(bright, difference); dark = MIN(dark, -difference);
+        }
+        best = MAX(best, MAX(0, MAX(bright, dark)));
+    }
+    return best;
+}
+
+/* One strong candidate per16x16 cell followed by score order and8px
+ * spacing keeps the pool bounded and spread over the actual image. */
+static unsigned motion_seed(WlMotionHistory *h, const uint8_t *input)
+{
+    typedef struct { unsigned x, y, score; } Candidate;
+    unsigned nx = (h->width + 15) / 16, ny = (h->height + 15) / 16;
+    Candidate *cells = g_new0(Candidate, (size_t)nx * ny);
+    for (unsigned y = 7; y + 7 < h->height; y++) {
+        for (unsigned x = 7; x + 7 < h->width; x++) {
+            unsigned score = motion_corner_score(input, h->stride, x, y);
+            Candidate *cell = &cells[(y / 16) * nx + x / 16];
+            if (score > 16 && score > cell->score) { *cell = (Candidate){x, y, score}; }
+        }
+    }
+    unsigned added = 0;
+    while (h->count < WL_MOTION_POINTS) {
+        Candidate best = {0}; unsigned index = 0;
+        for (unsigned i = 0; i < nx * ny; i++) {
+            if (cells[i].score > best.score) { best = cells[i]; index = i; }
+        }
+        if (!best.score) { break; }
+        cells[index].score = 0;
+        bool near = false;
+        for (unsigned i = 0; i < h->count; i++) {
+            int dx = (int)h->points[i].x - (int)best.x, dy = (int)h->points[i].y - (int)best.y;
+            if (dx * dx + dy * dy < 64) { near = true; break; }
+        }
+        if (!near) { h->points[h->count++] = (WlMotionPoint){best.x, best.y, 1}; added++; }
+    }
+    g_free(cells);
+    return added;
+}
+
+static unsigned motion_patch_sad(const WlMotionHistory *h, const uint8_t *current,
+                                  unsigned x, unsigned y, int dx, int dy)
+{
+    unsigned sad = 0;
+    for (int row = -3; row <= 3; row++) {
+        for (int col = -3; col <= 3; col++) {
+            int a = h->previous[(size_t)((int)y + row) * h->stride + (int)x + col];
+            int b = current[(size_t)((int)y + row + dy) * h->stride + (int)x + col + dx];
+            sad += abs(a - b);
+        }
+    }
+    return sad;
+}
+
+static int motion_median(int *values, unsigned count)
+{
+    for (unsigned i = 1; i < count; i++) {
+        int value = values[i]; unsigned j = i;
+        while (j && values[j - 1] > value) { values[j] = values[j - 1]; j--; }
+        values[j] = value;
+    }
+    return count ? values[count / 2] : 0;
+}
+
+static void motion_track(WlMotionJob *m, WlMotionHistory *h, uint8_t *result)
+{
+    int vx[WL_MOTION_POINTS], vy[WL_MOTION_POINTS];
+    WlMotionPoint kept[WL_MOTION_POINTS];
+    unsigned count = 0;
+    for (unsigned i = 0; h->previous && i < h->count; i++) {
+        WlMotionPoint point = h->points[i]; unsigned x = point.x, y = point.y;
+        if (x < 7 || y < 7 || x + 7 >= h->width || y + 7 >= h->height) { continue; }
+        int best_x = 0, best_y = 0;
+        unsigned best = motion_patch_sad(h, m->input, x, y, 0, 0);
+        if (best) {
+            for (int dy = -4; dy <= 4; dy++) {
+                for (int dx = -4; dx <= 4; dx++) {
+                    unsigned sad = motion_patch_sad(h, m->input, x, y, dx, dy);
+                    if (sad < best) { best = sad; best_x = dx; best_y = dy; }
+                }
+            }
+        }
+        if (best > 49 * 32) { continue; }
+        uint8_t *record = result + 32 + count * 16;
+        stw_le_p(record, x); stw_le_p(record + 2, y);
+        stw_le_p(record + 4, x + best_x); stw_le_p(record + 6, y + best_y);
+        stw_le_p(record + 8, point.age); /* Explicit functional age convention. */
+        stl_le_p(record + 12, 65536 - (uint64_t)best * 65536 / (49 * 255));
+        vx[count] = best_x; vy[count] = best_y;
+        kept[count] = (WlMotionPoint){x + best_x, y + best_y, MIN(65535, point.age + 1)};
+        count++;
+    }
+    int sorted_x[WL_MOTION_POINTS], sorted_y[WL_MOTION_POINTS];
+    memcpy(sorted_x, vx, count * sizeof(int)); memcpy(sorted_y, vy, count * sizeof(int));
+    m->dx = motion_median(sorted_x, count); m->dy = motion_median(sorted_y, count);
+    unsigned inliers = 0;
+    for (unsigned i = 0; i < count; i++) {
+        inliers += abs(vx[i] - m->dx) <= 1 && abs(vy[i] - m->dy) <= 1;
+    }
+    m->tracks = count; m->inliers = inliers;
+    if (count >= 3 && inliers * 2 >= count) {
+        stl_le_p(result, 2); /* Functional valid translation, not original KRAN classification. */
+        stl_le_p(result + 20, m->dx); stl_le_p(result + 24, m->dy);
+        stl_le_p(result + 28, inliers * 128 / count);
+    }
+    stl_le_p(result + 16, count); stl_le_p(result + 0x820, count);
+    memcpy(h->points, kept, count * sizeof(WlMotionPoint)); h->count = count;
+}
+
+static void motion_compute(WlMotionJob *m, uint8_t *result)
+{
+    WlMotionHistory *h = &m->history[m->group];
+    if (h->width != m->width || h->height != m->height || h->stride != m->stride) {
+        motion_history_clear(h); h->width = m->width; h->height = m->height; h->stride = m->stride;
+    }
+    m->features = m->tracks = m->inliers = 0; m->dx = m->dy = 0;
+    if (m->opcode == 0x1b) { m->features = motion_seed(h, m->input); stl_le_p(result, m->features); }
+    else { motion_track(m, h, result); }
+    g_free(h->previous); h->previous = m->input; m->input = NULL;
+}
+
+static void moving_compute(WlMovingWork *w, uint8_t planes[8][4096],
+                           uint8_t tail[16], uint8_t scratch[2048])
+{
+    memset(planes, 0, 8 * 4096);
+    memset(tail, 0, 16);
+    w->valid_cells = w->foreground_cells = 0;
+    for (unsigned image = 0; image < 2; image++) {
+        for (unsigned gy = 0; gy < 32; gy++) {
+            for (unsigned gx = 0; gx < 32; gx++) {
+                unsigned sum = 0;
+                for (unsigned dy = 0; dy < 4; dy++) {
+                    for (unsigned dx = 0; dx < 4; dx++) {
+                        unsigned x = w->center_x - 64 + gx * 4 + dx;
+                        unsigned y = w->center_y - 64 + gy * 4 + dy;
+                        sum += w->input[image][(size_t)y * w->strides[image] + x];
+                    }
+                }
+                scratch[image * 1024 + gy * 32 + gx] = (sum + 8) / 16;
+            }
+        }
+    }
+    unsigned min_x = 31, min_y = 31, max_x = 0, max_y = 0;
+    uint64_t total_x = 0, total_y = 0;
+    int hx = w->hint_x / 4, hy = w->hint_y / 4;
+    for (int y = 0; y < 32; y++) {
+        for (int x = 0; x < 32; x++) {
+            unsigned cell = y * 32 + x, minimum = 255, maximum = 0;
+            unsigned best = UINT_MAX, best_distance = UINT_MAX;
+            int bx = 0, by = 0;
+            for (int dy = hy - 2; dy <= hy + 2; dy++) {
+                for (int dx = hx - 2; dx <= hx + 2; dx++) {
+                    unsigned sad = 0, count = 0;
+                    for (int py = -2; py <= 2; py++) {
+                        for (int px = -2; px <= 2; px++) {
+                            int ax = x + px, ay = y + py, rx = ax - dx, ry = ay - dy;
+                            if (ax < 0 || ax >= 32 || ay < 0 || ay >= 32 ||
+                                    rx < 0 || rx >= 32 || ry < 0 || ry >= 32) { continue; }
+                            int a = scratch[ay * 32 + ax], b = scratch[1024 + ry * 32 + rx];
+                            sad += abs(a - b); count++;
+                            if (a < minimum) { minimum = a; }
+                            if (a > maximum) { maximum = a; }
+                        }
+                    }
+                    if (count < 9) { continue; }
+                    unsigned cost = (sad * 256 + count / 2) / count;
+                    unsigned distance = abs(dx - hx) + abs(dy - hy);
+                    if (cost < best || (cost == best && distance < best_distance)) {
+                        best = cost; best_distance = distance; bx = dx; by = dy;
+                    }
+                }
+            }
+            bool valid = best != UINT_MAX && maximum - minimum >= 8 && best <= 32 * 256;
+            unsigned difference = abs((int)scratch[cell] - scratch[1024 + cell]);
+            unsigned threshold = MAX(4, MIN(64, w->threshold / 8));
+            bool foreground = difference > threshold &&
+                (!valid || abs(bx - hx) + abs(by - hy) >= 1);
+            planes[0][cell] = foreground ? 255 : 0;
+            planes[1][cell] = valid ? 255 : 0;
+            stw_le_p(planes[2] + cell * 4, (int16_t)(bx * 4));
+            stw_le_p(planes[2] + cell * 4 + 2, (int16_t)(by * 4));
+            stw_le_p(planes[3] + cell * 2, (int16_t)(bx * 4));
+            stw_le_p(planes[4] + cell * 2, (int16_t)(by * 4));
+            stw_le_p(planes[5] + cell * 2, best == UINT_MAX ? 65535 : MIN(best, 65535));
+            stw_le_p(planes[6] + cell * 2, scratch[cell] * 16);
+            stw_le_p(planes[7] + cell * 2, scratch[1024 + cell] * 16);
+            w->valid_cells += valid;
+            if (foreground) {
+                w->foreground_cells++; total_x += x; total_y += y;
+                min_x = MIN(min_x, x); min_y = MIN(min_y, y);
+                max_x = MAX(max_x, x); max_y = MAX(max_y, y);
+            }
+        }
+    }
+    /* Explicit functional quality/no-foreground flags. Never unconditional
+     * task success: both values are derived from the actual image pair. */
+    tail[4] = w->valid_cells >= 16;
+    tail[5] = !w->foreground_cells;
+    if (w->foreground_cells) {
+        tail[0] = min_x; tail[1] = min_y; tail[2] = max_x; tail[3] = max_y;
+        stl_le_p(tail + 8, total_x / w->foreground_cells);
+        stl_le_p(tail + 12, total_y / w->foreground_cells);
+    }
+}
diff --git a/hw/arm/nikon-expeed-programmed-clock.h b/hw/arm/nikon-expeed-programmed-clock.h
new file mode 100644
index 0000000..454b769
--- /dev/null
+++ b/hw/arm/nikon-expeed-programmed-clock.h
@@ -0,0 +1,99 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Functional programmed-channel waveform from the explicit source clock.
+ * Native drivers register fifteen distinct channel callbacks and commit
+ * independent configuration. This implements the observed 06011000/20 mode
+ * class at one edge per explicit source period. The parameter units, waveform
+ * phases and physical timing are not established. No image completion, DMA,
+ * application notification or firmware address is selected here.
+ * Channels zero and one retain their existing independent producers.
+ */
+
+static uint32_t programmed_clock_configured_mask(NikonZ9State *s)
+{
+    uint32_t mask = 0;
+    for (unsigned ch = 2; ch < 15; ch++) {
+        const uint32_t *c = s->event_active_1508[ch];
+        /* Mode bit5 is retained as an opaque variant, not interpreted as an
+         * enable. The original MMIO channel/group controls supply enable.
+         * Only a fully committed, observed waveform class is admitted. */
+        if ((c[7] & ~UINT32_C(0x20)) == 0x06011000 && c[0] && c[1] && c[4] && c[5]) {
+            mask |= 1u << ch;
+        }
+    }
+    return mask;
+}
+
+static uint32_t programmed_clock_armed_mask(NikonZ9State *s)
+{
+    if (!s->event_programmed_clock_model || !s->bootstrap_fixtures ||
+        !s->event1508_channel_model || !s->event1508_timing_model ||
+        !s->event_timing_active) {
+        return 0;
+    }
+    return programmed_clock_configured_mask(s) & s->event_control_1508[3] &
+           s->event_output_group_running;
+}
+
+static void programmed_clock_tick(NikonZ9State *s)
+{
+    uint32_t armed = programmed_clock_armed_mask(s);
+    for (unsigned ch = 2; ch < 15; ch++) {
+        uint32_t bit = 1u << ch;
+        if (!(armed & bit)) {
+            continue;
+        }
+        s->event_programmed_clock_ticks[ch]++;
+        if (s->event_pending_1508 & bit) {
+            s->event_programmed_clock_coalesced[ch]++;
+        } else {
+            s->event_pending_1508 |= bit;
+            s->event_programmed_clock_events[ch]++;
+        }
+    }
+    /* The caller updates the existing fifteen-slot IRQ after all clock
+     * causes are ready. Masks only hide pending; its own W1C releases it. */
+}
+
+static bool get_event_programmed_clock_model(Object *obj, Error **errp)
+{
+    return NIKON_Z9_LAB(obj)->event_programmed_clock_model;
+}
+
+static void set_event_programmed_clock_model(Object *obj, bool value, Error **errp)
+{
+    NikonZ9State *s = NIKON_Z9_LAB(obj);
+    if (s->image_ram.ram || s->image_ram.rom_device) {
+        error_setg(errp, "programmed channel clock is immutable after realization");
+        return;
+    }
+    s->event_programmed_clock_model = value;
+}
+
+static char *get_event_programmed_clock_state(Object *obj, Error **errp)
+{
+    NikonZ9State *s = NIKON_Z9_LAB(obj);
+    GString *out = g_string_new(NULL);
+    g_string_append_printf(out, "{\"enabled\":%s,\"configured_mask\":%u,"
+        "\"armed_mask\":%u,\"channel_control\":%u,\"group_running\":%u,"
+        "\"pending\":%u,\"irq_mask\":%u,\"source_active\":%s,"
+        "\"source_period_ns\":%"PRIu64",\"lanes\":[",
+        s->event_programmed_clock_model ? "true" : "false",
+        programmed_clock_configured_mask(s), programmed_clock_armed_mask(s),
+        s->event_control_1508[3], s->event_output_group_running,
+        s->event_pending_1508, s->event_mask_1508,
+        s->event_timing_active ? "true" : "false", s->event_timing_period_ns);
+    for (unsigned ch = 0; ch < 15; ch++) {
+        g_string_append_printf(out, "%s{\"channel\":%u,\"ticks\":%"PRIu64
+            ",\"events\":%"PRIu64",\"coalesced\":%"PRIu64",\"latched\":[",
+            ch ? "," : "", ch, s->event_programmed_clock_ticks[ch],
+            s->event_programmed_clock_events[ch], s->event_programmed_clock_coalesced[ch]);
+        for (unsigned word = 0; word < 8; word++) {
+            g_string_append_printf(out, "%s%u", word ? "," : "", s->event_active_1508[ch][word]);
+        }
+        g_string_append(out, "]}");
+    }
+    g_string_append(out, "],\"pixel_bytes\":0,\"physical_timing_verified\":false,"
+        "\"scope\":\"functional committed waveform class at explicit source period; "
+        "channel/group enable, independent pending/W1C; waveform phases unverified\"}");
+    return g_string_free(out, false);
+}
diff --git a/hw/arm/nikon-expeed-video-preview.h b/hw/arm/nikon-expeed-video-preview.h
new file mode 100644
index 0000000..4b6d2d3
--- /dev/null
+++ b/hw/arm/nikon-expeed-video-preview.h
@@ -0,0 +1,159 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Finite A1 byte8/packed10 NV12 RAM -> B3/B4/B5 preview outputs.
+ * Functional nearest sampling/10-to-8 conversion, NOT Nikon ISP algorithms.
+ * Native578 submits this independent RAM job during movie stop. No header,
+ * codec, OS or camera-file completion is supplied by this device. */
+#define WL_PREVIEW_BITS_A ((1u<<1)|(1u<<2)|(1u<<3)|(1u<<4)| \
+    (1u<<8)|(1u<<9)|(1u<<10)|(1u<<11)|(1u<<14)|(1u<<15)| \
+    (1u<<16)|(1u<<19)|(1u<<20))
+#define WL_PREVIEW_BITS_B ((1u<<3)|(1u<<4)|(1u<<8)|(1u<<9)| \
+    (1u<<10)|(1u<<11)|(1u<<14)|(1u<<15)|(1u<<16))
+#define WL_PREVIEW_BITS_F 0x1fffU
+
+static void video_preview_written(NikonZ9State *s, unsigned i, unsigned off)
+{
+    int slot = i == 1 ? 0 : i >= 6 && i <= 8 ? i - 5 :
+        i >= 18 && i <= 20 ? i - 14 : -1;
+    if (s->video_preview_model && slot >= 0 && off < 0x80) {
+        s->video_preview_written[slot] |= 1u << (off / 4);
+    }
+}
+
+static uint8_t video_preview_sample(const uint8_t *p, unsigned pitch,
+                                    unsigned x, unsigned y, unsigned bits)
+{
+    if (bits == 8) { return p[(size_t)y*pitch+(x^3u)]; }
+    uint32_t word = ldl_be_p(p + (size_t)y * pitch + (x / 3) * 4);
+    unsigned sample = (word >> (22 - (x % 3) * 10)) & 1023;
+    return (sample * 255 + 511) / 1023;
+}
+
+static bool video_preview_transfer(NikonZ9State *s)
+{
+    const uint32_t *a = s->engine1542_config[1];
+    unsigned w = a[0x4c/4], h = a[0x50/4], pitch = a[0x38/4];
+    uint64_t p[8], n[8], total = 0;
+    uint8_t *input = NULL, *output[3] = {NULL};
+    bool ok = false;
+    unsigned bits = a[3] == 0x31000000 ? 8 : 10;
+    unsigned minrow = bits == 8 ? ((w+3)&~3u) : (w+2)/3*4;
+    if ((s->video_preview_written[0] & WL_PREVIEW_BITS_A) != WL_PREVIEW_BITS_A ||
+        (a[1] != 0x3802 && a[1] != 0x3800) || a[2] != 0x78000000 ||
+        (a[3] != 0x31000200 && a[3] != 0x31000000) || a[4] != 1 || a[0x40/4] != 0x0f000022 ||
+        !w || (w & 1) || w > 8192 || !h || (h & 1) || h > 8192 ||
+        pitch < minrow || pitch > 32768 || (pitch & 3) ||
+        a[0x3c/4] != pitch || s->engine1542_pending[1] ||
+        s->engine1543_active[0] || s->engine1543_active[1] ||
+        s->capture_nv16_requested) { return false; }
+    p[0] = capture_nv16_address(a, 0x20);
+    p[1] = capture_nv16_address(a, 0x28);
+    n[0] = (uint64_t)pitch * h; n[1] = n[0] / 2;
+    for (unsigned j = 0; j < 3; j++) {
+        const uint32_t *b = s->engine1542_config[6+j];
+        const uint32_t *f = s->engine1542_config[18+j];
+        unsigned ow = f[0x2c/4], oh = f[0x30/4], op = b[0x38/4];
+        if ((s->video_preview_written[1+j] & WL_PREVIEW_BITS_B) != WL_PREVIEW_BITS_B ||
+            (s->video_preview_written[4+j] & WL_PREVIEW_BITS_F) != WL_PREVIEW_BITS_F ||
+            b[0xc/4] != 0x41000010 || b[0x10/4] != 1 || b[0x40/4] != 0x22 ||
+            b[0x3c/4] != op || (f[0] != 0 && f[0] != 2 && f[0] != 4) ||
+            (f[1] != 1 && f[1] != 4) || f[0x18/4] != w || f[0x1c/4] != h ||
+            f[0x24/4] || f[0x28/4] || !ow || (ow & 1) || ow > 8192 ||
+            !oh || (oh & 1) || oh > 8192 || op < ow || op > 32768 ||
+            !f[0x10/4] || !f[0x14/4] || f[0x20/4] > 7 ||
+            capture_nv16_coordinate(f, ow-1, false) >= w ||
+            capture_nv16_coordinate(f, oh-1, true) >= h) { return false; }
+        p[2+j*2] = capture_nv16_address(b, 0x20);
+        p[3+j*2] = capture_nv16_address(b, 0x28);
+        n[2+j*2] = (uint64_t)op * oh;
+        n[3+j*2] = n[2+j*2] / (f[0] == 0 ? 2 : 1);
+        total += n[2+j*2] + n[3+j*2];
+    }
+    if (total > 192 * MiB) { return false; }
+    for (unsigned j = 0; j < 8; j++) {
+        if (!capture_nv16_span(s, p[j], n[j])) { return false; }
+        for (unsigned k = 0; k < j; k++) {
+            if (p[j] < p[k]+n[k] && p[k] < p[j]+n[j]) { return false; }
+        }
+    }
+    input = g_malloc(n[0]+n[1]);
+    if (address_space_read(&address_space_memory, p[0], MEMTXATTRS_UNSPECIFIED,
+            input, n[0]) != MEMTX_OK ||
+        address_space_read(&address_space_memory, p[1], MEMTXATTRS_UNSPECIFIED,
+            input+n[0], n[1]) != MEMTX_OK) { goto done; }
+    for (unsigned j = 0; j < 3; j++) {
+        const uint32_t *b = s->engine1542_config[6+j];
+        const uint32_t *f = s->engine1542_config[18+j];
+        unsigned ow = f[0x2c/4], oh = f[0x30/4], op = b[0x38/4];
+        unsigned sub = f[0] == 0 ? 2 : 1;
+        output[j] = g_malloc(n[2+j*2]+n[3+j*2]);
+        memset(output[j], 0, n[2+j*2]);
+        memset(output[j]+n[2+j*2], 128, n[3+j*2]);
+        for (unsigned r = 0; r < oh; r++) {
+            unsigned sy = capture_nv16_coordinate(f, r, true);
+            for (unsigned x = 0; x < ow; x++) {
+                unsigned sx = capture_nv16_coordinate(f, x, false);
+                output[j][(size_t)r*op+x] = video_preview_sample(input,pitch,sx,sy,bits);
+            }
+        }
+        for (unsigned r = 0; r < oh/sub; r++) {
+            unsigned sy = capture_nv16_coordinate(f, r*sub, true)/2;
+            for (unsigned x = 0; x < ow; x += 2) {
+                unsigned sx = capture_nv16_coordinate(f, x, false) & ~1u;
+                for (unsigned c = 0; c < 2; c++) {
+                    output[j][n[2+j*2]+(size_t)r*op+x+c] =
+                        video_preview_sample(input+n[0],pitch,sx+c,sy,bits);
+                }
+            }
+        }
+    }
+    /* Validate and construct every output before any destination write.
+     * All addresses are RAM spans, never MMIO or guest control structures. */
+    for (unsigned j = 0; j < 3; j++) {
+        if (address_space_write(&address_space_memory,p[2+j*2],MEMTXATTRS_UNSPECIFIED,
+                output[j],n[2+j*2]) != MEMTX_OK ||
+            address_space_write(&address_space_memory,p[3+j*2],MEMTXATTRS_UNSPECIFIED,
+                output[j]+n[2+j*2],n[3+j*2]) != MEMTX_OK) { goto done; }
+    }
+    for (unsigned j = 0; j < 3; j++) {
+        const uint32_t *b = s->engine1542_config[6+j], *f = s->engine1542_config[18+j];
+        s->video_preview_y[j] = p[2+j*2]; s->video_preview_uv[j] = p[3+j*2];
+        s->video_preview_w[j] = f[0x2c/4]; s->video_preview_h[j] = f[0x30/4];
+        s->video_preview_pitch[j] = b[0x38/4]; s->video_preview_sub[j] = f[0] == 0 ? 2 : 1;
+    }
+    s->video_preview_jobs++;
+    s->video_preview_input_bytes += n[0]+n[1];
+    s->video_preview_output_bytes += total;
+    memset(s->video_preview_written,0,sizeof(s->video_preview_written));
+    s->engine1542_config[1][1] = 0x3801;
+    s->engine1542_pending[1] |= 0x11;
+    raw_pipeline_irq_update(s);
+    ok = true;
+done:
+    g_free(input);
+    for (unsigned j = 0; j < 3; j++) { g_free(output[j]); }
+    return ok;
+}
+
+static bool get_video_preview_model(Object *obj, Error **errp)
+{ return NIKON_Z9_LAB(obj)->video_preview_model; }
+static void set_video_preview_model(Object *obj, bool value, Error **errp)
+{
+    NikonZ9State *s = NIKON_Z9_LAB(obj);
+    if (s->image_ram.ram || s->image_ram.rom_device) {
+        error_setg(errp,"video preview RAM model immutable after realization");return;
+    }
+    s->video_preview_model = value;
+}
+static char *get_video_preview_state(Object *obj, Error **errp)
+{
+    NikonZ9State *s = NIKON_Z9_LAB(obj);
+    return g_strdup_printf("{\"enabled\":%s,\"jobs\":%"PRIu64
+        ",\"input_bytes\":%"PRIu64",\"output_bytes\":%"PRIu64
+        ",\"pending\":%u,\"written\":[%u,%u,%u,%u,%u,%u,%u],"
+        "\"original_algorithm\":false,\"file_accepted\":false}",
+        s->video_preview_model?"true":"false",s->video_preview_jobs,
+        s->video_preview_input_bytes,s->video_preview_output_bytes,s->engine1542_pending[1],
+        s->video_preview_written[0],s->video_preview_written[1],s->video_preview_written[2],
+        s->video_preview_written[3],s->video_preview_written[4],s->video_preview_written[5],
+        s->video_preview_written[6]);
+}
