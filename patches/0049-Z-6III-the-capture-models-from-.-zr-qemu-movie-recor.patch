+            s->raw_admission_history[n].time_ns,s->raw_admission_history[n].blocked,
+            s->raw_admission_history[n].route,s->raw_admission_history[n].frames,
+            s->raw_admission_history[n].epoch,s->raw_admission_history[n].row);
+    }
+    g_string_append(out,"]}}");
+}
