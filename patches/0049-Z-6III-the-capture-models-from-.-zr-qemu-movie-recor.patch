+            ",\"address\":%"PRIu64",\"capacity\":%u,\"width\":%u,\"height\":%u}",row?",":"",row,
+            (*video_raw_packet_at(s,row)).owned?"true":"false",(*video_raw_packet_at(s,row)).epoch,
