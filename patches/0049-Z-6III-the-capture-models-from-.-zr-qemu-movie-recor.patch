+void HELPER(wl_sev)(CPUARMState *env, uint32_t local)
+{
+#ifndef CONFIG_USER_ONLY
+    CPUState *source = env_cpu(env), *target;
+    bool take_lock = !bql_locked();
+    if (take_lock) {
+        bql_lock();
+    }
+    CPU_FOREACH(target) {
+        ARMCPU *cpu = ARM_CPU(target);
+        if (!cpu->wl_event_peer || (local && source != target)) {
+            continue;
+        }
+        if (cpu->env.wl_event_waiting) {
+            /* This event completes the outstanding WFE. EXITTB wakes the
+             * halted CPU without inventing an architectural interrupt. */
+            cpu->env.wl_event_waiting = false;
+            cpu->env.wl_event_pending = false;
+            cpu->env.wl_event_wakes++;
+            cpu_interrupt(target, CPU_INTERRUPT_EXITTB);
+        } else {
+            cpu->env.wl_event_pending = true;
+        }
+    }
+    if (take_lock) {
+        bql_unlock();
+    }
+#endif
+}
