-        return;
-    }
-    /* Z 6III (z63-lv-frame-done, z9lab_attach.c.in): the same gate -- a
-     * frame only while the sensor's capture timing runs. */
-    if (s->raw_pipeline_output_done && !s->event_timing_active) {
-        return;
-    }
-""")
 pedit("""    s->raw_pipeline_frames++;
     s->raw_pipeline_bytes += total;
