new file mode 100755
index 0000000..45e927e
--- /dev/null
+++ b/z63-tools/mcu-ex/lenssteps.sh
@@ -0,0 +1,22 @@
+#!/bin/sh
+# lenssteps.sh <name> "<lens-replies>" [secs]: boot with the synthetic lens answering as given,
+# record which connect-sequence steps the EXPEED runs (breakpoint on the engine's start call
+# 0x4107d810, x1 = the step's done function) and print them as step numbers, then the last
+# lens frames. Runs on exapfs in claude/lens (run.sh, ../rspbrk.py, steps table steps.txt).
+cd /Volumes/ExAPFS/z63-run/claude/lens
+MX="lens=on,lens-replies=$2" HOLD=1 ./run.sh $1 0
+sleep 2
+python3 ../rspbrk.py 41270 ${3:-40} 0x4107d810 > $1.brk 2>&1
+kill $(cat $1.pid)
+python3 - $1 <<'PY'
+import re, sys
+done = {}
+for l in open('steps.txt'):
+    m = re.match(r'\s*(\d+) \w+: start (\w+) done (\w+)', l)
+    if m:
+        done.setdefault(m.group(3), []).append(m.group(1))
+seq = [('/'.join(done.get(m.group(1), ['?' + m.group(1)])))
+       for m in re.finditer(r'x1=([0-9a-f]+)', open(sys.argv[1] + '.brk').read())]
+print('steps:', ' '.join(seq))
+PY
+grep -E "Z63_LENS: #" $1.log | sed -E "s/qemu-system-aarch64: //" | cut -c1-110 | awk '!seen[substr($0, index($0,"cmd"), 11)]++' | tail -12
