diff --git a/z63-tools/mcu-ex/pins.py b/z63-tools/mcu-ex/pins.py
new file mode 100755
index 0000000..fbd3fdd
--- /dev/null
+++ b/z63-tools/mcu-ex/pins.py
@@ -0,0 +1,40 @@
+#!/usr/bin/env python3
+"""pins.py <ex2010_0200a0.bi> <MCU RAM dump from 0x20000000> -- the MCU's logical pin ids and
+timer ids, resolved to GPIO port/pin or peripheral object.
+
+pin_res (0x08046ED4) maps an id through the ROM table that 0x2000F2A0 points at to a resource
+index; res_get (0x08021198) maps that through 0x2000EDAC[] to a 16-byte object
+{index, lock, base, mask}. Both tables are filled at run time, hence the RAM dump (m4mem.py)."""
+import struct, sys
+
+rom = open(sys.argv[1], 'rb').read()
+ram = open(sys.argv[2], 'rb').read()
+
+def r32(a):
+    if 0x08000000 <= a < 0x08000000 + len(rom):
+        return struct.unpack_from('<I', rom, a - 0x08000000)[0]
+    return struct.unpack_from('<I', ram, a - 0x20000000)[0]
+
+def r16(a):
+    if 0x08000000 <= a < 0x08000000 + len(rom):
+        return struct.unpack_from('<H', rom, a - 0x08000000)[0]
+    return struct.unpack_from('<H', ram, a - 0x20000000)[0]
+
+def describe(i):
+    o = r32(0x2000EDAC + 4 * i)
+    if not o:
+        return '-'
+    w = [r32(o + 4 * k) for k in range(4)]
+    if 0x40020000 <= w[2] < 0x40022c00 and w[3] and not w[3] & (w[3] - 1):
+        return 'P%s%d' % ('ABCDEFGHIJK'[(w[2] - 0x40020000) // 0x400], w[3].bit_length() - 1)
+    return 'obj %08x {%s}' % (o, ' '.join('%08x' % x for x in w))
+
+pin_tab, tim_tab = r32(0x2000F2A0), r32(0x2000F2AC)
+print('# pin id -> resource -> GPIO (table 0x%x)' % pin_tab)
+for i in range((tim_tab - pin_tab) // 2):
+    ri = r16(pin_tab + 2 * i)
+    print('pin\t%d\t%d\t%s' % (i, ri, describe(ri) if ri != 0xffff else '-'))
+print('# timer id -> resource (table 0x%x)' % tim_tab)
+for i in range(24):
+    ri = r16(tim_tab + 2 * i)
+    print('timer\t%d\t%d\t%s' % (i, ri, describe(ri) if ri < 317 else '-'))
diff --git a/z63-tools/mcu-ex/run.sh b/z63-tools/mcu-ex/run.sh
new file mode 100755
index 0000000..d2fd256
--- /dev/null
+++ b/z63-tools/mcu-ex/run.sh
@@ -0,0 +1,15 @@
+#!/bin/sh
+# lens/run.sh <name> <secs>: a boot named z63-lens (gdb 41270, qmp lens/qmp.sock), for the
+# MCU lens work; separate from z63-agent / z63-probe / z63-ui. Output in claude/lens/.
+# env: MX= extra -machine opts, EXTRA= extra QEMU opts, HOLD=1 leaves it running (kill by pid file).
+cd /Volumes/ExAPFS/z63-run
+D=/Volumes/ExAPFS/z63-run/claude/lens
+cp /Volumes/ExAPFS/z63-run/nand-e.img $D/nand.img
+/Volumes/ExAPFS/qemu-z63/build/qemu-system-aarch64 -name z63-lens \
+  -machine nikon-z63,loader=loader_0x40000000-0x40160000.bin,snor-user=${SNOR:-/Volumes/ExAPFS/z63-run/claude/snor_user_sti.bin},nand=$D/nand.img,mcu-image=/Volumes/ExAPFS/Z6_3_0200_modules/ex2010_0200a0.bi,z9-capture=on,z9-capture-raw=bars.raw,gfx-skip-unmodelled=on,sio-sink=9:8:7,imu-mg=-1000:0:0,scanout-dump=$D/$1.ppm${MX:+,$MX} \
+  -cpu cortex-a53 -smp 4,maxcpus=5 -bios /Volumes/ExAPFS/Z6_3_0200_modules/eg2010_0200i1.bi \
+  -serial file:$D/$1.serial -monitor none -display none -action shutdown=pause -gdb tcp:127.0.0.1:41270 ${QSTOP:+-S} \
+  ${EXTRA:-} -qmp unix:$D/qmp.sock,server=on,wait=off > $D/$1.log 2>&1 &
+pid=$!
+echo $pid > $D/$1.pid
+if [ -z "$HOLD" ]; then sleep $2; kill $pid; fi
diff --git a/z63-tools/mcu-ex/steps.py b/z63-tools/mcu-ex/steps.py
new file mode 100644
index 0000000..88d25a0
--- /dev/null
+++ b/z63-tools/mcu-ex/steps.py
@@ -0,0 +1,40 @@
+# steps.py -- lens sequence steps: what each start fn sends, where each done fn goes
+import re, os, sys, struct
+sys.path.insert(0, os.path.dirname(__file__))
+import egmem
+DC = '/Users/admin/LiBr/claude-work/dc'
+D = 0x9BD60F000
+def src(a):
+    p = os.path.join(DC, '%x.c' % a)
+    if not os.path.exists(p): return ''
+    return re.sub(r'^/\* [0-9A-F ]{6,10} \*/ ?', '', open(p).read(), flags=re.M)
+cmdtab = {}
+for i in range(0x5c):
+    b = egmem.rd(0xA02B4B350 - D + 48 * i, 48)
+    cmdtab[i] = struct.unpack_from('<H', b, 0)[0]
+def follow(a, depth=0):
+    """calls made by a start fn, resolving one level of thunks/wrappers"""
+    s = src(a); out = []
+    for m in re.finditer(r'sub_([0-9A-F]{8})\(([^;]*)\)', s):
+        f = int(m.group(1), 16); args = m.group(2)
+        out.append((f, args))
+    return s, out
+MCU = {0x4109521C: 'MCU kind1(mode)', 0x41095258: 'MCU kind2(PF12)', 0x41095300: 'MCU kind4(PG4 latch)',
+       0x41095348: 'MCU kind5(query)', 0x41087B08: 'MCU kind3', 0x41083D70: 'LENS cmd', 0x41096398: 'LENS cmd(raw)'}
+for i in range(0x53):
+    a = 0x45535de0 + 32 * i
+    st, dn, ck, pa = [egmem.q(a + 8 * k) for k in range(4)]
+    s, calls = follow(st)
+    what = []
+    for f, args in calls:
+        if f in MCU:
+            what.append('%s %s' % (MCU[f], args.replace('a1: ', '').replace('a2: ', '').replace('a3: ', '').replace('a4: ', '')))
+        else:
+            s2, c2 = follow(f)
+            for g, a2 in c2:
+                if g in MCU: what.append('%s via %x(%s) -> %s %s' % ('', f, args[:30], MCU[g], a2[:40]))
+    d = src(dn)
+    nxt = sorted(set(re.findall(r'MEMORY\[0xA02995F84\] = (\w+);', d)))
+    calls_dn = sorted(set(re.findall(r'sub_4107DAA0\(result: 0, a2: (\w+)', d)))
+    pinfo = ('cmd %02x code %04x' % (pa, cmdtab.get(pa, 0))) if ck == 0x41096a3c else ('chk %x p %x' % (ck, pa))
+    print('%2d %-26s start %x | %s | done %x -> %s %s' % (i, pinfo, st, '; '.join(what)[:150], dn, ','.join(nxt), ('retry-fail->' + ','.join(calls_dn)) if calls_dn else ''))
