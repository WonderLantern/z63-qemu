+#!/bin/sh
+# lens/hotplug.sh <name>: boot with no lens (PG0 high), then put a lens on / take it off / on
+# again through qom-set mcu-pins, marking the log line at each step in <name>.steps.
+D=/Volumes/ExAPFS/z63-run/claude/lens
+cd $D
+MX="mcu-pins=D13=1,,G0=1${MX:+,$MX}" HOLD=1 ./run.sh $1 0
+qmp() { python3 - "$1" <<'PY'
+import json, socket, sys
+s = socket.socket(socket.AF_UNIX); s.connect('/Volumes/ExAPFS/z63-run/claude/lens/qmp.sock')
+f = s.makefile('rw')
+f.readline(); f.write('{"execute":"qmp_capabilities"}\n'); f.flush(); f.readline()
+f.write(json.dumps({"execute": "qom-set", "arguments": {"path": "/machine", "property": "mcu-pins", "value": sys.argv[1]}}) + '\n'); f.flush()
+print(f.readline().strip())
+PY
+}
+step() { echo "$(wc -l < $1.log) $2" >> $1.steps; }
+: > $1.steps
+sleep ${T0:-40}; step $1 attach; qmp G0=0
+sleep ${T1:-20}; step $1 detach; qmp G0=1
+sleep ${T2:-15}; step $1 attach2; qmp G0=0
+sleep ${T3:-20}; step $1 end
+kill $(cat $1.pid)
diff --git a/z63-tools/mcu-ex/lensfields.py b/z63-tools/mcu-ex/lensfields.py
new file mode 100644
index 0000000..4a70b42
--- /dev/null
+++ b/z63-tools/mcu-ex/lensfields.py
@@ -0,0 +1,80 @@
+#!/usr/bin/env python3
+"""lensfields.py <field id>... | --map -- the EXPEED's lens fields and where the lens's replies
+put them.
+
+A field id indexes the descriptor table at RAM 0xA02B4D210 (40 bytes: mode, buffer/offset for
+lens kind 1 = Z lens, buffer/offset for other kinds, getter, argument; field getter 0x4109710C).
+The command parsers (command table RAM 0xA02B4B350, +32) copy reply bytes into those buffers:
+`result = sub_41095C34(buffer)` then `result[off] = a1[reply byte]`. --map prints, for every
+(buffer, offset) a parser writes, which command and reply byte feeds it. Reads the eg image
+(egmem.py) and the decompile cache (DC, default ~/LiBr/claude-work/dc)."""
+import os, re, struct, sys
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import egmem
+
+K = 0x9BD60F000                       # RAM - image VA for this .data range
+DC = os.environ.get('DC', os.path.expanduser('~/LiBr/claude-work/dc'))
+GET = {0x41097f2c: 'bit', 0x41097de4: 'int'}
+INT = {39: 'u8', 40: 'le16', 41: 'le24', 42: 'le32', 43: 'be16', 44: 'be24', 45: 'be32', 46: 's16'}
+
+def ram(a, n):
+    return egmem.rd(a - K, n)
+
+def field(fid):
+    mode, b1, o1, b2, o2, _, getter, arg = struct.unpack('<6IQI', ram(0xA02B4D210 + 40 * fid, 36))
+    g = GET.get(getter, '%x' % getter)
+    how = ('bit %d' % arg) if g == 'bit' else INT.get(arg, '%s(%d)' % (g, arg))
+    return mode, (b1, o1), (b2, o2), how
+
+def commands():
+    """[(index, code, txlen, rxlen, builder, parser)] from the command table, + 0x70 group."""
+    out = []
+    for base, n in ((0xA02B4B350, 92), (0xA02B4C430, 64)):
+        for i in range(n):
+            r = ram(base + 48 * i, 48)
+            code, tx, rx = struct.unpack_from('<3H', r, 0)
+            b, p = struct.unpack_from('<2Q', r, 24)
+            out.append((i, code, tx, rx, b, p))
+    return out
+
+def parser_writes(addr):
+    """[(kind branch, buffer, offset, reply byte)] read from the decompiled parser."""
+    path = os.path.join(DC, '%x.c' % addr)
+    if not os.path.exists(path):
+        return []
+    res, bufs, branch = [], {}, 'any'
+    for line in open(path).read().splitlines():
+        line = re.sub(r'^/\*[^*]*\*/', '', line).strip()
+        if 'sub_4109634C() == 2' in line:
+            branch = 'kind2'
+        elif line == 'else' or line.startswith('else '):
+            branch = 'other' if branch == 'kind2' else branch
+        m = re.search(r'(\w+) = (?:\([^)]*\))?sub_41095C34\(a1: (\d+)\)', line)
+        if m:
+            bufs[m.group(1)] = int(m.group(2))
+        m = re.search(r'(\w+)\[(\d+)\] = a1\[(\d+)\]', line)
+        if m and m.group(1) in bufs:
+            res.append((branch, bufs[m.group(1)], int(m.group(2)), int(m.group(3))))
+    return res
+
+def build_map():
+    m = {}
+    for i, code, tx, rx, b, p in commands():
+        for branch, buf, off, j in parser_writes(p):
+            m.setdefault((buf, off), []).append((code, j, branch))
+    return m
+
+if __name__ == '__main__':
+    if sys.argv[1:] == ['--map']:
+        for (buf, off), srcs in sorted(build_map().items()):
+            print('buf %2d +0x%03x <- %s' % (buf, off, ', '.join(
+                'cmd 0x%04x byte %d (%s)' % s for s in srcs)))
+        sys.exit()
+    m = build_map()
+    for a in sys.argv[1:]:
+        fid = int(a, 0)
+        mode, z, o, how = field(fid)
+        src = lambda bo: ', '.join('0x%04x[%d]%s' % (c, j, '' if br == 'any' else ' ' + br)
+                                   for c, j, br in m.get(bo, [])) or '-'
+        print('field %d: mode %d, Z lens buf %d +0x%x (%s), other buf %d +0x%x (%s), %s'
+              % (fid, mode, z[0], z[1], src(z), o[0], o[1], src(o), how))
