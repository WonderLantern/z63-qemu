+# egmem.py -- read z63_eg.elf by virtual address (ELF64 program headers)
+import struct, sys
+F = '/Users/admin/LiBr/nikon/idb/z63_eg.elf'
+_d = open(F, 'rb').read()
+_ph = []
+phoff, = struct.unpack_from('<Q', _d, 0x20); phentsz, phnum = struct.unpack_from('<HH', _d, 0x36)
+for i in range(phnum):
+    t, fl, off, va, pa, fsz, msz, al = struct.unpack_from('<IIQQQQQQ', _d, phoff + i * phentsz)
+    if t == 1: _ph.append((va, off, fsz, msz))
+def rd(a, n):
+    for va, off, fsz, msz in _ph:
+        if va <= a < va + fsz:
+            return _d[off + a - va: off + a - va + n]
+    return None
+def q(a): return struct.unpack('<Q', rd(a, 8))[0]
+def d(a): return struct.unpack('<I', rd(a, 4))[0]
+if __name__ == '__main__':
+    for va, off, fsz, msz in _ph: print('%x off %x fsz %x msz %x' % (va, off, fsz, msz))
