new file mode 100755
index 0000000..9dc7939
--- /dev/null
+++ b/z63-tools/mcu-ex/m4mem.py
@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+"""m4mem.py <port> <out-prefix> <addr:len>... : attach to QEMU's gdb stub (the VM pauses),
+select the Cortex-M4 (gdb process 2), dump each range to <out-prefix>-<addr>.bin, print the
+M4's registers, detach (the VM runs on)."""
+import socket, sys, re
+
+class Rsp:
+    def __init__(self, port):
+        self.s = socket.create_connection(("127.0.0.1", port), timeout=10)
+        self.buf = b""
+    def send(self, cmd):
+        self.s.sendall(b"$" + cmd + b"#%02x" % (sum(cmd) & 0xff))
+        while True:
+            c = self.s.recv(1)
+            if c == b"+": return
+            if not c: raise EOFError
+    def recv(self):
+        while True:
+            i = self.buf.find(b"$"); j = self.buf.find(b"#", i + 1)
+            if i >= 0 and j >= 0 and len(self.buf) >= j + 3:
+                pkt = self.buf[i + 1:j]; self.buf = self.buf[j + 3:]
+                self.s.sendall(b"+"); return pkt
+            d = self.s.recv(65536)
+            if not d: raise EOFError
+            self.buf += d
+    def cmd(self, c):
+        self.send(c); return self.recv()
+
+r = Rsp(int(sys.argv[1]))
+r.cmd(b"qSupported:multiprocess+")
+r.cmd(b"?")
+print("vAttach;2", r.cmd(b"vAttach;2"))
+threads = []
+t = r.cmd(b"qfThreadInfo")
+while t.startswith(b"m"):
+    threads += t[1:].split(b",")
+    t = r.cmd(b"qsThreadInfo")
+m4 = [x for x in threads if x.startswith(b"p2.") or x.startswith(b"p02.")]
+print("threads", threads, "m4", m4)
+assert m4, "no M4 thread"
+print("Hg", r.cmd(b"Hg" + m4[0]))
+g = r.cmd(b"g")
+regs = [int.from_bytes(bytes.fromhex(g[i:i+8].decode()), 'little') for i in range(0, 16*8, 8)]
+print("m4 regs", ' '.join('r%d=%08x' % (i, v) for i, v in enumerate(regs)))
+for spec in sys.argv[3:]:
+    a, n = [int(x, 0) for x in spec.split(':')]
+    data = b""
+    while len(data) < n:
+        k = min(0x800, n - len(data))
+        p = r.cmd(b"m%x,%x" % (a + len(data), k))
+        if p.startswith(b"E"):
+            print("read error at %x: %s" % (a + len(data), p)); break
+        data += bytes.fromhex(p.decode())
+    open("%s-%08x.bin" % (sys.argv[2], a), "wb").write(data)
+    print("dumped %x +%x -> %d bytes" % (a, n, len(data)))
+r.send(b"D")
+print("detached")
