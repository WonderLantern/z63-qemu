+++ b/z63-tools/mcu-ex/findq.py
@@ -0,0 +1,14 @@
+# findq.py <hexval>... -- find 8-byte little-endian occurrences in the eg image (8-aligned)
+import sys, struct, egmem
+data = egmem._d
+va0, off0, fsz, msz = egmem._ph[0]
+vals = [int(x, 16) for x in sys.argv[1:]]
+pats = {struct.pack('<Q', v): v for v in vals}
+for p, v in pats.items():
+    i = data.find(p, off0)
+    while i >= 0:
+        if (i - off0) % 4 == 0:
+            va = va0 + i - off0
+            ram = va + 0x5B30F000 if 0x45000000 <= va < 0x46000000 else None
+            print('%x at %x%s' % (v, va, ' (RAM %x?)' % ram if ram else ''))
+        i = data.find(p, i + 1)
