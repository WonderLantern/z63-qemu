+#!/usr/bin/env python3
+"""apply_names.py [names.json] -- write the names and comments in names.json into the MCU
+(ex2010) IDA database behind an idasql HTTP server (PORT, default 8089).
+
+names.json is the source of truth: {"funcs": {addr: [name, comment]}, "data": {addr: [name,
+comment]}}. Functions are renamed through the funcs table, data through names/comments."""
+import json, os, sys, urllib.request
+
+PORT = int(os.environ.get('PORT', '8089'))
+
+def sql(q):
+    req = urllib.request.Request('http://127.0.0.1:%d/query' % PORT, data=q.encode(), method='POST')
+    with urllib.request.urlopen(req, timeout=120) as r:
+        d = json.load(r)
+    for res in d['results']:
+        if not res['success']:
+            raise RuntimeError('%s: %s' % (q, res['error']))
+    return d['results'][-1]['rows']
+
+def esc(s):
+    return s.replace("'", "''")
+
+path = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.path.dirname(__file__), 'names.json')
+names = json.load(open(path))
+n = 0
+for a, (name, comment) in names.get('funcs', {}).items():
+    a = int(a, 16)
+    if not sql('select 1 from funcs where addr=%d' % a):
+        print('no function at 0x%x (%s)' % (a, name)); continue
+    sql("update funcs set name='%s' where addr=%d" % (esc(name), a))
+    if comment:
+        sql("update funcs set comment='%s' where addr=%d" % (esc(comment), a))
+    n += 1
+for a, (name, comment) in names.get('data', {}).items():
+    a = int(a, 16)
+    try:
+        sql("delete from names where addr=%d" % a)
+        sql("insert into names(addr,name) values(%d,'%s')" % (a, esc(name)))
+    except RuntimeError as e:
+        # IDA refuses a name inside an already defined item (an array's middle)
+        print('name not set at 0x%x (%s): %s' % (a, name, str(e).split(': ')[-1])); continue
+    if comment:
+        sql("delete from comments where addr=%d" % a)
+        sql("insert into comments(addr,comment) values(%d,'%s')" % (a, esc(comment)))
+    n += 1
+print('applied', n)
