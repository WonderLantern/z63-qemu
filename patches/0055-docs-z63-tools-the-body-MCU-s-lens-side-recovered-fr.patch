+#!/usr/bin/env python3
+"""egread.py <qmp sock>: read the EXPEED's lens-link config and pin handles (A53 space, DRAM only)."""
+import json, socket, sys, re
+s = socket.socket(socket.AF_UNIX); s.connect(sys.argv[1]); f = s.makefile("rw"); f.readline()
+def cmd(ex, **a):
+    f.write(json.dumps({"execute": ex, "arguments": a}) + "\n"); f.flush()
+    while True:
+        d = json.loads(f.readline())
+        if "return" in d or "error" in d: return d
+def hmp(c): return cmd("human-monitor-command", **{"command-line": c})["return"]
+def words(addr, n, w='g'):
+    out = hmp("xp /%d%sx 0x%x" % (n, w, addr)); return [int(x, 16) for x in re.findall(r'0x([0-9a-f]+)', out.split(':',1)[1] if ':' in out else '') ] if n == 1 else [int(x,16) for l in out.splitlines() for x in re.findall(r'0x([0-9a-f]+)', l.split(':',1)[1])]
+cmd("qmp_capabilities")
+print("serial config 0xA02AFF508:"); print(hmp("xp /32bx 0xa02aff508"))
+print("handle table 0xA02C29000[40..61]:")
+hs = words(0xa02c29000 + 8 * 40, 22)
+for i, h in enumerate(hs):
+    pid = 40 + i
+    line = "  pin %d -> %x" % (pid, h)
+    if 0xa00000000 <= h < 0xa80000000:
+        line += "  " + hmp("xp /12wx 0x%x" % h).replace("\r", " ").replace("\n", " ")
+    print(line)
