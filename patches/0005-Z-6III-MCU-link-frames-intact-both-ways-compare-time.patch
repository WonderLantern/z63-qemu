diff --git a/z63-tools/mcu_probe.py b/z63-tools/mcu_probe.py
new file mode 100755
index 0000000..6a1e21c
--- /dev/null
+++ b/z63-tools/mcu_probe.py
@@ -0,0 +1,129 @@
+#!/usr/bin/env python3
+"""Stop the body MCU (the Cortex-M4 of mcu-image=) at breakpoints in a
+running machine and report each hit.
+
+    mcu_probe.py <seconds> <addr>[,<addr>...] [maxhits]
+
+The machine must have been started with -gdb tcp:127.0.0.1:41234 (never the
+shared 1234). The M4 is its own CPU cluster (nikon-z63-stm32.h), so QEMU's
+gdbstub shows it as process 2 beside the A53s' process 1; this attaches to
+process 2 only. Breakpoints are set on every CPU by QEMU, which is harmless:
+the A53s never execute at the MCU's flash addresses.
+
+Each hit prints pc, r0..r3, lr and sp, and a rough walk of the stack: the
+words in the first 0x200 bytes that look like Thumb return addresses into
+the application (odd, 0x08020000..0x08060000). The machine is paused while
+the script is attached, and resumes when it exits. Environment:
+
+  MEM=a:n[,a:n]  also dump n bytes at each address a, per hit
+  LIGHT=1        one line per hit (pc, r0..r3, lr)
+"""
+
+import os, socket, struct, sys, time
+
+secs, addrs = sys.argv[1:3]
+maxhits = int(sys.argv[3]) if len(sys.argv) > 3 else 4
+addrs = [int(a, 16) for a in addrs.split(",") if a]
+CODE_LO, CODE_HI = 0x08020000, 0x08060000
+
+
+class Rsp:
+    def __init__(self, port=41234):
+        self.s = socket.create_connection(("127.0.0.1", port))
+        self.buf = b""
+
+    def send(self, c):
+        self.s.sendall(b"$" + c + b"#%02x" % (sum(c) & 0xff))
+        while self.s.recv(1) != b"+":
+            pass
+
+    def recv(self, timeout=None):
+        self.s.settimeout(timeout)
+        while True:
+            i = self.buf.find(b"#")
+            if i >= 0 and len(self.buf) >= i + 3:
+                body = self.buf[self.buf.find(b"$") + 1:i]
+                self.buf = self.buf[i + 3:]
+                self.s.sendall(b"+")
+                return body.decode()
+            self.buf += self.s.recv(65536)
+
+    def cmd(self, c):
+        self.send(c.encode())
+        return self.recv()
+
+    def mem(self, a, n):
+        out = b""
+        while n > 0:
+            k = min(n, 0x100)
+            m = self.cmd("m%x,%x" % (a, k))
+            if m.startswith("E"):
+                break
+            out += bytes.fromhex(m)
+            a += k
+            n -= k
+        return out
+
+
+r = Rsp()
+r.cmd("qSupported:multiprocess+;swbreak+;hwbreak+")
+stop = r.cmd("vAttach;2")
+tid = stop.split("thread:")[1].split(";")[0] if "thread:" in stop else "p02.05"
+print("attached:", stop[:40], "thread", tid, flush=True)
+r.cmd("Hg" + tid)
+for a in addrs:
+    print("Z1", hex(a), r.cmd("Z1,%x,2" % a), flush=True)
+
+
+def resume():
+    for a in addrs:
+        r.cmd("z1,%x,2" % a)
+    r.cmd("Hc" + tid)
+    r.cmd("vCont;s:" + tid)
+    for a in addrs:
+        r.cmd("Z1,%x,2" % a)
+    r.send(b"vCont;c")
+
+
+r.send(b"vCont;c")
+deadline = time.time() + float(secs)
+hits = 0
+while time.time() < deadline and hits < maxhits:
+    try:
+        stop = r.recv(timeout=max(1, deadline - time.time()))
+    except socket.timeout:
+        break
+    if "thread:" in stop:
+        t = stop.split("thread:")[1].split(";")[0]
+        if int(t[1:].split(".")[0], 16) != 2:
+            r.send(b"vCont;c")          # not the M4
+            continue
+        tid = t
+    r.cmd("Hg" + tid)
+    g = r.cmd("g")
+    regs = struct.unpack("<16I", bytes.fromhex(g[:128]))
+    pc, lr, sp = regs[15], regs[14], regs[13]
+    hits += 1
+    if os.environ.get("LIGHT"):
+        print("T %08x r0=%x r1=%x r2=%x r3=%x lr=%x" %
+              (pc, regs[0], regs[1], regs[2], regs[3], lr), flush=True)
+    else:
+        print("hit pc=%08x lr=%08x sp=%08x" % (pc, lr, sp))
+        print("  " + " ".join("r%d=%x" % (i, regs[i]) for i in range(13)))
+        raw = r.mem(sp, 0x200)
+        words = struct.unpack("<%dI" % (len(raw) // 4), raw)
+        walk = ["%x@+%x" % (w - 1, 4 * i) for i, w in enumerate(words)
+                if w & 1 and CODE_LO <= w < CODE_HI]
+        print("  stack code words:", " ".join(walk[:24]), flush=True)
+        for spec in filter(None, os.environ.get("MEM", "").split(",")):
+            a, n = spec.split(":")
+            print("  mem@%s:" % a, r.mem(int(a, 16), int(n, 0)).hex(),
+                  flush=True)
+    resume()
+
+r.s.sendall(b"\x03")                    # running: stop it before talking
+r.recv(timeout=10)
+for a in addrs:
+    r.cmd("z1,%x,2" % a)
+r.cmd("D;2")
+r.cmd("D;1")                            # the last detach resumes the machine
