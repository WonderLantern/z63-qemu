     QEMUTimer *cc_timer;
     int64_t cc_seen_ns;
+    qemu_irq cc_irq;            /* sysbus IRQ 1; IRQ 0 when not connected */
+    bool ccr_wraps;             /* "ccr-wraps": see stm32f2xx_timer_oc() */
+    uint8_t ccr_wraps_named;    /* channels that have used it, for the log */
     qemu_irq irq;
 
     int64_t tick_offset;
