 class Rsp:
     def __init__(self):
@@ -65,6 +72,8 @@ class Rsp:
 
 r = Rsp()
 r.cmd("qSupported")
+if ATTACH:
+    r.cmd("?")
 for a in addrs:
     print("Z1", hex(a), r.cmd("Z1,%x,4" % a))
