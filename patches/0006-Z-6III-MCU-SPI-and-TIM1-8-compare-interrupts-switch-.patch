+               body MCU's M4 is process 2 (z63-tools/mcu_probe.py).
 
 Hits on any CPU are reported; the breakpoint is stepped over and re-armed.
 """
@@ -32,11 +37,13 @@ qemu, mopts, eg, secs, addrs = sys.argv[1:6]
 maxhits = int(sys.argv[6]) if len(sys.argv) > 6 else 4
