+static void z63_wires_parse(NikonZ63State *s)
+{
+    g_auto(GStrv) items;
+
+    s->wires_parsed = true;
+    s->n_wires = 0;
+    if (!s->mcu_wires || !*s->mcu_wires) {
+        return;
