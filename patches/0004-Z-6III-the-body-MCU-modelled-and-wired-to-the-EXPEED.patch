+/* Build the MCU and load its image (a raw dump of flash from 0x08000000).
+ * The core starts at reset, from the vector table at 0 -- the flash alias,
+ * BOOT0 low. */
+static void z63_stm32_init(Z63Stm32 *m, Object *owner, const char *image,
+                           Chardev **serial, Error **errp)
+{
+    DeviceState *armv7m;
+    Error *err = NULL;
+
+    memory_region_init(&m->mem, owner, "z63-mcu", 0x100000000ULL);
+    memory_region_init_io(&m->trap, owner, &z63_stm32_trap_ops, m,
+                          "z63-mcu-trap", 0x100000000ULL);
+    memory_region_add_subregion_overlap(&m->mem, 0, &m->trap, -1000);
+
+    /* The owner is a machine, not a device: register the RAM globally. */
+    memory_region_init_rom_device_nomigrate(&m->flash, owner,
+                                            &z63_stm32_flash_ops, m,
+                                            "z63-mcu-flash",
+                                            Z63_STM32_FLASH_SIZE, &err);
+    if (err) {
+        error_propagate(errp, err);
+        return;
+    }
+    vmstate_register_ram_global(&m->flash);
+    memory_region_add_subregion(&m->mem, Z63_STM32_FLASH_BASE, &m->flash);
+    memory_region_init_alias(&m->flash_alias, owner, "z63-mcu-flash-alias",
+                             &m->flash, 0, Z63_STM32_FLASH_SIZE);
+    memory_region_add_subregion(&m->mem, 0, &m->flash_alias);
+    memory_region_init_ram(&m->sram, NULL, "z63-mcu-sram",
+                           Z63_STM32_SRAM_SIZE, &error_fatal);
+    memory_region_add_subregion(&m->mem, Z63_STM32_SRAM_BASE, &m->sram);
+    memory_region_init_ram(&m->ccm, NULL, "z63-mcu-ccm",
+                           Z63_STM32_CCM_SIZE, &error_fatal);
+    memory_region_add_subregion(&m->mem, Z63_STM32_CCM_BASE, &m->ccm);
+    memory_region_init_ram(&m->bkpsram, NULL, "z63-mcu-bkpsram",
+                           Z63_STM32_BKPSRAM_SIZE, &error_fatal);
+    memory_region_add_subregion(&m->mem, Z63_STM32_BKPSRAM_BASE, &m->bkpsram);
+
+    z63_stm32_map(m, &m->rcc_mr, owner, &z63_stm32_rcc_ops, m, "z63-mcu-rcc",
+                Z63_STM32_RCC_BASE, 0x400);
+    z63_stm32_map(m, &m->pwr_mr, owner, &z63_stm32_pwr_ops, m, "z63-mcu-pwr",
+                Z63_STM32_PWR_BASE, 0x400);
+    z63_stm32_map(m, &m->rtc_mr, owner, &z63_stm32_rtc_ops, m, "z63-mcu-rtc",
+                Z63_STM32_RTC_BASE, 0x400);
+    z63_stm32_map(m, &m->flashif_mr, owner, &z63_stm32_flashif_ops, m,
+                "z63-mcu-flashif", Z63_STM32_FLASHIF_BASE, 0x400);
+    for (unsigned i = 0; i < Z63_STM32_GPIO_PORTS; i++) {
+        g_autofree char *name = g_strdup_printf("z63-mcu-gpio%c", 'a' + i);
+
+        m->gpio[i].mcu = m;
+        m->gpio[i].port = i;
+        z63_stm32_map(m, &m->gpio[i].mr, owner, &z63_stm32_gpio_ops, &m->gpio[i],
+                    name, Z63_STM32_GPIO_BASE + 0x400 * i, 0x400);
+    }
+
+    m->sysclk = clock_new(owner, "z63-mcu-sysclk");
+    clock_set_hz(m->sysclk, Z63_STM32_SYSCLK_HZ);
+    m->refclk = clock_new(owner, "z63-mcu-refclk");
+    clock_set_mul_div(m->refclk, 8, 1);             /* HCLK / 8 */
+    clock_set_source(m->refclk, m->sysclk);
+
+    object_initialize_child(owner, "z63-mcu-armv7m", &m->armv7m, TYPE_ARMV7M);
+    armv7m = DEVICE(&m->armv7m);
+    qdev_prop_set_uint32(armv7m, "num-irq", Z63_STM32_NUM_IRQ);
+    qdev_prop_set_uint8(armv7m, "num-prio-bits", 4);
+    qdev_prop_set_string(armv7m, "cpu-type", ARM_CPU_TYPE_NAME("cortex-m4"));
+    qdev_prop_set_bit(armv7m, "enable-bitband", true);
+    qdev_connect_clock_in(armv7m, "cpuclk", m->sysclk);
+    qdev_connect_clock_in(armv7m, "refclk", m->refclk);
+    object_property_set_link(OBJECT(armv7m), "memory", OBJECT(&m->mem),
+                             &error_abort);
+    if (!sysbus_realize(SYS_BUS_DEVICE(armv7m), errp)) {
+        return;
+    }
+
+    for (unsigned i = 0; i < 4; i++) {
+        g_autofree char *name = g_strdup_printf("z63-mcu-tim%u", i + 2);
+        SysBusDevice *sbd;
+
+        object_initialize_child(owner, name, &m->tim[i], TYPE_STM32F2XX_TIMER);
+        qdev_prop_set_uint64(DEVICE(&m->tim[i]), "clock-frequency",
+                             Z63_STM32_TIM_HZ);
+        sbd = SYS_BUS_DEVICE(&m->tim[i]);
+        if (!sysbus_realize(sbd, errp)) {
+            return;
+        }
+        memory_region_add_subregion(&m->mem, z63_stm32_tim_base[i],
+                                    sysbus_mmio_get_region(sbd, 0));
+        sysbus_connect_irq(sbd, 0, qdev_get_gpio_in(armv7m,
+                                                    z63_stm32_tim_irq[i]));
+    }
+
+    for (unsigned i = 0; i < ARRAY_SIZE(m->i2c_dev); i++) {
+        m->i2c_dev[i].bus = z63_stm32_i2c_dev_at[i].bus;
+        m->i2c_dev[i].addr = z63_stm32_i2c_dev_at[i].addr;
+    }
+    for (unsigned i = 0; i < 3; i++) {
+        g_autofree char *name = g_strdup_printf("z63-mcu-i2c%u", i + 1);
+        Z63Stm32I2c *c = &m->i2c[i];
