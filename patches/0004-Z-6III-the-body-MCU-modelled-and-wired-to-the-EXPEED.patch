+        !(s->engine150c_active & 2) || (s->engine150c_stop_requested & 2) ||
+        !value || strcmp(value, "1")) {
+        error_setg(errp, "engine150c-bit2-input requires an active realized bit2 model and value 1");
+        return;
+    }
+    engine150c_bit2_pulse(s);
+}
