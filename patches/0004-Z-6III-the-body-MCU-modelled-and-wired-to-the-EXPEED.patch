+/* ------------------------------------------------------------------ */
+/* Everything the image was not seen to need.                          */
+/* ------------------------------------------------------------------ */
+
+static uint64_t z63_stm32_trap_read(void *opaque, hwaddr addr, unsigned size)
+{
+    z63_stm32_stop("space", addr, size, false, 0);
+    return 0;
+}
+
+static void z63_stm32_trap_write(void *opaque, hwaddr addr, uint64_t value,
+                               unsigned size)
+{
+    z63_stm32_stop("space", addr, size, true, value);
+}
+
+static const MemoryRegionOps z63_stm32_trap_ops = {
+    .read = z63_stm32_trap_read,
+    .write = z63_stm32_trap_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+/* ------------------------------------------------------------------ */
+/* RCC (RM0386 section 6). Ready bits follow their enables.            */
+/* ------------------------------------------------------------------ */
+
+#define Z63_RCC_CR        0x00
+#define Z63_RCC_CFGR      0x08
+#define Z63_RCC_CIR       0x0c
+#define Z63_RCC_BDCR      0x70
+#define Z63_RCC_CSR       0x74
+
+static bool z63_stm32_rcc_valid(hwaddr off)
+{
+    switch (off) {
+    case 0x00: case 0x04: case 0x08: case 0x0c:     /* CR PLLCFGR CFGR CIR */
+    case 0x10: case 0x14: case 0x18:                /* AHB1-3 RSTR */
+    case 0x20: case 0x24:                           /* APB1-2 RSTR */
+    case 0x30: case 0x34: case 0x38:                /* AHB1-3 ENR */
+    case 0x40: case 0x44:                           /* APB1-2 ENR */
+    case 0x50: case 0x54: case 0x58:                /* AHB1-3 LPENR */
+    case 0x60: case 0x64:                           /* APB1-2 LPENR */
+    case 0x70: case 0x74:                           /* BDCR CSR */
+    case 0x80: case 0x84: case 0x88: case 0x8c:     /* SSCGR PLLI2S PLLSAI DCKCFGR */
+        return true;
+    case 0x90: case 0x94:
+        /* CKGATENR/DCKCFGR2 on the F412/F413/F446; the boot loader
+         * read-modify-writes 0x94 (pc 0x080007a2). Storage. */
+        return true;
+    }
+    return false;
+}
+
+static void z63_stm32_rcc_reset(Z63Stm32 *m)
+{
+    memset(m->rcc, 0, sizeof(m->rcc));
+    m->rcc[0x00 / 4] = 0x00000083;  /* HSION, HSIRDY, HSITRIM 16 */
+    m->rcc[0x04 / 4] = 0x24003010;
+    m->rcc[0x30 / 4] = 0x00100000;
+    m->rcc[0x50 / 4] = 0x7e6791ff;
+    m->rcc[0x54 / 4] = 0x000000f1;
+    m->rcc[0x58 / 4] = 0x00000003;
+    m->rcc[0x60 / 4] = 0xf6fec9ff;
+    m->rcc[0x64 / 4] = 0x0c777f33;
+    m->rcc[0x74 / 4] = 0x0e000000;  /* PORRSTF PINRSTF BORRSTF: a power-on */
+    m->rcc[0x84 / 4] = 0x24003000;
+    m->rcc[0x88 / 4] = 0x24003000;
+}
+
+static uint64_t z63_stm32_rcc_read(void *opaque, hwaddr off, unsigned size)
+{
+    Z63Stm32 *m = opaque;
+    uint32_t v;
+
+    if (size != 4 || !z63_stm32_rcc_valid(off)) {
+        z63_stm32_stop("RCC", Z63_STM32_RCC_BASE + off, size, false, 0);
+        return 0;
+    }
+    v = m->rcc[off / 4];
+    switch (off) {
+    case Z63_RCC_CR:
+        v &= ~((1u << 1) | (1u << 17) | (1u << 25) | (1u << 27) | (1u << 29));
+        v |= (v & 1u) << 1;                 /* HSIRDY    <- HSION */
+        v |= (v & (1u << 16)) << 1;         /* HSERDY    <- HSEON */
+        v |= (v & (1u << 24)) << 1;         /* PLLRDY    <- PLLON */
+        v |= (v & (1u << 26)) << 1;         /* PLLI2SRDY <- PLLI2SON */
+        v |= (v & (1u << 28)) << 1;         /* PLLSAIRDY <- PLLSAION */
+        break;
+    case Z63_RCC_CFGR:
+        v = (v & ~0xcu) | ((v & 3u) << 2);  /* SWS <- SW */
+        break;
+    case Z63_RCC_BDCR:
+        v = (v & ~2u) | ((v & 1u) << 1);    /* LSERDY <- LSEON */
+        break;
+    case Z63_RCC_CSR:
+        v = (v & ~2u) | ((v & 1u) << 1);    /* LSIRDY <- LSION */
+        break;
+    }
+    return v;
+}
+
+static void z63_stm32_rcc_write(void *opaque, hwaddr off, uint64_t value,
+                              unsigned size)
+{
+    Z63Stm32 *m = opaque;
+
+    if (size != 4 || !z63_stm32_rcc_valid(off)) {
+        z63_stm32_stop("RCC", Z63_STM32_RCC_BASE + off, size, true, value);
+        return;
+    }
+    switch (off) {
+    case Z63_RCC_CIR:
+        /* No ready interrupt is ever raised: keep the enables, the clear
+         * bits (16..23) have nothing to clear. */
+        m->rcc[off / 4] = value & 0x00007f00;
+        return;
+    case Z63_RCC_CSR:
+        if (value & (1u << 24)) {           /* RMVF clears the reset flags */
+            m->rcc[off / 4] &= 0x00ffffff;
+        }
+        m->rcc[off / 4] = (m->rcc[off / 4] & 0xfe000000) | (value & 1u);
+        return;
+    }
+    m->rcc[off / 4] = value;
+}
+
+static const MemoryRegionOps z63_stm32_rcc_ops = {
+    .read = z63_stm32_rcc_read,
+    .write = z63_stm32_rcc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+/* ------------------------------------------------------------------ */
+/* PWR (RM0386 section 5): regulator, over-drive, backup regulator.    */
+/* ------------------------------------------------------------------ */
+
+static uint64_t z63_stm32_pwr_read(void *opaque, hwaddr off, unsigned size)
+{
+    Z63Stm32 *m = opaque;
+    uint32_t v;
+
+    if (size != 4 || off > 0x04) {
+        z63_stm32_stop("PWR", Z63_STM32_PWR_BASE + off, size, false, 0);
+        return 0;
+    }
+    if (off == 0x00) {
+        return m->pwr_cr;
+    }
+    v = m->pwr_csr & ((1u << 8) | (1u << 9));          /* EWUP, BRE */
+    v |= (v & (1u << 9)) ? (1u << 3) : 0;               /* BRR <- BRE */
+    v |= 1u << 14;                                      /* VOSRDY */
+    v |= (m->pwr_cr & (1u << 16)) ? (1u << 16) : 0;     /* ODRDY <- ODEN */
+    v |= (m->pwr_cr & (1u << 17)) ? (1u << 17) : 0;     /* ODSWRDY <- ODSWEN */
+    return v;
+}
+
+static void z63_stm32_pwr_write(void *opaque, hwaddr off, uint64_t value,
+                              unsigned size)
+{
+    Z63Stm32 *m = opaque;
+
+    if (size != 4 || off > 0x04) {
+        z63_stm32_stop("PWR", Z63_STM32_PWR_BASE + off, size, true, value);
+        return;
+    }
+    if (off == 0x00) {
+        m->pwr_cr = value & ~((1u << 2) | (1u << 3));   /* CWUF/CSBF: clear */
+    } else {
+        m->pwr_csr = value & ((1u << 8) | (1u << 9));
+    }
+}
+
+static const MemoryRegionOps z63_stm32_pwr_ops = {
+    .read = z63_stm32_pwr_read,
+    .write = z63_stm32_pwr_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+/* ------------------------------------------------------------------ */
+/* FLASH interface (RM0386 section 3.9): latency, caches, the lock.    */
+/* ------------------------------------------------------------------ */
+
+/* Sector n of a bank: 4 x 16K, 64K, 7 x 128K (RM0386 3.4); SNB bit 4
+ * selects bank 2, 1 MiB up. */
+static void z63_stm32_flash_sector(unsigned snb, hwaddr *base, uint32_t *len)
+{
+    unsigned idx = snb & 0xf;
+
+    if (idx < 4) {
+        *base = idx * 16 * KiB;
+        *len = 16 * KiB;
+    } else if (idx == 4) {
+        *base = 64 * KiB;
+        *len = 64 * KiB;
+    } else {
+        *base = (idx - 4) * 128 * KiB;
+        *len = 128 * KiB;
+    }
+    *base += (snb & 0x10) ? MiB : 0;
+}
+
+static void z63_stm32_flash_erase(Z63Stm32 *m, hwaddr base, uint32_t len)
+{
+    uint8_t *p = memory_region_get_ram_ptr(&m->flash);
+
+    if (base + len > Z63_STM32_FLASH_SIZE) {
+        z63_stm32_stop("FLASH erase", Z63_STM32_FLASH_BASE + base, 4, true,
+                       len);
+        return;
+    }
+    memset(p + base, 0xff, len);
+    memory_region_flush_rom_device(&m->flash, base, len);
+    error_report("Z63_STM32: flash erased 0x%08" HWADDR_PRIx "..+0x%x "
+                 "(pc=0x%08x)", Z63_STM32_FLASH_BASE + base, len,
+                 z63_stm32_pc());
+}
+
+static void z63_stm32_flash_done(Z63Stm32 *m)
+{
+    if (m->flash_cr & (1u << 24)) {             /* EOPIE */
+        m->flash_sr |= 1;                       /* EOP */
+    }
+    qemu_set_irq(m->flash_irq, (m->flash_sr & 1) && (m->flash_cr & (1u << 24)));
+}
+
+static uint64_t z63_stm32_flashif_read(void *opaque, hwaddr off, unsigned size)
+{
+    Z63Stm32 *m = opaque;
+
+    if (size == 1 && off == 0x00) {     /* ACR byte 0: LATENCY (HAL style) */
+        return m->flash_acr & 0xff;
+    }
+    if (size == 4) {
+        switch (off) {
+        case 0x00: return m->flash_acr;
+        case 0x0c: return m->flash_sr;
+        case 0x10: return m->flash_cr;
+        case 0x14: return m->flash_optcr;
+        case 0x18: return m->flash_optcr1;
+        }
+    }
+    z63_stm32_stop("FLASH", Z63_STM32_FLASHIF_BASE + off, size, false, 0);
+    return 0;
+}
+
+static void z63_stm32_flashif_write(void *opaque, hwaddr off, uint64_t value,
+                                  unsigned size)
+{
+    Z63Stm32 *m = opaque;
+
+    if (size == 1 && off == 0x00) {     /* ACR byte 0: LATENCY (HAL style) */
+        m->flash_acr = (m->flash_acr & ~0xffu) | (value & 0x0f);
+        return;
+    }
+    if (size == 4) {
+        switch (off) {
+        case 0x00:
+            m->flash_acr = value & ~((1u << 11) | (1u << 12)); /* ICRST/DCRST */
+            return;
+        case 0x04:                                  /* KEYR */
+            if (m->flash_key == 0 && value == 0x45670123) {
+                m->flash_key = 1;
+            } else if (m->flash_key == 1 && value == 0xcdef89ab) {
+                m->flash_cr &= ~(1u << 31);
+                m->flash_key = 0;
+            } else {
+                m->flash_key = 0;       /* a wrong key: CR stays locked */
+            }
+            return;
+        case 0x0c:                                  /* SR: W1C */
+            m->flash_sr &= ~(value & 0x1f3);
+            qemu_set_irq(m->flash_irq,
+                         (m->flash_sr & 1) && (m->flash_cr & (1u << 24)));
+            return;
+        case 0x10:
+            if (value & (1u << 31)) {
+                m->flash_cr = 1u << 31;
+                return;
+            }
+            if (m->flash_cr & (1u << 31)) {
+                return;                 /* locked: ignored, as on the part */
+            }
+            m->flash_cr = value & ~(1u << 16);
+            if (value & (1u << 16)) {   /* STRT */
+                if (value & ((1u << 2) | (1u << 15))) {        /* MER MER1 */
+                    if (value & (1u << 2)) {
+                        z63_stm32_flash_erase(m, 0, MiB);
+                    }
+                    if (value & (1u << 15)) {
+                        z63_stm32_flash_erase(m, MiB, MiB);
+                    }
+                } else if (value & (1u << 1)) {                 /* SER */
+                    hwaddr base;
+                    uint32_t len;
+
+                    z63_stm32_flash_sector((value >> 3) & 0x1f, &base, &len);
+                    z63_stm32_flash_erase(m, base, len);
+                } else {
+                    break;
+                }
+                z63_stm32_flash_done(m);
+            }
+            return;
+        }
+    }
+    z63_stm32_stop("FLASH", Z63_STM32_FLASHIF_BASE + off, size, true, value);
+}
+
+static const MemoryRegionOps z63_stm32_flashif_ops = {
+    .read = z63_stm32_flashif_read,
+    .write = z63_stm32_flashif_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+/* Writes to the flash array itself are programming: with CR.PG set and
+ * the interface unlocked, bits go from 1 to 0 (new & old). Anything else
+ * is a programming error on the part, and stops here. */
+static void z63_stm32_flash_write(void *opaque, hwaddr off, uint64_t value,
+                                  unsigned size)
+{
+    Z63Stm32 *m = opaque;
+    uint8_t *p = memory_region_get_ram_ptr(&m->flash);
+
+    if ((m->flash_cr & (1u << 31)) || !(m->flash_cr & 1)) {
+        /*
+         * Not locked-and-programming-enabled: the part ignores the write
+         * (RM0386 3.9.2 -- no bus fault, the word is simply discarded), and
+         * so does this. It used to stop here, on the theory that any write
+         * outside programming mode means the model's flash controller had
+         * drifted; it does not. The image reaches this path at pc
+         * 0x08052340, a HAL_TIM_Base_Init whose handle carries a garbage
+         * Instance (0x08020369, unaligned and inside the default-handler
+         * stubs), so its register writes land in flash. On the part that
+         * is a silent no-op and the firmware carries on. Named once, so a
+         * real divergence is still visible rather than buried.
+         */
+        if (!m->flash_ignored_named) {
+            m->flash_ignored_named = true;
+            error_report("Z63_STM32: write to flash at 0x%" HWADDR_PRIx
+                         " with the controller not in programming mode "
+                         "(CR=0x%08x) -- ignored, as on the part; pc=0x%08x",
+                         Z63_STM32_FLASH_BASE + off, m->flash_cr,
+                         z63_stm32_pc());
+        }
+        return;
+    }
+    for (unsigned i = 0; i < size; i++) {
+        p[off + i] &= value >> (8 * i);
+    }
+    memory_region_flush_rom_device(&m->flash, off, size);
+    z63_stm32_flash_done(m);
+}
+
+static const MemoryRegionOps z63_stm32_flash_ops = {
+    .write = z63_stm32_flash_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+/* ------------------------------------------------------------------ */
+/* GPIO A..K (RM0386 section 8).                                       */
+/* ------------------------------------------------------------------ */
+
+static uint16_t z63_stm32_gpio_idr(Z63Stm32Gpio *g)
+{
+    uint16_t v = 0;
+
+    for (unsigned pin = 0; pin < 16; pin++) {
+        unsigned mode = (g->moder >> (2 * pin)) & 3;
+        unsigned pull = (g->pupdr >> (2 * pin)) & 3;
+        bool level;
+
+        if (mode == 1) {
+            level = g->odr & (1u << pin);           /* output: reads back */
+        } else if (g->driven & (1u << pin)) {
+            level = g->level & (1u << pin);
+        } else {
+            level = pull == 1;                      /* pull-up reads 1 */
+        }
+        v |= level << pin;
+    }
+    return v;
+}
+
+/* Drive an input from outside (a switch, a peer's handshake line). An
+ * input whose level changes reaches EXTI through SYSCFG's routing, as on
+ * the part. */
+static void z63_stm32_gpio_drive(Z63Stm32Gpio *g, unsigned pin, bool level)
+{
+    uint16_t before = z63_stm32_gpio_idr(g);
+    uint16_t after;
+
+    g->driven |= 1u << pin;
+    g->level = (g->level & ~(1u << pin)) | (level << pin);
+    after = z63_stm32_gpio_idr(g);
+    if (((before ^ after) >> pin) & 1 &&
+        ((g->mcu->syscfg[(0x08 + 4 * (pin / 4)) / 4] >> (4 * (pin % 4))) & 0xf)
+        == g->port) {
+        qemu_set_irq(qdev_get_gpio_in(DEVICE(&g->mcu->exti), pin), level);
+    }
+}
+
+/* "G7=1,C5=0": drive those inputs. */
+static bool z63_stm32_pins(Z63Stm32 *m, const char *spec, Error **errp)
+{
+    g_auto(GStrv) items = g_strsplit_set(spec ? spec : "", ",:", -1);
+
+    for (char **it = items; *it; it++) {
+        unsigned port, pin, level;
+        char c;
+
+        if (!**it) {
+            continue;
+        }
+        if (sscanf(*it, "%c%u=%u", &c, &pin, &level) != 3 ||
+            (c = g_ascii_toupper(c)) < 'A' || c > 'K' || pin > 15 ||
+            level > 1) {
+            error_setg(errp, "pins: '%s' is not <port><pin>=<0|1>", *it);
+            return false;
+        }
+        port = c - 'A';
+        z63_stm32_gpio_drive(&m->gpio[port], pin, level);
+        error_report("Z63_STM32: P%c%u driven %u", c, pin, level);
+    }
+    return true;
+}
+
+static uint64_t z63_stm32_gpio_read(void *opaque, hwaddr off, unsigned size)
+{
+    Z63Stm32Gpio *g = opaque;
+
+    if (size == 4) {
+        switch (off) {
+        case 0x00: return g->moder;
+        case 0x04: return g->otyper;
+        case 0x08: return g->ospeedr;
+        case 0x0c: return g->pupdr;
+        case 0x10:
+        {
+            uint32_t pc = z63_stm32_pc();
+            unsigned i;
+
+            /* Name each reader once (up to 16 a port): which code polls
+             * which port is how the switches and status lines are found. */
+            for (i = 0; i < g->idr_npcs && g->idr_pcs[i] != pc; i++) {
+            }
+            if (i == g->idr_npcs && i < ARRAY_SIZE(g->idr_pcs)) {
+                g->idr_pcs[g->idr_npcs++] = pc;
+                error_report("Z63_STM32: GPIO%c inputs read at pc=0x%08x "
+                             "(lr=0x%08x): 0x%04x, moder 0x%08x pupdr 0x%08x",
+                             'A' + g->port, pc,
+                             current_cpu ? ARM_CPU(current_cpu)->env.regs[14]
+                                         : 0,
+                             z63_stm32_gpio_idr(g), g->moder, g->pupdr);
+            }
+            return z63_stm32_gpio_idr(g);
+        }
+        case 0x14: return g->odr;
+        case 0x1c: return g->lckr;
+        case 0x20: return g->afr[0];
+        case 0x24: return g->afr[1];
+        }
+    }
+    z63_stm32_stop("GPIO", Z63_STM32_GPIO_BASE + 0x400 * g->port + off, size,
+                 false, 0);
+    return 0;
+}
+
+static void z63_stm32_gpio_set_odr(Z63Stm32Gpio *g, uint32_t odr)
+{
+    odr &= 0xffff;
+    if (odr != g->odr && g->odr_named < 64) {
+        g->odr_named++;
+        /* TEMPORARY PROBE (remove): every pin write goes through one HAL
+         * function, so the PC alone does not say who drove the pin; the
+         * return address does. */
+        uint32_t lr = getenv("Z63_STM32_DEBUG") ?
+            (uint32_t)g->mcu->armv7m.cpu->env.regs[14] : 0;
+
+        error_report("Z63_STM32: GPIO%c outputs 0x%04x -> 0x%04x "
+                     "(pc=0x%08x lr=0x%08x)",
+                     'A' + g->port, g->odr, odr, z63_stm32_pc(), lr);
+    }
+    if (g->mcu->pin_out && g->odr != odr) {
+        uint16_t changed = g->odr ^ odr;
+
+        for (unsigned pin = 0; pin < 16; pin++) {
+            if (changed & (1u << pin)) {
+                g->mcu->pin_out(g->mcu->pin_out_opaque, g->port, pin,
+                                (odr >> pin) & 1);
+            }
+        }
+    }
+    g->odr = odr;
+}
+
+static void z63_stm32_gpio_write(void *opaque, hwaddr off, uint64_t value,
+                               unsigned size)
+{
+    Z63Stm32Gpio *g = opaque;
+
+    if (size == 4) {
+        switch (off) {
+        case 0x00: g->moder = value; return;
+        case 0x04: g->otyper = value & 0xffff; return;
+        case 0x08: g->ospeedr = value; return;
+        case 0x0c: g->pupdr = value; return;
+        case 0x14: z63_stm32_gpio_set_odr(g, value); return;
+        case 0x18:                                  /* BSRR: reset wins */
+            z63_stm32_gpio_set_odr(g, (g->odr | (value & 0xffff)) &
+                                    ~(value >> 16));
+            return;
+        case 0x1c: g->lckr = value & 0x1ffff; return;
+        case 0x20: g->afr[0] = value; return;
+        case 0x24: g->afr[1] = value; return;
+        }
+    }
+    z63_stm32_stop("GPIO", Z63_STM32_GPIO_BASE + 0x400 * g->port + off, size,
+                 true, value);
+}
+
+static const MemoryRegionOps z63_stm32_gpio_ops = {
+    .read = z63_stm32_gpio_read,
+    .write = z63_stm32_gpio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void z63_stm32_gpio_reset(Z63Stm32Gpio *g)
+{
+    g->moder = g->otyper = g->ospeedr = g->pupdr = 0;
+    g->odr = g->lckr = g->afr[0] = g->afr[1] = 0;
+    if (g->port == 0) {                 /* PA13/14/15: SWD/JTAG */
+        g->moder = 0xa8000000;
+        g->ospeedr = 0x0c000000;
+        g->pupdr = 0x64000000;
+    } else if (g->port == 1) {          /* PB3/4: JTAG */
+        g->moder = 0x00000280;
+        g->ospeedr = 0x000000c0;
+        g->pupdr = 0x00000100;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* RTC (RM0386 section 25): the camera's clock.                        */
+/* ------------------------------------------------------------------ */
+/*
+ * The calendar runs on QEMU's virtual clock from the value the firmware
+ * last wrote in initialisation mode (RM0386 25.3.5: set INIT, wait INITF,
+ * write TR/DR, clear INIT). Shadow registers are always synchronised (RSF
+ * reads 1). Alarms, wake-up timer, time stamp, tamper and calibration are
+ * stored but do nothing; enabling one is reported once. Backup registers
+ * BKP0R..BKP19R are storage.
+ */
+#define Z63_STM32_RTC_BASE 0x40002800ULL
+#define Z63_RTC_TR   0x00
+#define Z63_RTC_DR   0x04
+#define Z63_RTC_CR   0x08
+#define Z63_RTC_ISR  0x0c
+#define Z63_RTC_WPR  0x24
+#define Z63_RTC_SSR  0x28
+
+static unsigned z63_bcd(unsigned v) { return (v / 10) << 4 | (v % 10); }
+static unsigned z63_unbcd(unsigned v) { return (v >> 4) * 10 + (v & 15); }
+
+/* TR/DR (BCD, 24-hour) <-> seconds since 2000-01-01, the RTC's century. */
+static int64_t z63_stm32_rtc_to_s(uint32_t tr, uint32_t dr)
+{
+    struct tm t = {
+        .tm_year = 100 + z63_unbcd((dr >> 16) & 0xff),
+        .tm_mon = z63_unbcd((dr >> 8) & 0x1f) - 1,
+        .tm_mday = z63_unbcd(dr & 0x3f),
+        .tm_hour = z63_unbcd((tr >> 16) & 0x3f),
+        .tm_min = z63_unbcd((tr >> 8) & 0x7f),
+        .tm_sec = z63_unbcd(tr & 0x7f),
+    };
+
+    if (t.tm_mon < 0) {
+        t.tm_mon = 0;
+    }
+    if (t.tm_mday == 0) {
+        t.tm_mday = 1;
+    }
+    return mktimegm(&t) - 946684800;
+}
+
+static void z63_stm32_rtc_from_s(int64_t s, uint32_t *tr, uint32_t *dr)
+{
+    time_t tt = s + 946684800;
+    struct tm t;
+
+    gmtime_r(&tt, &t);
+    *tr = z63_bcd(t.tm_hour) << 16 | z63_bcd(t.tm_min) << 8 | z63_bcd(t.tm_sec);
+    *dr = z63_bcd(t.tm_year - 100) << 16 | (t.tm_wday ? t.tm_wday : 7) << 13 |
+          z63_bcd(t.tm_mon + 1) << 8 | z63_bcd(t.tm_mday);
+}
+
+static int64_t z63_stm32_rtc_now_s(Z63Stm32 *m)
+{
+    return m->rtc_base_s + (qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) -
+                            m->rtc_epoch_ns) / NANOSECONDS_PER_SECOND;
+}
+
+static bool z63_stm32_rtc_valid(hwaddr off)
+{
+    return off <= 0x48 || (off >= 0x50 && off <= 0x9c);
+}
+
+static uint64_t z63_stm32_rtc_read(void *opaque, hwaddr off, unsigned size)
+{
+    Z63Stm32 *m = opaque;
+    uint32_t isr, tr, dr;
+
+    if (size != 4 || !z63_stm32_rtc_valid(off) || (off & 3)) {
+        z63_stm32_stop("RTC", Z63_STM32_RTC_BASE + off, size, false, 0);
+        return 0;
+    }
+    switch (off) {
+    case Z63_RTC_TR:
+    case Z63_RTC_DR:
+        if (m->rtc[Z63_RTC_ISR / 4] & (1u << 7)) {      /* INIT: as written */
+            return m->rtc[off / 4];
+        }
+        z63_stm32_rtc_from_s(z63_stm32_rtc_now_s(m), &tr, &dr);
+        return off == Z63_RTC_TR ? tr : dr;
+    case Z63_RTC_ISR:
+        isr = m->rtc[off / 4] & 0x0003ff80;     /* INIT and the event flags */
+        if (isr & (1u << 7)) {
+            isr |= 1u << 6;                     /* INITF */
+        }
+        isr |= 1u << 5;                         /* RSF */
+        if (m->rtc[Z63_RTC_DR / 4] >> 16) {
+            isr |= 1u << 4;                     /* INITS: year set */
+        }
+        if (!(m->rtc[Z63_RTC_CR / 4] & (1u << 10))) {
+            isr |= 1u << 2;                     /* WUTWF: WUTE off */
+        }
+        if (!(m->rtc[Z63_RTC_CR / 4] & (1u << 9))) {
+            isr |= 1u << 1;                     /* ALRBWF */
+        }
+        if (!(m->rtc[Z63_RTC_CR / 4] & (1u << 8))) {
+            isr |= 1u << 0;                     /* ALRAWF */
+        }
+        return isr;
+    case Z63_RTC_WPR:
+        return 0;
+    case Z63_RTC_SSR:
+        return m->rtc[0x10 / 4] & 0x7fff;       /* sub-second: PREDIV_S */
+    }
+    return m->rtc[off / 4];
+}
+
+static void z63_stm32_rtc_write(void *opaque, hwaddr off, uint64_t value,
+                                unsigned size)
+{
+    Z63Stm32 *m = opaque;
+    bool locked = m->rtc_wpr != 2;
+
+    if (size != 4 || !z63_stm32_rtc_valid(off) || (off & 3)) {
+        z63_stm32_stop("RTC", Z63_STM32_RTC_BASE + off, size, true, value);
+        return;
+    }
+    if (off == Z63_RTC_WPR) {           /* 0xca then 0x53 unlocks */
+        m->rtc_wpr = value == 0xca ? 1 : (value == 0x53 && m->rtc_wpr == 1)
+                     ? 2 : 0;
+        return;
+    }
+    if (off >= 0x50) {                  /* backup registers: no lock */
+        m->rtc[off / 4] = value;
+        return;
+    }
+    if (locked) {
+        return;                         /* write-protected, as on the part */
+    }
+    switch (off) {
+    case Z63_RTC_ISR: {
+        uint32_t old = m->rtc[off / 4];
+        uint32_t keep = (old & ~0x3ff00u) | (value & 0x3ff00u & old);
+
+        /* INIT is read/write; the event flags (8..17) only clear. */
+        m->rtc[off / 4] = (keep & ~(1u << 7)) | (value & (1u << 7));
+        if ((old & (1u << 7)) && !(value & (1u << 7))) {
+            m->rtc_base_s = z63_stm32_rtc_to_s(m->rtc[Z63_RTC_TR / 4],
+                                               m->rtc[Z63_RTC_DR / 4]);
+            m->rtc_epoch_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        }
+        return;
+    }
+    case Z63_RTC_TR:
+    case Z63_RTC_DR:
+    case 0x10:                          /* PRER */
+        if (!(m->rtc[Z63_RTC_ISR / 4] & (1u << 7))) {
+            return;                     /* only in initialisation mode */
+        }
+        break;
+    case Z63_RTC_CR:
+        if ((value & 0xff00) && !m->rtc_named_timer) {
+            m->rtc_named_timer = true;
+            error_report("Z63_STM32: RTC alarm/wake-up enabled (CR=0x%" PRIx64
+                         ", pc=0x%08x) -- stored, no interrupt modelled yet",
+                         value, z63_stm32_pc());
+        }
+        break;
+    }
+    m->rtc[off / 4] = value;
+}
+
+static const MemoryRegionOps z63_stm32_rtc_ops = {
+    .read = z63_stm32_rtc_read,
+    .write = z63_stm32_rtc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void z63_stm32_rtc_reset(Z63Stm32 *m)
+{
+    /* The backup domain survives a system reset on the part; here a cold
+     * start is all there is. The calendar starts at 2000-01-01 00:00 and
+     * INITS stays clear until the firmware sets a date. */
+    memset(m->rtc, 0, sizeof(m->rtc));
+    m->rtc[Z63_RTC_DR / 4] = 0x00002101;        /* reset value: Mon 01-01 */
+    m->rtc[0x10 / 4] = 0x007f00ff;              /* PRER */
+    m->rtc_base_s = 0;
+    m->rtc_epoch_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    m->rtc_wpr = 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* I2C1..3 (RM0386 section 27): the v1 master, polled or interrupt.    */
+/* ------------------------------------------------------------------ */
+/*
+ * Master mode only, which is all the image was seen to use. The bus has
+ * no devices yet: every address NACKs (SR1.AF), and each is named once,
+ * which is how the parts the MCU talks to are found. Clock stretching,
+ * arbitration, 10-bit addressing, PEC, SMBus and DMA are not modelled.
+ */
+typedef struct Z63Stm32I2c Z63Stm32I2c;
+
+static const hwaddr z63_stm32_i2c_base[3] = {
+    0x40005400, 0x40005800, 0x40005c00,
+};
+static const int z63_stm32_i2c_irqn[3][2] = { { 31, 32 }, { 33, 34 }, { 72, 73 } };
+
+#define Z63_I2C_SR1_SB    (1u << 0)
+#define Z63_I2C_SR1_ADDR  (1u << 1)
+#define Z63_I2C_SR1_BTF   (1u << 2)
+#define Z63_I2C_SR1_RXNE  (1u << 6)
+#define Z63_I2C_SR1_TXE   (1u << 7)
+#define Z63_I2C_SR1_AF    (1u << 10)
+#define Z63_I2C_SR1_ERR   0xdf00u       /* BERR ARLO AF OVR PECERR TIMEOUT SMBALERT */
+
+static void z63_stm32_i2c_irq(Z63Stm32I2c *c)
+{
+    bool ev = (c->cr2 & (1u << 9)) &&
+              ((c->sr1 & 0x1f) ||
+               ((c->cr2 & (1u << 10)) &&
+                (c->sr1 & (Z63_I2C_SR1_RXNE | Z63_I2C_SR1_TXE))));
+    bool er = (c->cr2 & (1u << 8)) && (c->sr1 & Z63_I2C_SR1_ERR);
+
+    qemu_set_irq(c->ev_irq, ev);
+    qemu_set_irq(c->er_irq, er);
+}
+
+/*
+ * The devices on the MCU's buses. Their parts are not identified yet; each
+ * is a declared register file, the same choice the main board makes for an
+ * unidentified block: 256 byte registers, the first byte written after the
+ * address sets the pointer, data auto-increments. What the firmware needs
+ * from them at boot is that a write reads back -- sub_803B724 writes the
+ * device at 0x61 (registers 2, 5, 8) and checks it three times, and resets
+ * the MCU (power state 11, sub_804A6A8) when the check fails. Every other
+ * address NACKs and is named once.
+ */
+typedef struct Z63Stm32I2cDev Z63Stm32I2cDev;
+
+static const struct { uint8_t bus, addr; } z63_stm32_i2c_dev_at[5] = {
+    { 0, 0x32 }, { 0, 0x61 }, { 0, 0x69 },      /* I2C1 */
+    { 3, 0x22 }, { 3, 0x23 },                   /* FMPI2C1 */
+};
+
+static Z63Stm32I2cDev *z63_stm32_i2c_find(Z63Stm32 *m, unsigned bus,
+                                          uint8_t addr, bool read,
+                                          uint8_t *nack_named)
+{
+    for (unsigned i = 0; i < ARRAY_SIZE(m->i2c_dev); i++) {
+        Z63Stm32I2cDev *d = &m->i2c_dev[i];
+
+        if (d->bus == bus && d->addr == addr) {
+            if (!read) {
+                d->ptr_set = false;
+            }
+            return d;
+        }
+    }
+    if (!(nack_named[addr / 8] & (1u << (addr % 8)))) {
+        nack_named[addr / 8] |= 1u << (addr % 8);
+        error_report("Z63_STM32: %s%u address 0x%02x (%s): no device -- NACK "
+                     "(pc=0x%08x)", bus == 3 ? "FMPI2C" : "I2C",
+                     bus == 3 ? 1 : bus + 1, addr, read ? "read" : "write",
+                     z63_stm32_pc());
+    }
+    return NULL;
+}
+
+static void z63_stm32_i2c_dev_write(Z63Stm32I2cDev *d, uint8_t b)
+{
+    if (!d->ptr_set) {
+        d->ptr = b;
+        d->ptr_set = true;
+        return;
+    }
+    d->regs[d->ptr++] = b;
+    d->writes++;
+}
+
+static uint8_t z63_stm32_i2c_dev_read(Z63Stm32I2cDev *d)
+{
+    d->reads++;
+    return d->regs[d->ptr++];
+}
+
+/* I2C v1: put the next received byte in DR. The byte received while ACK
+ * is clear (or, with POS, the one after it) is the last one. */
+static void z63_stm32_i2c_rx(Z63Stm32I2c *c, bool first)
+{
+    bool ack = c->cr1 & (1u << 10), pos = c->cr1 & (1u << 11);
+
+    if (!c->dev || c->last_sent) {
+        return;
+    }
+    c->dr = z63_stm32_i2c_dev_read(c->dev);
+    c->sr1 |= Z63_I2C_SR1_RXNE | Z63_I2C_SR1_BTF;
+    if (!ack && !(first && pos) && !(c->cr2 & (1u << 11))) {
+        c->last_sent = true;
+    }
+}
+
+/* I2C v1 with CR2.DMAEN: TXE and RXNE are DMA requests (RM0402 24.3.7).
+ * The bytes move at once; with LAST the final received byte is NACKed. */
+static void z63_stm32_i2c_pump(Z63Stm32I2c *c)
+{
+    uint32_t par = z63_stm32_i2c_base[c->bus] + 0x10, v;
+
+    if (!(c->cr2 & (1u << 11)) || !c->selected || !c->dev ||
+        (c->sr1 & Z63_I2C_SR1_ADDR)) {
+        return;
+    }
+    if (!c->reading) {
+        while ((c->sr1 & Z63_I2C_SR1_TXE) && z63_stm32_dma_tx(c->mcu, par, &v)) {
+            z63_stm32_i2c_dev_write(c->dev, v);
+            c->sr1 |= Z63_I2C_SR1_TXE | Z63_I2C_SR1_BTF;
+        }
+    } else {
+        while ((c->sr1 & Z63_I2C_SR1_RXNE) &&
+               z63_stm32_dma_rx(c->mcu, par, c->dr)) {
+            c->sr1 &= ~(Z63_I2C_SR1_RXNE | Z63_I2C_SR1_BTF);
+            z63_stm32_i2c_rx(c, false);
+        }
+    }
+    z63_stm32_i2c_irq(c);
+}
+
+static uint64_t z63_stm32_i2c_read(void *opaque, hwaddr off, unsigned size)
+{
+    Z63Stm32I2c *c = opaque;
+    uint32_t v = 0;
+
+    if (size != 4 && size != 2) {
+        goto bad;
+    }
+    switch (off) {
+    case 0x00: return c->cr1;
+    case 0x04: return c->cr2;
+    case 0x08: return c->oar1;
+    case 0x0c: return c->oar2;
+    case 0x10:
+        v = c->dr;
+        c->sr1 &= ~(Z63_I2C_SR1_RXNE | Z63_I2C_SR1_BTF);
+        if (c->reading && c->dev) {
+            z63_stm32_i2c_rx(c, false);
+        }
+        z63_stm32_i2c_irq(c);
+        return v;
+    case 0x14:
+        c->sb_seen = c->sr1 & Z63_I2C_SR1_SB;
+        c->addr_seen = c->sr1 & Z63_I2C_SR1_ADDR;
+        return c->sr1;
+    case 0x18:
+        v = c->sr2;
+        if (c->addr_seen) {             /* SR1 then SR2 clears ADDR */
+            c->addr_seen = false;
+            c->sr1 &= ~Z63_I2C_SR1_ADDR;
+            if (!c->reading) {
+                c->sr1 |= Z63_I2C_SR1_TXE;
+            } else {
+                c->last_sent = false;
+                z63_stm32_i2c_rx(c, true);
+            }
+            z63_stm32_i2c_pump(c);
+            z63_stm32_i2c_irq(c);
+        }
+        return v;
+    case 0x1c: return c->ccr;
+    case 0x20: return c->trise;
+    case 0x24: return c->fltr;
+    }
+bad:
+    z63_stm32_stop("I2C", z63_stm32_i2c_base[c->bus] + off, size, false, 0);
+    return 0;
+}
+
+static void z63_stm32_i2c_write(void *opaque, hwaddr off, uint64_t value,
+                                unsigned size)
+{
+    Z63Stm32I2c *c = opaque;
+
+    if (size != 4 && size != 2) {
+        goto bad;
+    }
+    switch (off) {
+    case 0x00:
+        if (value & (1u << 15)) {       /* SWRST */
+            c->cr1 = value & (1u << 15);
+            c->sr1 = c->sr2 = 0;
+            c->selected = false;
+            c->dev = NULL;
+            break;
+        }
+        c->cr1 = value & ~((1u << 8) | (1u << 9));
+        if ((value & 1) && (value & (1u << 8))) {      /* START */
+            c->sr1 = (c->sr1 & Z63_I2C_SR1_ERR) | Z63_I2C_SR1_SB;
+            c->sr2 |= 3;                                /* MSL BUSY */
+        }
+        if (value & (1u << 9)) {                        /* STOP */
+            /* A byte already received stays in DR until it is read. */
+            c->selected = false;
+            c->dev = NULL;
+            c->sr1 &= Z63_I2C_SR1_ERR | Z63_I2C_SR1_RXNE;
+            c->sr2 = 0;
+        }
+        break;
+    case 0x04:
+        c->cr2 = value & 0x1f3f;
+        z63_stm32_i2c_pump(c);
+        break;
+    case 0x08: c->oar1 = value; break;
+    case 0x0c: c->oar2 = value; break;
+    case 0x10:
+        c->dr = value;
+        if (c->sb_seen && (c->sr1 & Z63_I2C_SR1_SB)) { /* the address byte */
+            c->sb_seen = false;
+            c->sr1 &= ~Z63_I2C_SR1_SB;
+            c->addr = value >> 1;
+            c->reading = value & 1;
+            c->dev = z63_stm32_i2c_find(c->mcu, c->bus, c->addr, c->reading,
+                                        c->nack_named);
+            c->selected = c->dev != NULL;
+            if (c->selected) {
+                c->sr1 |= Z63_I2C_SR1_ADDR;
+                c->sr2 = (c->sr2 & ~4u) | (c->reading ? 0 : 4);
+            } else {
+                c->sr1 |= Z63_I2C_SR1_AF;
+            }
+        } else if (c->selected && !c->reading) {
+            z63_stm32_i2c_dev_write(c->dev, value);
+            c->sr1 |= Z63_I2C_SR1_TXE | Z63_I2C_SR1_BTF;
+        }
+        break;
+    case 0x14:                          /* the error flags are rc_w0 */
+        c->sr1 &= ~(Z63_I2C_SR1_ERR & ~value);
+        break;
+    case 0x1c: c->ccr = value; break;
+    case 0x20: c->trise = value; break;
+    case 0x24: c->fltr = value; break;
+    default:
+        goto bad;
+    }
+    z63_stm32_i2c_irq(c);
+    return;
+bad:
+    z63_stm32_stop("I2C", z63_stm32_i2c_base[c->bus] + off, size, true, value);
+}
+
+static const MemoryRegionOps z63_stm32_i2c_ops = {
+    .read = z63_stm32_i2c_read,
+    .write = z63_stm32_i2c_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void z63_stm32_i2c_reset(Z63Stm32I2c *c)
+{
+    c->cr1 = c->cr2 = c->oar1 = c->oar2 = c->ccr = c->fltr = 0;
+    c->trise = 2;
+    c->sr1 = c->sr2 = 0;
+    c->selected = c->sb_seen = c->addr_seen = false;
+}
+
+/* ------------------------------------------------------------------ */
+/* FMPI2C1 at 0x40006000: the v2 (F7/L4-style) I2C, master only.       */
+/* ------------------------------------------------------------------ */
+/*
+ * The block the F410/F412/F413/F446 carry; the image reaches it at
+ * pc 0x0804b0f6. As on I2C1..3 no device answers yet: a START sets NACKF
+ * and, the master then stopping, STOPF; each address is named once.
+ */
+#define Z63_STM32_FMPI2C_BASE 0x40006000ULL
+#define Z63_FMP_ISR_TXE   (1u << 0)
+#define Z63_FMP_ISR_NACKF (1u << 4)
+#define Z63_FMP_ISR_STOPF (1u << 5)
+#define Z63_FMP_ISR_BUSY  (1u << 15)
+
+static void z63_stm32_fmpi2c_irq(Z63Stm32 *m)
+{
+    uint32_t cr1 = m->fmpi2c.cr1, isr = m->fmpi2c.isr;
+    bool ev = ((cr1 & (1u << 4)) && (isr & Z63_FMP_ISR_NACKF)) ||    /* NACKIE */
+              ((cr1 & (1u << 5)) && (isr & Z63_FMP_ISR_STOPF));      /* STOPIE */
+
+    qemu_set_irq(m->fmpi2c.ev_irq, ev);
+}
+
+/* Advance a v2 transfer: ask for (TXIS) or present (RXNE) the next byte,
+ * or end it -- TCR with RELOAD, STOPF with AUTOEND, else TC. */
+static void z63_stm32_fmpi2c_step(Z63Stm32 *m)
+{
+    uint32_t cr2 = m->fmpi2c.cr2;
+
+    if (!m->fmpi2c.dev) {
+        return;
+    }
+    /* TXDMAEN/RXDMAEN (CR1 bits 14/15): the bytes move by DMA at once. */
+    while (m->fmpi2c.left) {
+        uint32_t par = Z63_STM32_FMPI2C_BASE, v;
+
+        if ((cr2 & (1u << 10)) && (m->fmpi2c.cr1 & (1u << 15)) &&
+            !(m->fmpi2c.isr & (1u << 2))) {
+            uint8_t b = z63_stm32_i2c_dev_read(m->fmpi2c.dev);
+
+            if (!z63_stm32_dma_rx(m, par + 0x24, b)) {
+                m->fmpi2c.rxdr = b;             /* stream not ready: hold it */
+                m->fmpi2c.left--;
+                m->fmpi2c.isr |= 1u << 2;
+                return;
+            }
+            m->fmpi2c.left--;
+        } else if (!(cr2 & (1u << 10)) && (m->fmpi2c.cr1 & (1u << 14)) &&
+                   z63_stm32_dma_tx(m, par + 0x28, &v)) {
+            z63_stm32_i2c_dev_write(m->fmpi2c.dev, v);
+            m->fmpi2c.left--;
+        } else {
+            break;
+        }
+    }
+    if (m->fmpi2c.left) {
+        if (cr2 & (1u << 10)) {
+            if (!(m->fmpi2c.isr & (1u << 2))) {
+                m->fmpi2c.rxdr = z63_stm32_i2c_dev_read(m->fmpi2c.dev);
+                m->fmpi2c.left--;
+                m->fmpi2c.isr |= 1u << 2;               /* RXNE */
+            }
+        } else {
+            m->fmpi2c.isr |= (1u << 1) | Z63_FMP_ISR_TXE;   /* TXIS */
+        }
+        if (m->fmpi2c.left || (cr2 & (1u << 10) ? 0 : 1)) {
+            return;
+        }
+    }
+    if (m->fmpi2c.isr & (1u << 2)) {
+        return;                                 /* last byte not read yet */
+    }
+    if (cr2 & (1u << 24)) {
+        m->fmpi2c.isr |= 1u << 7;               /* TCR */
+    } else if (cr2 & (1u << 25)) {
+        m->fmpi2c.dev = NULL;                   /* AUTOEND: STOP */
+        m->fmpi2c.isr = (m->fmpi2c.isr & ~Z63_FMP_ISR_BUSY) |
+                        Z63_FMP_ISR_STOPF | Z63_FMP_ISR_TXE;
+    } else {
+        m->fmpi2c.isr |= 1u << 6;               /* TC */
+    }
+}
+
+static uint64_t z63_stm32_fmpi2c_read(void *opaque, hwaddr off, unsigned size)
+{
+    Z63Stm32 *m = opaque;
+
+    if (size == 4) {
+        switch (off) {
+        case 0x00: return m->fmpi2c.cr1;
+        case 0x04: return m->fmpi2c.cr2;
+        case 0x08: return m->fmpi2c.oar1;
+        case 0x0c: return m->fmpi2c.oar2;
+        case 0x10: return m->fmpi2c.timingr;
+        case 0x14: return m->fmpi2c.timeoutr;
+        case 0x18: return m->fmpi2c.isr;
+        case 0x24: {                            /* RXDR */
+            uint8_t v = m->fmpi2c.rxdr;
+
+            m->fmpi2c.isr &= ~(1u << 2);
+            z63_stm32_fmpi2c_step(m);
+            return v;
+        }
+        }
+    }
+    z63_stm32_stop("FMPI2C", Z63_STM32_FMPI2C_BASE + off, size, false, 0);
+    return 0;
+}
+
+static void z63_stm32_fmpi2c_write(void *opaque, hwaddr off, uint64_t value,
+                                   unsigned size)
+{
+    Z63Stm32 *m = opaque;
+
+    if (size == 4) {
+        switch (off) {
+        case 0x00:
+            m->fmpi2c.cr1 = value;
+            if (!(value & 1)) {                 /* PE off: software reset */
+                m->fmpi2c.isr = Z63_FMP_ISR_TXE;
+            }
+            z63_stm32_fmpi2c_irq(m);
+            return;
+        case 0x04: {
+            unsigned addr = (value >> 1) & 0x7f;
+            bool read = value & (1u << 10);
+
+            m->fmpi2c.cr2 = value & ~((1u << 13) | (1u << 14));
+            if (value & (1u << 13)) {           /* START (or repeated) */
+                m->fmpi2c.dev = z63_stm32_i2c_find(m, 3, addr, read,
+                                                   m->fmpi2c.nack_named);
+                m->fmpi2c.isr &= ~((1u << 6) | (1u << 7));      /* TC TCR */
+                if (!m->fmpi2c.dev) {
+                    m->fmpi2c.isr |= Z63_FMP_ISR_NACKF | Z63_FMP_ISR_STOPF;
+                } else {
+                    m->fmpi2c.isr |= Z63_FMP_ISR_BUSY;
+                    m->fmpi2c.left = (value >> 16) & 0xff;
+                    z63_stm32_fmpi2c_step(m);
+                }
+            } else if ((m->fmpi2c.isr & (1u << 7)) && m->fmpi2c.dev) {
+                m->fmpi2c.isr &= ~(1u << 7);    /* TCR: reload NBYTES */
+                m->fmpi2c.left = (value >> 16) & 0xff;
+                z63_stm32_fmpi2c_step(m);
+            }
+            if (value & (1u << 14)) {           /* STOP */
+                m->fmpi2c.dev = NULL;
+                m->fmpi2c.isr = (m->fmpi2c.isr & ~(Z63_FMP_ISR_BUSY | 0xc6)) |
+                                Z63_FMP_ISR_STOPF | Z63_FMP_ISR_TXE;
+            }
+            z63_stm32_fmpi2c_irq(m);
+            return;
+        }
+        case 0x08: m->fmpi2c.oar1 = value; return;
+        case 0x0c: m->fmpi2c.oar2 = value; return;
+        case 0x10: m->fmpi2c.timingr = value; return;
+        case 0x14: m->fmpi2c.timeoutr = value; return;
+        case 0x1c:                              /* ICR */
+            m->fmpi2c.isr &= ~(value & 0x3f38);
+            z63_stm32_fmpi2c_irq(m);
+            return;
+        case 0x28:                              /* TXDR */
+            if (m->fmpi2c.dev && m->fmpi2c.left) {
+                z63_stm32_i2c_dev_write(m->fmpi2c.dev, value);
+                m->fmpi2c.left--;
+                m->fmpi2c.isr &= ~(1u << 1);
+                z63_stm32_fmpi2c_step(m);
+            }
+            z63_stm32_fmpi2c_irq(m);
+            return;
+        }
+    }
+    z63_stm32_stop("FMPI2C", Z63_STM32_FMPI2C_BASE + off, size, true, value);
+}
+
+static const MemoryRegionOps z63_stm32_fmpi2c_ops = {
+    .read = z63_stm32_fmpi2c_read,
+    .write = z63_stm32_fmpi2c_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+/* ------------------------------------------------------------------ */
+/* SYSCFG (RM0402 section 7): memory remap, EXTI line routing.         */
+/* ------------------------------------------------------------------ */
+/*
+ * Own model: QEMU's stm32f4xx-syscfg routes only port A correctly (its
+ * set_irq indexes EXTICR and its outputs with port*16+pin unreduced).
+ * EXTICR1-4 select, per EXTI line n, which port's pin n drives it;
+ * z63_stm32_gpio_drive() consults them. +0x24 is read-modify-written by
+ * the image (bit 0, pc 0x0804b002) and has no meaning in the manuals at
+ * hand (F412 CFGR is +0x2c); storage, like CMPCR.
+ */
+#define Z63_STM32_SYSCFG_BASE 0x40013800ULL
+
+static uint64_t z63_stm32_syscfg_read(void *opaque, hwaddr off, unsigned size)
+{
+    Z63Stm32 *m = opaque;
+
+    if (size != 4 || off >= sizeof(m->syscfg) || off == 0x18 ||
+        off == 0x1c) {
+        z63_stm32_stop("SYSCFG", Z63_STM32_SYSCFG_BASE + off, size, false, 0);
+        return 0;
+    }
+    if (off == 0x20) {
+        return m->syscfg[off / 4] | ((m->syscfg[off / 4] & 1) << 8); /* READY */
+    }
+    return m->syscfg[off / 4];
+}
+
+static void z63_stm32_syscfg_write(void *opaque, hwaddr off, uint64_t value,
+                                   unsigned size)
+{
+    Z63Stm32 *m = opaque;
+
+    if (size != 4 || off >= sizeof(m->syscfg) || off == 0x18 ||
+        off == 0x1c) {
+        z63_stm32_stop("SYSCFG", Z63_STM32_SYSCFG_BASE + off, size, true,
+                       value);
+        return;
+    }
+    m->syscfg[off / 4] = value;
+}
+
+static const MemoryRegionOps z63_stm32_syscfg_ops = {
+    .read = z63_stm32_syscfg_read,
+    .write = z63_stm32_syscfg_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+/* ------------------------------------------------------------------ */
+/* SPI1 at 0x40013000                                                  */
+/* ------------------------------------------------------------------ */
+/*
+ * The first peripheral the image reaches past the timer work: pc
+ * 0x0804d122 loads the register at offset 0, clears bit 6 and stores it
+ * back. On SPI that is CR1.SPE (enable), and the surrounding code is
+ * HAL_SPI's deinit shape (handle->State at +0x51, Instance at +0). The
+ * alternative reading -- that 0x40013000 is only an anchor for SYSCFG at
+ * +0x808 -- is wrong at this site: the offset here is 0. (Both exist:
+ * 0x0804b8de does use [r1, #0x808] for SYSCFG_EXTICR1, from the same
+ * pool constant. The two need not share an author's intent.)
+ *
+ * REGISTER FILE PLUS, not behaviour: SR reports TXE|RXNE so the driver's
+ * polls succeed and the transfer path is reached. What a transfer
+ * actually does is the link question, and it is not answered here -- see
+ * the note at the bottom of this block. Every offset touched is named
+ * once, with its accessor, because which offsets the image uses is the
+ * evidence that identifies the device.
+ */
+/* The SPI family (RM0386 28.5): SPI1 at 0x40013000, SPI2 0x40003800,
+ * SPI3 0x40003c00, SPI4 0x40013400, SPI5 0x40015000, SPI6 0x40015400.
+ *
+ * This is the link. The first peripheral the image reaches past the timer
+ * work is SPI1: pc 0x0804d122 loads offset 0, clears bit 6 and stores it
+ * back -- CR1.SPE, the enable -- and the surrounding code is HAL_SPI's
+ * deinit shape (handle->State at +0x51, Instance at +0). Then the running
+ * module at 0x0803922x, the one §9b could not get to run, touches CR2,
+ * DR and SR in that order: a transfer. An MCU that is the SPI master is
+ * also exactly what the other side describes -- "the MCU, not the EXPEED,
+ * supplies the clock". (0x40013000 also appears as an anchor for SYSCFG
+ * at [base + 0x808]; 0x0804b8de does use that form. Both readings are
+ * real, at different sites.)
+ *
+ * REGISTER FILE PLUS, not behaviour. SR reports TXE|RXNE so the driver's
+ * polls succeed and its transfer loop is reached; a word written to DR is
+ * held, and a DR read hands back whatever was last put there (0 until
+ * something does). What a transfer *means* -- which words go to which
+ * SIO instance on the EXPEED, and what the EXPEED sends back -- is the
+ * wiring step, and is deliberately not invented here. Every register the
+ * image touches is named once, with its accessor, because which registers
+ * it uses is the evidence that identifies the device.
+ */
+static const hwaddr z63_stm32_spi_base[Z63_STM32_SPI_N] = {
+    0x40013000,     /* SPI1 */
+    0x40003800,     /* SPI2 */
+    0x40003c00,     /* SPI3 */
+    0x40013400,     /* SPI4 */
+    0x40015000,     /* SPI5 */
+    0x40015400,     /* SPI6 */
+};
+static const int z63_stm32_spi_irq[Z63_STM32_SPI_N] = {
+    35, 36, 51, 84, 85, 86,
+};
+
+#define Z63_SPI_CR1     0x00
+#define Z63_SPI_CR2     0x04
+#define Z63_SPI_SR      0x08
+#define Z63_SPI_DR      0x0c
+
+/* SR bits the driver tests (RM0386 28.5.5). */
+#define Z63_SPI_SR_RXNE (1 << 0)
+#define Z63_SPI_SR_TXE  (1 << 1)
+#define Z63_SPI_SR_BSY  (1 << 7)
+
+static void z63_stm32_spi_note(Z63Stm32Spi *sp, hwaddr off, bool write)
+{
+    /* Registers are four bytes apart, so one bit per register fits. */
+    static const char *const names[] = {
+        [0x00] = "CR1", [0x04] = "CR2", [0x08] = "SR", [0x0c] = "DR",
+        [0x10] = "CRCPR", [0x14] = "RXCRCR", [0x18] = "TXCRCR",
+        [0x1c] = "I2SCFGR", [0x20] = "I2SPR",
+    };
+    unsigned bit = off / 4;
+    const char *name = off < ARRAY_SIZE(names) && names[off] ? names[off] : "?";
+
+    if (bit >= 32 || (sp->seen & (1u << bit))) {
+        return;
+    }
+    sp->seen |= 1u << bit;
+    error_report("Z63_STM32: SPI%u first %s of %s (off 0x%02x) pc=0x%08x",
+                 sp->inst + 1, write ? "write" : "read", name,
+                 (unsigned)off, z63_stm32_pc());
+}
+
+static uint64_t z63_stm32_spi_read(void *opaque, hwaddr off, unsigned size)
+{
+    Z63Stm32Spi *sp = opaque;
+
+    z63_stm32_spi_note(sp, off, false);
+
+    switch (off) {
+    case Z63_SPI_SR:
+        /* Not busy, and both directions always ready: there is no peer on
+         * the other end of this bus yet, so a driver that waits on a flag
+         * would wait for ever. Saying "ready" lets it reach its transfer
+         * and is the honest answer for a bus nobody is clocking. */
+        return Z63_SPI_SR_TXE | Z63_SPI_SR_RXNE;
+    case Z63_SPI_DR:
+        sp->words_in++;
+        return sp->dr;
+    default:
+        if (off < sizeof(sp->r)) {
+            return sp->r[off / 4];
+        }
+        z63_stm32_stop("SPI", z63_stm32_spi_base[sp->inst] + off, size,
+                       false, 0);
+        return 0;
+    }
+}
+
+static void z63_stm32_spi_write(void *opaque, hwaddr off, uint64_t value,
+                                unsigned size)
+{
+    Z63Stm32Spi *sp = opaque;
+
+    z63_stm32_spi_note(sp, off, true);
+
+    if (off == Z63_SPI_DR) {
+        /* One word out, one word in: the peer clocks the exchange. With no
+         * peer the bus is unconnected, and an unconnected MISO reads 0. */
+        sp->words_out++;
+        sp->dr = sp->peer ? sp->peer(sp->peer_opaque, sp->inst, value) : 0;
+        return;
+    }
+    if (off < sizeof(sp->r)) {
+        bool was_on = sp->r[Z63_SPI_CR1 / 4] & 0x40;
+
+        sp->r[off / 4] = value;
+        if (off == Z63_SPI_CR1 && (value & 0x40) && !was_on) {
+            /* Enabling the SPI raises a request line, as on the part; if a
+             * stream is already armed for this instance, that is the moment
+             * the link starts moving. */
+            error_report("Z63_STM32: SPI%u enabled (CR1.SPE set) pc=0x%08x",
+                         sp->inst + 1, z63_stm32_pc());
+            z63_stm32_dma_kick(sp->mcu);
+        }
+        return;
+    }
+    z63_stm32_stop("SPI", z63_stm32_spi_base[sp->inst] + off, size, true,
+                   value);
+}
+
+static const MemoryRegionOps z63_stm32_spi_ops = {
+    .read = z63_stm32_spi_read,
+    .write = z63_stm32_spi_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+/* Wire a peer onto SPI `inst` (0 = SPI1, 3 = SPI4). The board calls this
+ * from mcu-spi-peer=; nothing else in the model assumes a peer exists. */
+static void z63_stm32_spi_peer(Z63Stm32 *m, unsigned inst,
+                               uint16_t (*fn)(void *, unsigned, uint16_t),
+                               void *opaque)
+{
+    if (inst >= Z63_STM32_SPI_N) {
+        return;
+    }
+    m->spi[inst].peer = fn;
+    m->spi[inst].peer_opaque = opaque;
+}
+
+/* USART1, USART2, USART3, UART4, UART5, USART6 (QEMU's stm32f2xx model).
+ * The application programs USART1 first (pc 0x0804e292). */
+static const hwaddr z63_stm32_usart_base[6] = {
+    0x40011000, 0x40004400, 0x40004800, 0x40004c00, 0x40005000, 0x40011400,
+};
+static const int z63_stm32_usart_irq[6] = { 37, 38, 39, 52, 53, 71 };
+
+/* EXTI lines 0..15 to the NVIC (lines 5-9 and 10-15 share a vector). */
+static const int z63_stm32_exti_irq[16] = {
+    6, 7, 8, 9, 10, 23, 23, 23, 23, 23, 40, 40, 40, 40, 40, 40,
+};
+
+/* ------------------------------------------------------------------ */
+/* DMA1/DMA2 (RM0386 section 9): two controllers, eight streams each.  */
+/* ------------------------------------------------------------------ */
+/*
+ * Registers, flags and interrupts as the manual has them. A memory-to-
+ * memory stream (DIR = 10) runs to completion the moment it is enabled.
+ * A peripheral stream is armed and named once; nothing yet issues the
+ * peripheral's requests, so it waits -- which says which peripheral the
+ * image drives by DMA, the next thing to connect.
+ */
+typedef struct Z63Stm32Dma Z63Stm32Dma;
+
+static const hwaddr z63_stm32_dma_base[2] = { 0x40026000, 0x40026400 };
+static const int z63_stm32_dma_irqn[2][8] = {
+    { 11, 12, 13, 14, 15, 16, 17, 47 },
+    { 56, 57, 58, 59, 60, 68, 69, 70 },
+};
+
+/* Stream n's four flag bits sit at these positions in LISR/HISR. */
+static unsigned z63_stm32_dma_shift(unsigned n)
+{
+    static const unsigned shift[4] = { 0, 6, 16, 22 };
+
+    return shift[n & 3];
+}
+
+static void z63_stm32_dma_irq(Z63Stm32Dma *d, unsigned n)
+{
+    uint32_t flags = (d->isr[n >> 2] >> z63_stm32_dma_shift(n)) & 0x3d;
+    uint32_t cr = d->s[n].cr;
+    bool level = ((flags & (1u << 5)) && (cr & (1u << 4))) ||   /* TCIF  TCIE */
+                 ((flags & (1u << 4)) && (cr & (1u << 3))) ||   /* HTIF  HTIE */
+                 ((flags & (1u << 3)) && (cr & (1u << 2))) ||   /* TEIF  TEIE */
+                 ((flags & (1u << 2)) && (cr & (1u << 1)));     /* DMEIF DMEIE */
+
+    qemu_set_irq(d->s[n].irq, level);
+}
+
+static void z63_stm32_dma_m2m(Z63Stm32Dma *d, unsigned n)
+{
+    AddressSpace *as = cpu_get_address_space(CPU(d->mcu->armv7m.cpu), 0);
+    unsigned psize = 1u << ((d->s[n].cr >> 11) & 3);
+    uint32_t count = d->s[n].ndtr & 0xffff;
+    g_autofree uint8_t *buf = g_malloc(count * psize ? count * psize : 1);
+
+    if (count) {
+        address_space_read(as, d->s[n].par, MEMTXATTRS_UNSPECIFIED, buf,
+                           count * psize);
+        address_space_write(as, d->s[n].m0ar, MEMTXATTRS_UNSPECIFIED, buf,
+                            count * psize);
+    }
+    d->s[n].ndtr = 0;
+    d->s[n].cr &= ~1u;
+    d->isr[n >> 2] |= (1u << 5 | 1u << 4) << z63_stm32_dma_shift(n);
+    z63_stm32_dma_irq(d, n);
+}
+
+/* One item between a peripheral and memory for stream n of controller d.
+ * Peripheral and memory widths must match (the image's do); a mismatch
+ * stops, as an unmodelled packing mode. */
+static bool z63_stm32_dma_item(Z63Stm32Dma *d, unsigned n, bool to_periph,
+                               uint32_t *value)
+{
+    AddressSpace *as = cpu_get_address_space(CPU(d->mcu->armv7m.cpu), 0);
+    uint32_t cr = d->s[n].cr;
+    unsigned psize = 1u << ((cr >> 11) & 3), msize = 1u << ((cr >> 13) & 3);
+    uint8_t buf[4] = { 0 };
+
+    if (psize != msize) {
+        z63_stm32_stop("DMA packing", z63_stm32_dma_base[d->ctrl] + 0x10 +
+                       0x18 * n, 4, true, cr);
+        return false;
+    }
+    if (to_periph) {
+        address_space_read(as, d->s[n].cur_m, MEMTXATTRS_UNSPECIFIED, buf,
+                           msize);
+        *value = ldl_le_p(buf) & (msize == 4 ? 0xffffffff
+                                             : (1u << (8 * msize)) - 1);
+    } else {
+        stl_le_p(buf, *value);
+        address_space_write(as, d->s[n].cur_m, MEMTXATTRS_UNSPECIFIED, buf,
+                            msize);
+    }
+    if (cr & (1u << 10)) {                          /* MINC */
+        d->s[n].cur_m += msize;
+    }
+    if (cr & (1u << 9)) {                           /* PINC */
+        d->s[n].cur_p += psize;
+    }
+    d->s[n].ndtr--;
+    if (d->s[n].ndtr == d->s[n].ndtr_init / 2) {
+        d->isr[n >> 2] |= (1u << 4) << z63_stm32_dma_shift(n);   /* HTIF */
+    }
+    if (d->s[n].ndtr == 0) {
+        d->isr[n >> 2] |= (1u << 5) << z63_stm32_dma_shift(n);   /* TCIF */
+        if (cr & (1u << 8)) {                       /* CIRC: reload */
+            d->s[n].ndtr = d->s[n].ndtr_init;
+            d->s[n].cur_m = d->s[n].m0ar;
+            d->s[n].cur_p = d->s[n].par;
+        } else {
+            d->s[n].cr &= ~1u;
+        }
+    }
+    z63_stm32_dma_irq(d, n);
+    return true;
+}
+
+static bool z63_stm32_dma_serve(Z63Stm32 *m, uint32_t par, bool to_periph,
+                                uint32_t *value)
+{
+    for (unsigned c = 0; c < 2; c++) {
+        for (unsigned n = 0; n < 8; n++) {
+            uint32_t cr = m->dma[c].s[n].cr;
+            unsigned dir = (cr >> 6) & 3;
+
+            if ((cr & 1) && m->dma[c].s[n].par == par && m->dma[c].s[n].ndtr &&
+                dir == (to_periph ? 1 : 0)) {
+                return z63_stm32_dma_item(&m->dma[c], n, to_periph, value);
+            }
+        }
+    }
+    return false;
+}
+
+
+static bool z63_stm32_dma_tx(Z63Stm32 *m, uint32_t par, uint32_t *value)
+{
+    return z63_stm32_dma_serve(m, par, true, value);
+}
+
+/* How wide the items of the stream armed on this register are, in bytes
+ * (0 = nothing armed that way). The link needs it because the two chips
+ * count differently: the EXPEED clocks 16-bit words, an 8-bit SPI on this
+ * side moves one byte per frame, and the firmware's stream is sized for
+ * the latter. */
+static unsigned z63_stm32_dma_item_bytes(Z63Stm32 *m, uint32_t par,
+                                         bool to_periph)
+{
+    for (unsigned c = 0; c < 2; c++) {
+        for (unsigned n = 0; n < 8; n++) {
+            uint32_t cr = m->dma[c].s[n].cr;
+
+            if ((cr & 1) && m->dma[c].s[n].par == par &&
+                m->dma[c].s[n].ndtr &&
+                ((cr >> 6) & 3) == (to_periph ? 1 : 0)) {
+                return 1u << ((cr >> 11) & 3);
+            }
+        }
+    }
+    return 0;
+}
+
+static bool z63_stm32_dma_rx(Z63Stm32 *m, uint32_t par, uint32_t value)
+{
+    return z63_stm32_dma_serve(m, par, false, &value);
+}
+
+/* A stream was enabled: a peripheral may already be requesting. */
+static void z63_stm32_dma_kick(Z63Stm32 *m)
+{
+    for (unsigned i = 0; i < 3; i++) {
+        z63_stm32_i2c_pump(&m->i2c[i]);
+    }
+    z63_stm32_fmpi2c_step(m);
+    z63_stm32_fmpi2c_irq(m);
+    /* And whatever the board has wired to a stream -- the SPI-to-serial
+     * link, if mcu-spi-peer= bridged one. See z63_stm32_dma_item_bytes(). */
+    if (m->link_kick) {
+        m->link_kick(m->link_kick_opaque);
+    }
+}
+
+static uint64_t z63_stm32_dma_read(void *opaque, hwaddr off, unsigned size)
+{
+    Z63Stm32Dma *d = opaque;
+    unsigned n, reg;
+
+    if (size != 4) {
+        goto bad;
+    }
+    if (off < 0x10) {
+        return off < 0x08 ? d->isr[off / 4] : 0;        /* IFCRs read 0 */
+    }
+    if (off >= 0xd0) {
+        goto bad;
+    }
+    n = (off - 0x10) / 0x18;
+    reg = (off - 0x10) % 0x18;
+    switch (reg) {
+    case 0x00: return d->s[n].cr;
+    case 0x04: return d->s[n].ndtr;
+    case 0x08: return d->s[n].par;
+    case 0x0c: return d->s[n].m0ar;
+    case 0x10: return d->s[n].m1ar;
+    case 0x14: return d->s[n].fcr | 0x20;               /* FEMPTY-ish FS=100 */
+    }
+bad:
+    z63_stm32_stop("DMA", z63_stm32_dma_base[d->ctrl] + off, size, false, 0);
+    return 0;
+}
+
+static void z63_stm32_dma_write(void *opaque, hwaddr off, uint64_t value,
+                                unsigned size)
+{
+    Z63Stm32Dma *d = opaque;
+    unsigned n, reg;
+
+    if (size != 4) {
+        goto bad;
+    }
+    if (off < 0x10) {
+        if (off >= 0x08) {                              /* LIFCR/HIFCR */
+            d->isr[(off - 0x08) / 4] &= ~(value & 0x0f7d0f7d);
+            for (n = 0; n < 8; n++) {
+                z63_stm32_dma_irq(d, n);
+            }
+            return;
+        }
+        goto bad;                                       /* ISRs are RO */
+    }
+    if (off >= 0xd0) {
+        goto bad;
+    }
+    n = (off - 0x10) / 0x18;
+    reg = (off - 0x10) % 0x18;
+    switch (reg) {
+    case 0x00: {
+        bool was_on = d->s[n].cr & 1;
+
+        d->s[n].cr = value;
+        if ((value & 1) && !was_on) {
+            unsigned dir = (value >> 6) & 3;
+
+            d->s[n].cur_m = (value & (1u << 19)) ? d->s[n].m1ar : d->s[n].m0ar;
+            d->s[n].cur_p = d->s[n].par;
+            d->s[n].ndtr_init = d->s[n].ndtr;
+            if (dir == 2) {
+                z63_stm32_dma_m2m(d, n);
+            } else if (!d->s[n].named) {
+                d->s[n].named = true;
+                error_report("Z63_STM32: DMA%u stream %u armed: channel %u, "
+                             "%s, peripheral 0x%08x, memory 0x%08x, %u items "
+                             "(pc=0x%08x)",
+                             d->ctrl + 1, n, (unsigned)(value >> 25) & 7,
+                             dir == 1 ? "memory->peripheral"
+                                      : "peripheral->memory",
+                             d->s[n].par, d->s[n].m0ar, d->s[n].ndtr & 0xffff,
+                             z63_stm32_pc());
+            }
+            if (dir != 2) {
+                z63_stm32_dma_irq(d, n);
+                z63_stm32_dma_kick(d->mcu);     /* a request may be pending */
+                return;
+            }
+        }
+        z63_stm32_dma_irq(d, n);
+        return;
+    }
+    case 0x04: d->s[n].ndtr = value & 0xffff; return;
+    case 0x08: d->s[n].par = value; return;
+    case 0x0c: d->s[n].m0ar = value; return;
+    case 0x10: d->s[n].m1ar = value; return;
+    case 0x14: d->s[n].fcr = value & 0x87; return;
+    }
+bad:
+    z63_stm32_stop("DMA", z63_stm32_dma_base[d->ctrl] + off, size, true,
+                   value);
+}
+
+static const MemoryRegionOps z63_stm32_dma_ops = {
+    .read = z63_stm32_dma_read,
+    .write = z63_stm32_dma_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void z63_stm32_dma_reset(Z63Stm32Dma *d)
+{
+    d->isr[0] = d->isr[1] = 0;
+    for (unsigned n = 0; n < 8; n++) {
+        d->s[n].cr = d->s[n].ndtr = d->s[n].par = 0;
+        d->s[n].m0ar = d->s[n].m1ar = 0;
+        d->s[n].fcr = 0x21;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* ADC1..3 and the common block (RM0386 section 13).                   */
+/* ------------------------------------------------------------------ */
+/*
+ * Software-started conversions only. A regular conversion converts the
+ * first channel of the sequence (SQR3[4:0]) into DR; an injected one fills
+ * JDR1..4 from JSQR. The level of every channel is a declared input,
+ * mid-scale (0x800 of 12 bits) unless set -- not a measured voltage. DMA
+ * and scan of a longer sequence are named once and not modelled.
+ */
+#define Z63_STM32_ADC_BASE 0x40012000ULL
+#define Z63_ADC_SR    0x00
+#define Z63_ADC_CR1   0x04
+#define Z63_ADC_CR2   0x08
+#define Z63_ADC_SQR3  0x34
+#define Z63_ADC_JSQR  0x38
+#define Z63_ADC_DR    0x4c
+
+static void z63_stm32_adc_irq(Z63Stm32 *m)
+{
+    bool level = false;
+
+    for (unsigned i = 0; i < 3; i++) {
+        uint32_t sr = m->adc.r[i][Z63_ADC_SR / 4];
+        uint32_t cr1 = m->adc.r[i][Z63_ADC_CR1 / 4];
+
+        level |= ((sr & 2) && (cr1 & (1u << 5))) ||     /* EOC  EOCIE */
+                 ((sr & 4) && (cr1 & (1u << 7)));       /* JEOC JEOCIE */
+    }
+    qemu_set_irq(m->adc.irq, level);
+}
+
+static uint64_t z63_stm32_adc_read(void *opaque, hwaddr off, unsigned size)
+{
+    Z63Stm32 *m = opaque;
+    unsigned i = off / 0x100, reg = off % 0x100;
+
+    if (size != 4) {
+        goto bad;
+    }
+    if (off == 0x300) {                 /* CSR: the three SRs side by side */
+        return (m->adc.r[0][0] & 0x3f) | (m->adc.r[1][0] & 0x3f) << 8 |
+               (m->adc.r[2][0] & 0x3f) << 16;
+    }
+    if (off == 0x304) {
+        return m->adc.ccr;
+    }
+    if (i < 3 && reg <= Z63_ADC_DR) {
+        uint32_t v = m->adc.r[i][reg / 4];
+
+        if (reg == Z63_ADC_DR) {
+            m->adc.r[i][Z63_ADC_SR / 4] &= ~2u;         /* reading DR: EOC */
+            z63_stm32_adc_irq(m);
+        }
+        return v;
+    }
+bad:
+    z63_stm32_stop("ADC", Z63_STM32_ADC_BASE + off, size, false, 0);
+    return 0;
+}
+
+static void z63_stm32_adc_write(void *opaque, hwaddr off, uint64_t value,
+                                unsigned size)
+{
+    Z63Stm32 *m = opaque;
+    unsigned i = off / 0x100, reg = off % 0x100;
+    uint32_t *r;
+
+    if (size != 4) {
+        goto bad;
+    }
+    if (off == 0x304) {
+        m->adc.ccr = value;
+        return;
+    }
+    if (i >= 3 || reg > Z63_ADC_DR || reg == Z63_ADC_DR ||
+        (reg >= 0x3c && reg <= 0x48)) {             /* JDRx, DR: read-only */
+        goto bad;
+    }
+    r = m->adc.r[i];
+    if (reg == Z63_ADC_SR) {                        /* rc_w0 */
+        r[0] &= value | ~0x1fu;
+        z63_stm32_adc_irq(m);
+        return;
+    }
+    r[reg / 4] = value & ~((1u << 30) | (1u << 22));    /* SWSTART JSWSTART */
+    if (reg == Z63_ADC_CR2 && (value & 1)) {
+        if ((value & (1u << 8)) && !m->adc.dma_named) {
+            m->adc.dma_named = true;
+            error_report("Z63_STM32: ADC%u in DMA mode (pc=0x%08x) -- not "
+                         "modelled", i + 1, z63_stm32_pc());
+        }
+        if (value & (1u << 30)) {                   /* regular conversion */
+            unsigned ch = r[Z63_ADC_SQR3 / 4] & 0x1f;
+
+            r[Z63_ADC_DR / 4] = ch < 19 ? m->adc.input[i][ch] : 0;
+            r[0] |= 2 | (1u << 4);                  /* EOC STRT */
+        }
+        if (value & (1u << 22)) {                   /* injected conversion */
+            uint32_t jsqr = r[Z63_ADC_JSQR / 4];
+            unsigned n = ((jsqr >> 20) & 3) + 1;
+
+            for (unsigned k = 0; k < n; k++) {
+                unsigned ch = (jsqr >> (5 * (4 - n + k))) & 0x1f;
+
+                r[(0x3c + 4 * k) / 4] = ch < 19 ? m->adc.input[i][ch] : 0;
+            }
+            r[0] |= 4 | (1u << 3);                  /* JEOC JSTRT */
+        }
+    }
+    z63_stm32_adc_irq(m);
+    return;
+bad:
+    z63_stm32_stop("ADC", Z63_STM32_ADC_BASE + off, size, true, value);
+}
+
+static const MemoryRegionOps z63_stm32_adc_ops = {
+    .read = z63_stm32_adc_read,
+    .write = z63_stm32_adc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+/* ------------------------------------------------------------------ */
+/* Assembly.                                                           */
+/* ------------------------------------------------------------------ */
+
+static void z63_stm32_reset(void *opaque)
+{
+    Z63Stm32 *m = opaque;
+
+    z63_stm32_rcc_reset(m);
+    z63_stm32_rtc_reset(m);
+    m->pwr_cr = 0x0000c000;             /* VOS scale 1 */
+    m->pwr_csr = 0;
+    m->flash_acr = 0;
+    m->flash_sr = 0;
+    m->flash_cr = 1u << 31;             /* LOCK */
+    m->flash_optcr = 0x0fffaaed;
+    m->flash_optcr1 = 0x0fff0000;
+    m->flash_key = 0;
+    for (unsigned i = 0; i < Z63_STM32_GPIO_PORTS; i++) {
+        z63_stm32_gpio_reset(&m->gpio[i]);
+    }
+    for (unsigned i = 0; i < 3; i++) {
+        z63_stm32_i2c_reset(&m->i2c[i]);
+    }
+    memset(m->syscfg, 0, sizeof(m->syscfg));
+    memset(m->adc.r, 0, sizeof(m->adc.r));
+    m->adc.ccr = 0;
+    z63_stm32_dma_reset(&m->dma[0]);
+    z63_stm32_dma_reset(&m->dma[1]);
+    m->fmpi2c.cr1 = m->fmpi2c.cr2 = m->fmpi2c.oar1 = m->fmpi2c.oar2 = 0;
+    m->fmpi2c.timingr = m->fmpi2c.timeoutr = 0;
+    m->fmpi2c.isr = Z63_FMP_ISR_TXE;
+}
+
+static void z63_stm32_map(Z63Stm32 *m, MemoryRegion *mr, Object *owner,
+                        const MemoryRegionOps *ops, void *opaque,
+                        const char *name, hwaddr base, uint64_t size)
+{
+    memory_region_init_io(mr, owner, ops, opaque, name, size);
+    memory_region_add_subregion(&m->mem, base, mr);
+}
