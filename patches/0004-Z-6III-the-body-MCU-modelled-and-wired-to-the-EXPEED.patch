diff --git a/z63-tools/snor_user_clear_error.py b/z63-tools/snor_user_clear_error.py
new file mode 100755
index 0000000..87331a4
--- /dev/null
+++ b/z63-tools/snor_user_clear_error.py
@@ -0,0 +1,45 @@
+#!/usr/bin/env python3
+"""Write a copy of a SNOR_USER body with its saved camera error cleared.
+
+The body z63-tools/snor_user_extract.py produces is the camera's own
+per-unit NOR data, and it can carry a fault the camera recorded before it
+was dumped. The one this was written for holds, in each of its three
+redundant copies, the settings record
+
+    4d 00 00 00  04 00 00 00  00 00 3a 06      id 0x4d, 4 bytes
+
+whose bytes are data items 0x4a00..0x4a03. At boot the camera controller
+(sub_40F29110, 0x40f2cfec) reads item 0x4a02 and, when it is nonzero, posts
+it as an active error (sub_40F35AD4 -> sub_40EB1414): 0x3a here, which the
+GUI shows as Err ("Error. Press shutter-release button to reset.", string
+3103, caution 0xbe). The error history (record 0x4f, right after it) keeps
+the same timestamp.
+
+This writes a NEW file with items 0x4a02/0x4a03 zeroed in every copy of
+that record -- what the body would hold had the error been cleared. It is a
+declared edit of the input, not a model: the original file is never
+touched, and nothing else in the body changes. Use it only to look past the
+Err dialog; with the original body the machine shows what the camera would.
+
+    snor_user_clear_error.py <snor_user.bin> <out.bin>
+"""
+import sys
+
+src, dst = sys.argv[1:3]
+if src == dst:
+    sys.exit("refusing to overwrite the input; give a different output path")
+data = bytearray(open(src, "rb").read())
+head = bytes.fromhex("4d000000" "04000000")
+n = 0
+i = data.find(head)
+while i >= 0:
+    if data[i + 10] or data[i + 11]:
+        print("record at %#x: items 0x4a00..03 = %s -> cleared 0x4a02/03"
+              % (i, data[i + 8:i + 12].hex(" ")))
+        data[i + 10] = data[i + 11] = 0
+        n += 1
+    i = data.find(head, i + 1)
+if not n:
+    sys.exit("no saved error record found; nothing written")
+open(dst, "wb").write(data)
+print("wrote %s (%d record(s) cleared)" % (dst, n))
diff --git a/z63-tools/tasks.py b/z63-tools/tasks.py
new file mode 100755
index 0000000..1c3e94a
--- /dev/null
+++ b/z63-tools/tasks.py
@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+"""Dump the RTOS's task table from a running machine: name, state, wait object.
+
+EXPEED 7's RTOS is SOLID-OS on a TOPPERS/FMP 1.4.0 kernel, so its task
+control blocks have a documented shape. On this image the TCB array is at
+0xa04cf8078 with a 0x80 stride. Each TCB holds its queue link at +0x00/+0x08
+(so +0x08 names the wait queue -- the object, or the waiter ahead of it),
+p_tinib at +0x10, and tstat in the low byte of +0x18.
+
+The TINIB's exinf (+0x08) is a pointer to SOLID's own per-task object, not
+the name itself. That object is
+
+    +0x00  u64   task ID (TCB index + 2)
+    +0x08  u64   entry point
+    +0x10  u32   priority
+    +0x14  u32   stack size
+    +0x18  u32   core
+    +0x1d  char  name, NUL-terminated
+
+measured, not assumed: for TCB 12 exinf is 0xa02fadbf0, ID 0x0e, entry
+0x402df860 and name TFTDIR -- the object and body docs/register-windows.md
+traced by other means. Reading exinf's target at +0 as text is what gave an
+earlier version of this script a column of ASCII in order: that is the ID.
+
+This answers "which task is blocked, and on what" directly, which is the
+question a block count only approximates.
+
+    tasks.py <qmp socket> [--tcb 0xa04cf8078] [--stride 0x80] [--count 256]
+"""
+import json, socket, struct, sys, tempfile, os
+
+args = sys.argv[1:]
+def opt(name, default):
+    return args[args.index(name) + 1] if name in args else default
+sock_path = args[0]
+TCB = int(opt('--tcb', '0xa04cf8078'), 0)
+STRIDE = int(opt('--stride', '0x80'), 0)
+COUNT = int(opt('--count', '256'), 0)
+
+s = socket.socket(socket.AF_UNIX); s.connect(sock_path)
+f = s.makefile('rw', encoding='utf-8', newline='\n')
+f.readline()
+f.write(json.dumps({"execute": "qmp_capabilities"}) + "\n"); f.flush(); f.readline()
+
+def cmd(ex, **a):
+    f.write(json.dumps({"execute": ex, "arguments": a}) + "\n"); f.flush()
+    while True:
+        line = f.readline()
+        if not line:
+            raise SystemExit("qmp closed")
+        d = json.loads(line)
+        if 'return' in d: return d['return']
+        if 'error' in d: raise SystemExit("qmp error: %s" % d['error'])
+
+tmp = tempfile.mktemp(suffix='.bin')
+def read(pa, n):
+    cmd("pmemsave", val=pa, size=n, filename=tmp)
+    with open(tmp, 'rb') as fh:
+        return fh.read()
+
+def cstr(pa, n=24):
+    try:
+        b = read(pa, n)
+    except SystemExit:
+        return ''
+    b = b.split(b'\0')[0]
+    return b.decode('latin1') if all(32 <= c < 127 for c in b) else ''
+
+blob = read(TCB, STRIDE * COUNT)
+print("%-4s %-10s %-5s %-4s %-4s %-12s %-14s %s" %
+      ("#", "name", "tstat", "pri", "core", "entry", "wait queue", "tcb"))
+live = 0
+for i in range(COUNT):
+    rec = blob[i * STRIDE: (i + 1) * STRIDE]
+    if len(rec) < 0x20 or not any(rec):
+        continue
+    wait, tinib, st = struct.unpack_from('<QQQ', rec, 8)
+    if not (0xa00000000 <= tinib < 0xa40000000):
+        continue
+    exinf = struct.unpack_from('<Q', read(tinib + 8, 8), 0)[0]
+    if not (0xa00000000 <= exinf < 0xa40000000):
+        continue
+    obj = read(exinf, 0x28)
+    tid, entry, pri, _stk, core = struct.unpack_from('<QQIII', obj, 0)
+    if tid != i + 2:
+        continue          # not SOLID's task object; do not guess a name
+    name = obj[0x1d:].split(b'\0')[0]
+    name = name.decode('latin1') if name and all(32 <= c < 127 for c in name) else ''
+    live += 1
+    print("%-4d %-10s 0x%02x  %-4d %-4d 0x%08x  0x%011x  0x%011x" %
+          (i, name or '?', st & 0xff, pri, core, entry, wait, TCB + i * STRIDE))
+print("\n%d tasks" % live)
+try:
+    os.unlink(tmp)
+except OSError:
+    pass
diff --git a/z63-tools/z9lab_attach.c.in b/z63-tools/z9lab_attach.c.in
new file mode 100644
index 0000000..3fad5de
--- /dev/null
+++ b/z63-tools/z9lab_attach.c.in
@@ -0,0 +1,199 @@
+
+/* ------------------------------------------------------------------ */
+/* Nikon Z 6III attachment (appended by z63-tools/import_z9lab.py).    */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Everything above is ../z9-qemu's board. This replaces its machine init for
+ * use inside nikon-z63, which owns the CPUs, the GIC, RAM and every mapping:
+ * here there is only the object, its switches, and the capture interrupts
+ * and timers, on the board's GIC. The INTIDs are the Z 9 model's; each was
+ * checked against this image's own interrupt-name table
+ * (hw/arm/nikon-z63-spi.h) and none is driven by anything else on the board:
+ *
+ *   0x106 PPC_0   engine150c          0xf9/0xf8 FRECT/FRECT_LV  engine1518
+ *   0x10d MIPU    engine151[0]        0x10e MIPU_LV  engine151[1]
+ *   0x6a  RSZ     engine1542 (RAW pipeline output)
+ *   0xfe/0xff/0x101/0x102/0x104 SIF_0/1/3/4/6  the 0x1508 event block
+ *   0x134 MVD     engine1524 MVD
+ *
+ * Switches the Z 9 profile has that belong to blocks this board models
+ * itself are refused: the display (engine1548-*), graphics, NOR, NAND,
+ * serial, I2C, ADC, bus windows, timers, the low service RAM/controller,
+ * the 0x13807d00 control block (nikon-z63.c's 0x138xxxxx window), and the
+ * CPU-patch event model.
+ */
+static const char *const z63_z9lab_refused[] = {
+    "service-core-event-model", "nor-model", "nand-fixture",
+    "serial-fixture", "i2c-fixture", "bus-window-fixture",
+    "pcie-empty-fixture", "adc-fixture", "adc-input",
+    "graphics-image-model", "graphics-path-model", "graphics-clear-model",
+    "engine1548-config-model", "engine1548-control-model",
+    "engine1548-scanout-model", "orientation-fixture",
+    "multi-io-counter-model", "low-service-ram-model",
+    "low-service-status-input", "service-controller-model",
+    "service-controller-status-input", "service-cluster-inputs",
+    "control1380-model", "control1380-busy-input",
+};
+
+/*
+ * The frame-boundary peer. ../z9-qemu's run loop (tools/run.py with
+ * tools/z9_global1_boundary_input.py, Peer.tick) sets the 0x1508 block's
+ * global1 status bit 0x80 every 33 ms of virtual time from the moment the
+ * machine runs, and with auxiliary_masked the aux0 bits the firmware has
+ * unmasked (aux0 mask word +0x10c, bits 0..1) -- an external frame boundary
+ * standing in for the sensor's, delivered whether or not the firmware has
+ * asked for anything. That is done here by a timer instead of over QMP, with
+ * the same period and the same two inputs; "z63-boundary-ms=0" turns it off.
+ * The period is that tool's choice, not a measured sensor timing.
+ */
+typedef struct Z63Z9Boundary {
+    NikonZ9State *s;
+    QEMUTimer *timer;
+    int64_t period_ns;
+    uint64_t deliveries, aux_deliveries;
+} Z63Z9Boundary;
+
+static void z63_z9lab_boundary_tick(void *opaque)
+{
+    Z63Z9Boundary *b = opaque;
+    NikonZ9State *s = b->s;
+    unsigned mask = s->event_capture_config_1508[0][0x10c / 4] & 3;
+
+    s->event_global1_pending |= 0x80;
+    s->event_global1_inputs++;
+    event_global1_update_irq(s);
+    if (s->event1508_aux_model && mask) {
+        s->event_aux0_pending |= mask;
+        s->event_aux0_inputs++;
+        event_aux0_update_irq(s);
+        b->aux_deliveries++;
+    }
+    b->deliveries++;
+    timer_mod(b->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + b->period_ns);
+}
+
+Object *z63_z9lab_new(Object *owner, DeviceState *gic, uint64_t ram_size,
+                      const char *props, Error **errp);
+bool z63_z9lab_read(Object *obj, hwaddr addr, unsigned size,
+                    uint64_t *value);
+bool z63_z9lab_write(Object *obj, hwaddr addr, uint64_t value,
+                     unsigned size);
+uint64_t z63_z9lab_misses(Object *obj);
+
+/* props: "name=value" items separated by ';'. */
+Object *z63_z9lab_new(Object *owner, DeviceState *gic, uint64_t ram_size,
+                      const char *props, Error **errp)
+{
+    NikonZ9State *s = NIKON_Z9_LAB(object_new(TYPE_NIKON_Z9_LAB));
+    g_auto(GStrv) items = g_strsplit(props ? props : "", ";", -1);
+    uint64_t boundary_ms = 0;
+
+    s->compat = true;
+    s->ram_size = ram_size;
+    for (char **item = items; *item; item++) {
+        g_auto(GStrv) kv = g_strsplit(g_strstrip(*item), "=", 2);
+
+        if (!kv[0] || !*kv[0]) {
+            continue;
+        }
+        if (!kv[1]) {
+            error_setg(errp, "z9-capture: '%s' is not name=value", *item);
+            goto fail;
+        }
+        if (!strcmp(kv[0], "z63-boundary-ms")) {
+            if (qemu_strtou64(kv[1], NULL, 0, &boundary_ms) ||
+                boundary_ms > 1000 || (boundary_ms && boundary_ms < 10)) {
+                error_setg(errp, "z9-capture: z63-boundary-ms wants 0 or "
+                           "10..1000");
+                goto fail;
+            }
+            continue;
+        }
+        for (unsigned i = 0; i < ARRAY_SIZE(z63_z9lab_refused); i++) {
+            if (!strcmp(kv[0], z63_z9lab_refused[i])) {
+                error_setg(errp, "z9-capture: '%s' belongs to a block the "
+                           "Z 6III board models itself", kv[0]);
+                goto fail;
+            }
+        }
+        if (!object_property_parse(OBJECT(s), kv[0], kv[1], errp)) {
+            goto fail;
+        }
+    }
+
+    s->engine150c_irq = qdev_get_gpio_in(gic, 0x106 - 32);
+    if (s->engine1524_mvd_model) {
+        s->engine1524_irq = qdev_get_gpio_in(gic, ENGINE1524_INTID - 32);
+    }
+    s->engine1518[0].irq = qdev_get_gpio_in(gic, 0xf9 - 32);
+    s->engine1518[2].irq = qdev_get_gpio_in(gic, 0xf8 - 32);
+    s->engine151_irq[0] = qdev_get_gpio_in(gic, 0x10d - 32);
+    s->engine151_irq[1] = qdev_get_gpio_in(gic, 0x10e - 32);
+    if (s->primary_empty_end_model) {
+        s->primary_empty_end_timer =
+            timer_new_ns(QEMU_CLOCK_VIRTUAL, primary_empty_end_tick, s);
+    }
+    if (s->statistics_model) {
+        statistics_load(s);
+    }
+    s->engine1542_irq = qdev_get_gpio_in(gic, 0x6a - 32);
+    if (s->raw_pipeline_model) {
+        s->raw_pipeline_timer =
+            timer_new_ns(QEMU_CLOCK_VIRTUAL, raw_pipeline_tick, s);
+        timer_mod(s->raw_pipeline_timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 33333333);
+    }
+    s->event_aux0_irq = qdev_get_gpio_in(gic, 0x102 - 32);
+    s->event_aux1_irq = qdev_get_gpio_in(gic, 0x104 - 32);
+    s->event_channel_irq = qdev_get_gpio_in(gic, 0xfe - 32);
+    s->event_global1_irq = qdev_get_gpio_in(gic, 0x101 - 32);
+    s->event_global0_irq = qdev_get_gpio_in(gic, 0xff - 32);
+    s->event_timing_timer =
+        timer_new_ns(QEMU_CLOCK_VIRTUAL, event_timing_expire, s);
+    if (boundary_ms) {
+        Z63Z9Boundary *b = g_new0(Z63Z9Boundary, 1);
+
+        if (!s->event1508_global1_model || !s->bootstrap_fixtures) {
+            error_setg(errp, "z9-capture: z63-boundary-ms needs "
+                       "event1508-global1-model and bootstrap-fixtures");
+            g_free(b);
+            goto fail;
+        }
+        b->s = s;
+        b->period_ns = boundary_ms * 1000000;
+        b->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, z63_z9lab_boundary_tick, b);
+        timer_mod(b->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    }
+
+    object_property_add_child(owner, "z9lab", OBJECT(s));
+    object_unref(OBJECT(s));
+    return OBJECT(s);
+
+fail:
+    object_unref(OBJECT(s));
+    return NULL;
+}
+
+bool z63_z9lab_read(Object *obj, hwaddr addr, unsigned size, uint64_t *value)
+{
+    NikonZ9State *s = NIKON_Z9_LAB(obj);
+
+    s->compat_miss = false;
+    *value = unknown_read(s, addr, size);
+    return !s->compat_miss;
+}
+
+bool z63_z9lab_write(Object *obj, hwaddr addr, uint64_t value, unsigned size)
+{
+    NikonZ9State *s = NIKON_Z9_LAB(obj);
+
+    s->compat_miss = false;
+    unknown_write(s, addr, value, size);
+    return !s->compat_miss;
+}
+
+uint64_t z63_z9lab_misses(Object *obj)
+{
+    return NIKON_Z9_LAB(obj)->compat_misses;
+}
