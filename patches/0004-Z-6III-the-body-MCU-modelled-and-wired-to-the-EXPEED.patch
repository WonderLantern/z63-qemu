+/* ------------------------------------------------------------------ */
+/* Nikon Z 6III attachment (appended by z63-tools/import_z9lab.py).    */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Everything above is ../z9-qemu's board. This replaces its machine init for
+ * use inside nikon-z63, which owns the CPUs, the GIC, RAM and every mapping:
+ * here there is only the object, its switches, and the capture interrupts
+ * and timers, on the board's GIC. The INTIDs are the Z 9 model's; each was
+ * checked against this image's own interrupt-name table
+ * (hw/arm/nikon-z63-spi.h) and none is driven by anything else on the board:
+ *
+ *   0x106 PPC_0   engine150c          0xf9/0xf8 FRECT/FRECT_LV  engine1518
+ *   0x10d MIPU    engine151[0]        0x10e MIPU_LV  engine151[1]
+ *   0x6a  RSZ     engine1542 (RAW pipeline output)
+ *   0xfe/0xff/0x101/0x102/0x104 SIF_0/1/3/4/6  the 0x1508 event block
+ *   0x134 MVD     engine1524 MVD
+ *
+ * Switches the Z 9 profile has that belong to blocks this board models
+ * itself are refused: the display (engine1548-*), graphics, NOR, NAND,
+ * serial, I2C, ADC, bus windows, timers, the low service RAM/controller,
+ * the 0x13807d00 control block (nikon-z63.c's 0x138xxxxx window), and the
+ * CPU-patch event model.
+ */
+static const char *const z63_z9lab_refused[] = {
+    "service-core-event-model", "nor-model", "nand-fixture",
+    "serial-fixture", "i2c-fixture", "bus-window-fixture",
+    "pcie-empty-fixture", "adc-fixture", "adc-input",
+    "graphics-image-model", "graphics-path-model", "graphics-clear-model",
+    "engine1548-config-model", "engine1548-control-model",
+    "engine1548-scanout-model", "orientation-fixture",
+    "multi-io-counter-model", "low-service-ram-model",
+    "low-service-status-input", "service-controller-model",
+    "service-controller-status-input", "service-cluster-inputs",
+    "control1380-model", "control1380-busy-input",
+};
+
+/*
+ * The frame-boundary peer. ../z9-qemu's run loop (tools/run.py with
+ * tools/z9_global1_boundary_input.py, Peer.tick) sets the 0x1508 block's
+ * global1 status bit 0x80 every 33 ms of virtual time from the moment the
+ * machine runs, and with auxiliary_masked the aux0 bits the firmware has
+ * unmasked (aux0 mask word +0x10c, bits 0..1) -- an external frame boundary
+ * standing in for the sensor's, delivered whether or not the firmware has
+ * asked for anything. That is done here by a timer instead of over QMP, with
+ * the same period and the same two inputs; "z63-boundary-ms=0" turns it off.
+ * The period is that tool's choice, not a measured sensor timing.
+ */
+typedef struct Z63Z9Boundary {
+    NikonZ9State *s;
+    QEMUTimer *timer;
+    int64_t period_ns;
+    uint64_t deliveries, aux_deliveries;
+} Z63Z9Boundary;
+
+static void z63_z9lab_boundary_tick(void *opaque)
+{
+    Z63Z9Boundary *b = opaque;
+    NikonZ9State *s = b->s;
+    unsigned mask = s->event_capture_config_1508[0][0x10c / 4] & 3;
+
+    s->event_global1_pending |= 0x80;
+    s->event_global1_inputs++;
+    event_global1_update_irq(s);
+    if (s->event1508_aux_model && mask) {
+        s->event_aux0_pending |= mask;
+        s->event_aux0_inputs++;
+        event_aux0_update_irq(s);
+        b->aux_deliveries++;
+    }
+    b->deliveries++;
+    timer_mod(b->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + b->period_ns);
+}
+
+Object *z63_z9lab_new(Object *owner, DeviceState *gic, uint64_t ram_size,
+                      const char *props, Error **errp);
+bool z63_z9lab_read(Object *obj, hwaddr addr, unsigned size,
+                    uint64_t *value);
+bool z63_z9lab_write(Object *obj, hwaddr addr, uint64_t value,
+                     unsigned size);
+uint64_t z63_z9lab_misses(Object *obj);
+
+/* props: "name=value" items separated by ';'. */
+Object *z63_z9lab_new(Object *owner, DeviceState *gic, uint64_t ram_size,
+                      const char *props, Error **errp)
+{
+    NikonZ9State *s = NIKON_Z9_LAB(object_new(TYPE_NIKON_Z9_LAB));
+    g_auto(GStrv) items = g_strsplit(props ? props : "", ";", -1);
+    uint64_t boundary_ms = 0;
+
+    s->compat = true;
+    s->ram_size = ram_size;
+    for (char **item = items; *item; item++) {
+        g_auto(GStrv) kv = g_strsplit(g_strstrip(*item), "=", 2);
+
+        if (!kv[0] || !*kv[0]) {
+            continue;
+        }
+        if (!kv[1]) {
+            error_setg(errp, "z9-capture: '%s' is not name=value", *item);
+            goto fail;
+        }
+        if (!strcmp(kv[0], "z63-boundary-ms")) {
+            if (qemu_strtou64(kv[1], NULL, 0, &boundary_ms) ||
+                boundary_ms > 1000 || (boundary_ms && boundary_ms < 10)) {
+                error_setg(errp, "z9-capture: z63-boundary-ms wants 0 or "
+                           "10..1000");
+                goto fail;
+            }
+            continue;
+        }
+        for (unsigned i = 0; i < ARRAY_SIZE(z63_z9lab_refused); i++) {
+            if (!strcmp(kv[0], z63_z9lab_refused[i])) {
+                error_setg(errp, "z9-capture: '%s' belongs to a block the "
+                           "Z 6III board models itself", kv[0]);
+                goto fail;
+            }
+        }
+        if (!object_property_parse(OBJECT(s), kv[0], kv[1], errp)) {
+            goto fail;
+        }
+    }
+
+    s->engine150c_irq = qdev_get_gpio_in(gic, 0x106 - 32);
+    if (s->engine1524_mvd_model) {
+        s->engine1524_irq = qdev_get_gpio_in(gic, ENGINE1524_INTID - 32);
+    }
+    s->engine1518[0].irq = qdev_get_gpio_in(gic, 0xf9 - 32);
+    s->engine1518[2].irq = qdev_get_gpio_in(gic, 0xf8 - 32);
+    s->engine151_irq[0] = qdev_get_gpio_in(gic, 0x10d - 32);
+    s->engine151_irq[1] = qdev_get_gpio_in(gic, 0x10e - 32);
+    if (s->primary_empty_end_model) {
+        s->primary_empty_end_timer =
+            timer_new_ns(QEMU_CLOCK_VIRTUAL, primary_empty_end_tick, s);
+    }
+    if (s->statistics_model) {
+        statistics_load(s);
+    }
+    s->engine1542_irq = qdev_get_gpio_in(gic, 0x6a - 32);
+    if (s->raw_pipeline_model) {
+        s->raw_pipeline_timer =
+            timer_new_ns(QEMU_CLOCK_VIRTUAL, raw_pipeline_tick, s);
+        timer_mod(s->raw_pipeline_timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 33333333);
+    }
+    s->event_aux0_irq = qdev_get_gpio_in(gic, 0x102 - 32);
+    s->event_aux1_irq = qdev_get_gpio_in(gic, 0x104 - 32);
+    s->event_channel_irq = qdev_get_gpio_in(gic, 0xfe - 32);
+    s->event_global1_irq = qdev_get_gpio_in(gic, 0x101 - 32);
+    s->event_global0_irq = qdev_get_gpio_in(gic, 0xff - 32);
+    s->event_timing_timer =
+        timer_new_ns(QEMU_CLOCK_VIRTUAL, event_timing_expire, s);
+    if (boundary_ms) {
+        Z63Z9Boundary *b = g_new0(Z63Z9Boundary, 1);
+
+        if (!s->event1508_global1_model || !s->bootstrap_fixtures) {
+            error_setg(errp, "z9-capture: z63-boundary-ms needs "
+                       "event1508-global1-model and bootstrap-fixtures");
+            g_free(b);
+            goto fail;
+        }
+        b->s = s;
+        b->period_ns = boundary_ms * 1000000;
+        b->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, z63_z9lab_boundary_tick, b);
+        timer_mod(b->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    }
+
+    object_property_add_child(owner, "z9lab", OBJECT(s));
+    object_unref(OBJECT(s));
+    return OBJECT(s);
+
+fail:
+    object_unref(OBJECT(s));
+    return NULL;
+}
+
+bool z63_z9lab_read(Object *obj, hwaddr addr, unsigned size, uint64_t *value)
+{
+    NikonZ9State *s = NIKON_Z9_LAB(obj);
+
+    s->compat_miss = false;
+    *value = unknown_read(s, addr, size);
+    return !s->compat_miss;
+}
+
+bool z63_z9lab_write(Object *obj, hwaddr addr, uint64_t value, unsigned size)
+{
+    NikonZ9State *s = NIKON_Z9_LAB(obj);
+
+    s->compat_miss = false;
+    unknown_write(s, addr, value, size);
+    return !s->compat_miss;
+}
+
+uint64_t z63_z9lab_misses(Object *obj)
+{
+    return NIKON_Z9_LAB(obj)->compat_misses;
+}
diff --git a/hw/arm/nikon-z63-z9lab.h b/hw/arm/nikon-z63-z9lab.h
new file mode 100644
index 0000000..07a5ef4
--- /dev/null
+++ b/hw/arm/nikon-z63-z9lab.h
@@ -0,0 +1,171 @@
+/*
+ * Nikon Z 6III -- ../z9-qemu's capture models, in front of the board's own
+ * register windows.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * hw/arm/nikon-z63-z9lab.c is ../z9-qemu's Z 9 board file (WonderLantern;
+ * GPL-2.0-or-later), carried in by z63-tools/import_z9lab.py with the edits
+ * that script lists, plus its two pixel headers (nikon-z9-pixels.h,
+ * nikon-raw-pixels.h) unchanged. The Z 9 reached its live view with those
+ * models: the sensor-interface event block at 0x15080000 with a periodic
+ * frame-boundary input, the ISP_APB configuration/submission blocks
+ * (0x194, 0x19b/0x19c, 0x19d), engines 0x150c/0x150d/0x1524 (+MVD), 0x1543,
+ * 0x151/0x152, the 0x154c stream stops, statistics, and a functional RAW ->
+ * NV12/NV16 pipeline fed from a local Bayer file.
+ *
+ * How it is attached. With -machine z9-capture=on the board creates that
+ * object with the switches below and offers it every access to a register
+ * window or to unmapped space inside the capture ranges (z63_z9lab_range).
+ * Where the Z 9 model answers, its answer is used; where it declines -- its
+ * strict "unknown access" stop, which the import turns into a miss -- the
+ * board's own window answers or stops exactly as before. Writes the model
+ * takes are still stored by the window, so a later read it declines sees
+ * them. The display (0x1548xxxx), graphics (0x1554xxxx) and every other
+ * block with its own MemoryRegionOps never reach it.
+ *
+ * What that claims. The Z 9 model was written against the Z 9 image; this
+ * image is the same EXPEED 7 generation, and the parts checked so far agree
+ * (the capture interrupt names, the BUFFER_EXT image banks at 0x840000000,
+ * the sensor-interface base). Everything else is an assumption to be
+ * checked as the firmware reaches it, which is why the first access to
+ * each 4 KiB page the model answers is named on stderr, with the PC. Off by
+ * default.
+ *
+ * The switches are ../z9-qemu's tools/model-properties.json less the ones
+ * for blocks this board models itself (the attachment refuses those; see
+ * the end of nikon-z63-z9lab.c), plus z63-boundary-ms=33: the periodic
+ * frame-boundary input ../z9-qemu's run loop delivered from outside (its
+ * tools/z9_global1_boundary_input.py), done here by a timer. -machine z9-capture-props= replaces the
+ * list (items separated by ';'). The statistics and RAW models need an
+ * NZ9RAW1 Bayer file: -machine z9-capture-raw=<path>; z63-tools/make_raw.py
+ * writes a synthetic one. That picture is an input chosen for the run, not
+ * anything the camera's sensor produces.
+ */
+
+#ifndef HW_ARM_NIKON_Z63_Z9LAB_H
+#define HW_ARM_NIKON_Z63_Z9LAB_H
+
+Object *z63_z9lab_new(Object *owner, DeviceState *gic, uint64_t ram_size,
+                      const char *props, Error **errp);
+bool z63_z9lab_read(Object *obj, hwaddr addr, unsigned size,
+                    uint64_t *value);
+bool z63_z9lab_write(Object *obj, hwaddr addr, uint64_t value,
+                     unsigned size);
+uint64_t z63_z9lab_misses(Object *obj);
+
+static const char z63_z9lab_default_props[] =
+    "bootstrap-fixtures=on;"
+    "image-bank-model=on;"
+    "engine150c-control-model=on;"
+    "event1508-front-model=on;"
+    "event1508-aux-model=on;"
+    "event1508-channel-model=on;"
+    "event1508-timing-model=on;"
+    "event1508-timing-period-ns=33333333;"
+    "event1508-global1-model=on;"
+    "event1508-global0-model=on;"
+    "event1508-global0-paired-boundary=on;"
+    "config1524-model=on;"
+    "primary-metadata14c-input=1;"
+    "primary19d-config-model=on;"
+    "primary19bc-config-model=on;"
+    "primary194-config-model=on;"
+    "primary194-submit-model=on;"
+    "primary19bc-submit-model=on;"
+    "primary19d-submit-model=on;"
+    "config1524-control100-input=0;"
+    "engine1524-control-model=on;"
+    "engine1524-mvd-model=on;"
+    "event1508-group-model=on;"
+    "config150d-model=on;"
+    "secondary150d-submit-model=on;"
+    "primary-parameter-control-model=on;"
+    "task1500-control-model=on;"
+    "engine1543-control-model=on;"
+    "engine151-control-model=on;"
+    "engine152-control-model=on;"
+    "primary19bc-zero-results-input=on;"
+    "pipeline-aux-zero-input=on;"
+    "raw-pipeline-model=on;"
+    "engine150d-control-model=on;"
+    "engine150c-stop-model=on;"
+    "statistics-model=on;"
+    "primary-empty-end-model=on;"
+    "engine150c-bit6-model=on;"
+    "stream154c-stop-model=on;"
+    "event1508-stop-model=on;"
+    "engine150d-readback-input=0:0:0:0:0;"
+    "z63-boundary-ms=33";
+
+#define Z63_Z9LAB_LO 0x15000000ULL
+#define Z63_Z9LAB_HI 0x16100000ULL
+
+static Object *z63_z9lab;   /* NULL unless -machine z9-capture=on */
+static unsigned long *z63_z9lab_named;
+
+/* The capture ranges, less the display unit/complex (0x15480000..
+ * 0x154bffff) and graphics (0x15540000..0x1555ffff), which are this
+ * board's. */
+static bool z63_z9lab_range(hwaddr addr)
+{
+    return addr >= Z63_Z9LAB_LO && addr < Z63_Z9LAB_HI &&
+           !(addr >= 0x15480000 && addr < 0x154c0000) &&
+           !(addr >= 0x15540000 && addr < 0x15560000);
+}
+
+static void z63_z9lab_name(hwaddr addr, bool write, uint64_t value)
+{
+    unsigned page = (addr - Z63_Z9LAB_LO) >> 12;
+
+    if (!test_and_set_bit(page, z63_z9lab_named)) {
+        error_report("Z63_Z9LAB: page 0x%" HWADDR_PRIx " answered by "
+                     "../z9-qemu's model (first: %s 0x%" HWADDR_PRIx
+                     " = 0x%" PRIx64 ", pc=0x%" PRIx64 ")",
+                     addr & ~(hwaddr)0xfff, write ? "write" : "read", addr,
+                     value, current_cpu ? ARM_CPU(current_cpu)->env.pc : 0);
+    }
+}
+
+static bool z63_front_read(hwaddr addr, unsigned size, uint64_t *value)
+{
+    if (!z63_z9lab || !z63_z9lab_range(addr) ||
+        !z63_z9lab_read(z63_z9lab, addr, size, value)) {
+        return false;
+    }
+    z63_z9lab_name(addr, false, *value);
+    return true;
+}
+
+static bool z63_front_write(hwaddr addr, uint64_t value, unsigned size)
+{
+    if (!z63_z9lab || !z63_z9lab_range(addr) ||
+        !z63_z9lab_write(z63_z9lab, addr, value, size)) {
+        return false;
+    }
+    z63_z9lab_name(addr, true, value);
+    return true;
+}
+
+static bool z63_z9lab_init(Object *owner, DeviceState *gic, uint64_t ram_size,
+                           const char *props, const char *raw, Error **errp)
+{
+    g_autofree char *all = g_strdup_printf("%s;statistics-raw=%s",
+                                           props && *props ? props :
+                                           z63_z9lab_default_props,
+                                           raw ? raw : "");
+
+    if (!raw || !*raw) {
+        error_setg(errp, "z9-capture=on needs z9-capture-raw=<NZ9RAW1 file> "
+                   "(z63-tools/make_raw.py writes one)");
+        return false;
+    }
+    z63_z9lab = z63_z9lab_new(owner, gic, ram_size, all, errp);
+    if (!z63_z9lab) {
+        return false;
+    }
+    z63_z9lab_named = bitmap_new((Z63_Z9LAB_HI - Z63_Z9LAB_LO) >> 12);
+    return true;
+}
+
+#endif /* HW_ARM_NIKON_Z63_Z9LAB_H */
