                       '-bios', eg, '-serial', 'unix:%s,server=on,wait=off' % sock_path,
-                      '-monitor', 'none', '-display', 'none'],
-                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+                      '-monitor', 'none', '-display', 'none']
+                     + shlex.split(os.environ.get('QEMU_ARGS', '')),
+                     stdout=subprocess.DEVNULL,
+                     stderr=open(os.environ['QEMU_LOG'], 'w')
+                     if os.environ.get('QEMU_LOG') else subprocess.DEVNULL)
 try:
