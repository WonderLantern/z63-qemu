+        g->packets, g->table_words, g->table_address,
+        g->param10, g->param11, g->pending, g->irq_mask, g->buffer70, g->config74);
+    for (unsigned bank = 0; bank < 2; bank++) {
+        g_string_append(out, bank ? ",[" : "[");
+        for (unsigned i = 0; i < 192; i++) {
