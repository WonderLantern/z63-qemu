+        m->spi[i].irq = qdev_get_gpio_in(armv7m, z63_stm32_spi_irq[i]);
+        z63_stm32_map(m, &m->spi[i].mr, owner, &z63_stm32_spi_ops,
+                      &m->spi[i], name, z63_stm32_spi_base[i], 0x400);
+    }
+    object_initialize_child(owner, "z63-mcu-exti", &m->exti,
+                            TYPE_STM32F4XX_EXTI);
+    if (!sysbus_realize(SYS_BUS_DEVICE(&m->exti), errp)) {
+        return;
+    }
+    memory_region_add_subregion(&m->mem, 0x40013c00,
+        sysbus_mmio_get_region(SYS_BUS_DEVICE(&m->exti), 0));
+    for (unsigned i = 0; i < 16; i++) {
+        sysbus_connect_irq(SYS_BUS_DEVICE(&m->exti), i,
+                           qdev_get_gpio_in(armv7m, z63_stm32_exti_irq[i]));
+    }
+
+    for (unsigned c = 0; c < 2; c++) {
+        g_autofree char *name = g_strdup_printf("z63-mcu-dma%u", c + 1);
+        Z63Stm32Dma *d = &m->dma[c];
