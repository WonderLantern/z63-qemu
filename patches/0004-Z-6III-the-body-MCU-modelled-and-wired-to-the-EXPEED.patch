+static void set_primary_parameter_control_model(Object *obj, bool value, Error **errp)
+{
+    NikonZ9State *s = NIKON_Z9_LAB(obj);
+    if (s->engine150c_irq) {
+        error_setg(errp, "primary-parameter-control-model is immutable after realization");
+        return;
