+    m->fmpi2c.ev_irq = qdev_get_gpio_in(armv7m, 95);
+    m->fmpi2c.er_irq = qdev_get_gpio_in(armv7m, 96);
+    z63_stm32_map(m, &m->fmpi2c.mr, owner, &z63_stm32_fmpi2c_ops, m,
+                  "z63-mcu-fmpi2c1", Z63_STM32_FMPI2C_BASE, 0x400);
+
+    z63_stm32_reset(m);
+    qemu_register_reset(z63_stm32_reset, m);
+
+    /* TEMPORARY PROBE (remove): where the core is and what it has armed. */
+    if (getenv("Z63_STM32_DEBUG")) {
+        m->dbg_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, z63_stm32_debug, m);
