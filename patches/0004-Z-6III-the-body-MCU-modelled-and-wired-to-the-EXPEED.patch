+static uint32_t engine150c_stop_command(uint32_t engines)
+{
+    return ((engines & 2) >> 1) | (engines & 4) | ((engines & 8) << 3) |
+           ((engines & 1) ? 0x18 : 0) | ((engines & 0x40) >> 1) |
+           ((engines & 0x1000) ? 0x1800 : 0) |
+           ((engines & 0x2000) ? 0x6000 : 0) |
+           ((engines & 0x40000) ? 0x300 : 0);
+}
