+            case 0x7c: *mask = 0xff00ff; break;
+            case 0x80: case 0x84: case 0x88: case 0x9c: *mask = 0x1f001f; break;
+            case 0x8c: *mask = 0x1f1f1f1f; break;
+            case 0x90: *mask = 0x3030001; break;
+            case 0x94: *mask = 0x3ff; break;
