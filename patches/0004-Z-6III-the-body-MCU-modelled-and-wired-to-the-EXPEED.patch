+/* DMA requests from a peripheral whose data register is at `par`: give it
+ * the next item (memory to peripheral) or take one (peripheral to memory).
+ * False when no enabled stream serves it. Defined with the DMA model. */
+static bool z63_stm32_dma_tx(Z63Stm32 *m, uint32_t par, uint32_t *value);
+static bool z63_stm32_dma_rx(Z63Stm32 *m, uint32_t par, uint32_t value);
+static void z63_stm32_dma_kick(Z63Stm32 *m);
+
+static uint32_t z63_stm32_pc(void)
+{
+    return current_cpu ? ARM_CPU(current_cpu)->env.regs[15] : 0;
+}
+
+static void z63_stm32_stop(const char *block, hwaddr addr, unsigned size,
+                         bool write, uint64_t value)
+{
+    if (write) {
+        error_report("Z63_STM32 %s unmodeled write addr=0x%08" HWADDR_PRIx
+                     " size=%u value=0x%" PRIx64 " pc=0x%08x -- stopping",
+                     block, addr, size, value, z63_stm32_pc());
+    } else {
+        error_report("Z63_STM32 %s unmodeled read  addr=0x%08" HWADDR_PRIx
+                     " size=%u pc=0x%08x -- stopping",
+                     block, addr, size, z63_stm32_pc());
+    }
+    qemu_system_shutdown_request_with_code(SHUTDOWN_CAUSE_GUEST_PANIC, 3);
+}
