diff --git a/z63-tools/gdb_probe.py b/z63-tools/gdb_probe.py
new file mode 100755
index 0000000..d5c8afa
--- /dev/null
+++ b/z63-tools/gdb_probe.py
@@ -0,0 +1,152 @@
+#!/usr/bin/env python3
+"""Run the machine under QEMU's gdbstub and report breakpoint hits.
+
+    gdb_probe.py <qemu> <machine opts> <eg> <seconds> <addr>[,<addr>...] [maxhits]
+
+The gdbstub listens on 127.0.0.1:41234 only (never the shared 1234). QMP is
+on /tmp/bt-qmp.sock while it runs. Environment:
+
+  COND=r=v     report only hits with x<r> == v (others are stepped over)
+  SKIP=r=v:v   step over hits with x<r> equal to any listed value
+  LIGHT=1      one line per hit: pc, x0..x3, lr -- for tracing a function's
+               every call, e.g. the capture modules' trace sub_40FD183C
+               (x0 category, x1 code, x2/x3 arguments)
+  MEMREG=r:n   also dump n bytes at the address in x<r>
+  DUMP=n       also dump n bytes of the stack as u32
+  KEYS="t:keys;t:keys"  set -machine mcu-keys at t seconds (host time)
+  WATCH=a:n    write watchpoint (unreliable in this setup -- see plan.md)
+
+Hits on any CPU are reported; the breakpoint is stepped over and re-armed.
+"""
+
+import os, socket, struct, subprocess, sys, time
+COND = os.environ.get("COND")          # "1=0xc1f": only hits with x1 == 0xc1f
+if COND:
+    creg, cval = COND.split("="); creg = int(creg); cval = int(cval, 0)
+SKIP = os.environ.get("SKIP")          # "0=0xa02e725b0:0xa02e72600"
+if SKIP:
+    sreg, svals = SKIP.split("="); sreg = int(sreg)
+    svals = {int(v, 0) for v in svals.split(":")}
+
+qemu, mopts, eg, secs, addrs = sys.argv[1:6]
+maxhits = int(sys.argv[6]) if len(sys.argv) > 6 else 4
+addrs = [int(a, 16) for a in addrs.split(",") if a]
+port = 41234
+q = subprocess.Popen([qemu, "-machine", mopts, "-cpu", "cortex-a53", "-smp", "4",
+                      "-bios", eg, "-serial", "null", "-monitor", "none",
+                      "-display", "none", "-gdb", "tcp:127.0.0.1:%d" % port, "-S",
+                      "-qmp", "unix:/tmp/bt-qmp.sock,server=on,wait=off"],
+                     stdout=subprocess.DEVNULL, stderr=open("/tmp/bt.log", "w"))
+
+class Rsp:
+    def __init__(self):
+        for _ in range(100):
+            try:
+                self.s = socket.create_connection(("127.0.0.1", port)); break
+            except OSError:
+                time.sleep(0.1)
+        self.buf = b""
+    def send(self, c):
+        self.s.sendall(b"$" + c + b"#%02x" % (sum(c) & 0xff))
+        while self.s.recv(1) != b"+":
+            pass
+    def recv(self, timeout=None):
+        self.s.settimeout(timeout)
+        while True:
+            i = self.buf.find(b"#")
+            if i >= 0 and len(self.buf) >= i + 3:
+                body = self.buf[self.buf.find(b"$") + 1:i]
+                self.buf = self.buf[i + 3:]
+                self.s.sendall(b"+")
+                return body.decode()
+            self.buf += self.s.recv(65536)
+    def cmd(self, c):
+        self.send(c.encode()); return self.recv()
+
+r = Rsp()
+r.cmd("qSupported")
+for a in addrs:
+    print("Z1", hex(a), r.cmd("Z1,%x,4" % a))
+WATCH = os.environ.get("WATCH")        # "addr:len" write watchpoint
+if WATCH:
+    wa, wl = WATCH.split(":")
+    print("Z2", wa, r.cmd("Z2,%s,%s" % (wa, wl)))
+r.send(b"c")
+KEYS = os.environ.get("KEYS")          # "delay:keys;delay:keys" via qom-set
+if KEYS:
+    import json, threading
+    def inject():
+        qs = socket.socket(socket.AF_UNIX); qs.connect("/tmp/bt-qmp.sock")
+        qf = qs.makefile("rw"); qf.readline()
+        def qc(ex, **a):
+            qf.write(json.dumps({"execute": ex, "arguments": a}) + "\n"); qf.flush()
+            while True:
+                d = json.loads(qf.readline())
+                if "return" in d or "error" in d: return d
+        qc("qmp_capabilities")
+        t0 = time.time()
+        for step in KEYS.split(";"):
+            delay, keys = step.split(":", 1)
+            while time.time() - t0 < float(delay): time.sleep(0.2)
+            print("inject", keys, qc("qom-set", path="/machine", property="mcu-keys", value=keys), flush=True)
+    threading.Thread(target=inject, daemon=True).start()
+deadline = time.time() + float(secs)
+hits = 0
+while time.time() < deadline and hits < maxhits:
+    try:
+        stop = r.recv(timeout=max(1, deadline - time.time()))
+    except socket.timeout:
+        break
+    g = r.cmd("g")
+    regs = [struct.unpack("<Q", bytes.fromhex(g[i * 16:(i + 1) * 16]))[0] for i in range(33)]
+    pc, sp = regs[32], regs[31]
+    if (COND and regs[creg] != cval) or (SKIP and regs[sreg] in svals):
+        for a in addrs:
+            r.cmd("z1,%x,4" % a)
+        r.cmd("s")
+        for a in addrs:
+            r.cmd("Z1,%x,4" % a)
+        r.send(b"c")
+        continue
+    if os.environ.get("LIGHT"):
+        print("T %x %x %x %x %x lr=%x" % (pc, regs[0], regs[1], regs[2], regs[3], regs[30]), flush=True)
+        hits += 1
+        for a in addrs:
+            r.cmd("z1,%x,4" % a)
+        r.cmd("s")
+        for a in addrs:
+            r.cmd("Z1,%x,4" % a)
+        r.send(b"c")
+        continue
+    print("hit", stop, "pc=%x lr=%x sp=%x" % (pc, regs[30], sp))
+    print("  " + " ".join("x%d=%x" % (i, regs[i]) for i in range(0, 24)))
+    raw = b""
+    for off in range(0, 0x800, 0x80):
+        m = r.cmd("m%x,80" % (sp + off))
+        if m.startswith("E") or len(m) != 256:
+            print("  stack read at %x: %s" % (sp + off, m[:8])); break
+        raw += bytes.fromhex(m)
+    words = struct.unpack("<%dQ" % (len(raw) // 8), raw)
+    code = ["%x@+%x" % (w, i * 8) for i, w in enumerate(words)
+            if 0x40160000 <= w < 0x41800000 and not w & 3]
+    print("  stack code words:", " ".join(code[:40]))
+    if os.environ.get("MEMREG"):
+        mr, ml = os.environ["MEMREG"].split(":")
+        m = r.cmd("m%x,%x" % (regs[int(mr)], int(ml, 0)))
+        print("  mem@x%s:" % mr, m)
+    if os.environ.get("DUMP"):
+        n = int(os.environ["DUMP"], 0)
+        w32 = struct.unpack("<%dI" % (n // 4), raw[:n])
+        print("  stack u32:", " ".join("%x" % x for x in w32))
+    hits += 1
+    for a in addrs:
+        r.cmd("z1,%x,4" % a)
+    if WATCH:
+        r.cmd("z2,%s,%s" % (wa, wl))
+    r.cmd("s")
+    for a in addrs:
+        r.cmd("Z1,%x,4" % a)
+    if WATCH:
+        r.cmd("Z2,%s,%s" % (wa, wl))
+    r.send(b"c")
+q.kill()
