+     "    }\n")
+edit("        ARM_CPU(cpu)->wl_event_peer = s->service_core_event_model;\n"
+     "        ARM_CPU(cpu)->wl_event_block = s->service_core_event_model && i == 3;\n",
+     "")
+edit('            ARM_CPU(cpu)->env.wl_event_pending ? "true" : "false",\n'
+     '            ARM_CPU(cpu)->env.wl_event_waiting ? "true" : "false",\n'
+     '            ARM_CPU(cpu)->env.wl_event_sleeps, ARM_CPU(cpu)->env.wl_event_wakes);\n',
+     '            "false", "false", (uint64_t)0, (uint64_t)0); /* z63: no event patch */\n')
+edit("static void nikon_z9_init(MachineState *machine)\n",
+     "static G_GNUC_UNUSED void nikon_z9_init(MachineState *machine)\n")
+edit("    MachineClass *mc = MACHINE_CLASS(oc);\n"
+     '    mc->desc = "Nikon Z9 C5.32 experimental bring-up (not complete camera)";\n',
+     "")
+edit("    mc->init = nikon_z9_init;\n"
+     '    mc->default_cpu_type = ARM_CPU_TYPE_NAME("cortex-a53");\n'
+     '    mc->default_ram_id = "z9.work-ram";\n'
