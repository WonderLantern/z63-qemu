diff --git a/z63-tools/gui.sh b/z63-tools/gui.sh
new file mode 100755
index 0000000..7ca80cb
--- /dev/null
+++ b/z63-tools/gui.sh
@@ -0,0 +1,70 @@
+#!/bin/sh
+# Run the Z 6III machine with a Cocoa window, to look at what the scanout
+# composes. Needs a build configured with --enable-cocoa, and a desktop
+# session to open the window in (start it from Terminal or Finder, not
+# over ssh). Extra arguments are passed to QEMU.
+#
+#   LOADER=loader_0x40000000-0x40160000.bin SNOR_USER=snor_user.bin \
+#   NAND=nand-debug-pristine.img \
+#       z63-tools/gui.sh <dir holding eg2010_0200i1.bi> [qemu options...]
+#
+# MCU=<dir holding ex2010_0200a0.bi> runs the body MCU's own image on a
+# Cortex-M4 beside the A53s, instead of the scripted peer (nikon-z63-mcu.h
+# and nikon-z63-stm32.h). It needs -smp 4,maxcpus=5 -- the M4 is the fifth
+# CPU and QEMU sizes its TCG context array from max_cpus -- which this
+# script supplies automatically. MCU_PINS=G7=1:C5=0 drives the MCU's own
+# input pins, standing in for the wires the EXPEED holds; the separator is
+# ":" because "," separates -machine properties.
+#
+# MCU_SPI_PEER=1:0+4:1 bridges the MCU's SPI<n> to this board's serial
+# instance <m>, which is the link between the two chips (nikon-z63-sio.h).
+# The pairing is a declared choice, not a measurement: every word both ways
+# is logged as Z63_MCU_LINK, so a wrong guess shows on the first transfer.
+# MCU_WIRES=B12=a3:2+E3=a3:3+D12=a4:3 wires the MCU's own handshake pins to
+# the EXPEED's GPIO_TOP port bits, which is what the two firmwares poll and
+# drive. Declared, and each wire is logged as Z63_MCU_WIRE.
+#
+#
+# NAND is copied before every run (to $NAND.run) because the firmware
+# writes to it; the original is never touched. Without NAND the RTOS does
+# not get as far as the display.
+#
+# A refused access stops the machine by asking QEMU to shut down; here
+# -action shutdown=pause turns that into a pause, so the window stays open
+# on the last frame and the reason is on stderr. QMP is on
+# /tmp/z63-gui.sock for looking at a paused machine.
+#
+# Keys in the window are camera buttons (nikon-z63-mcu.h): arrows, Return
+# (OK), M (MENU), P (playback), Backspace (delete), H (half-press), Space
+# (full press), D (DISP), F1-F3 (Fn), R (movie), A (AF-ON). With the
+# original SNOR_USER body the camera shows Err (a fault saved in that dump);
+# z63-tools/snor_user_clear_error.py writes a copy without it.
+#
+# The window stays blank until the firmware programs the display controller:
+# nikon-z63-scanout.h refuses to compose a frame from a register file that
+# has no output size, and says why once on stderr.
+set -e
+DIR=${1:?usage: gui.sh <dir holding eg2010_0200i1.bi> [qemu options...]}
+shift
+QEMU=$(cd "$(dirname "$0")/.." && pwd)/build/qemu-system-aarch64
+OPT=""
+SMP=4
+[ -n "${LOADER:-}" ] && OPT="$OPT,loader=$LOADER"
+[ -n "${SNOR_USER:-}" ] && OPT="$OPT,snor-user=$SNOR_USER"
+if [ -n "${NAND:-}" ]; then
+    cp "$NAND" "$NAND.run"
+    OPT="$OPT,nand=$NAND.run"
+fi
+if [ -n "${MCU:-}" ]; then
+    OPT="$OPT,mcu-image=$MCU/ex2010_0200a0.bi"
+    [ -n "${MCU_PINS:-}" ] && OPT="$OPT,mcu-pins=$MCU_PINS"
+    [ -n "${MCU_WIRES:-}" ] && OPT="$OPT,mcu-wires=$MCU_WIRES"
+    [ -n "${MCU_SPI_PEER:-}" ] && OPT="$OPT,mcu-spi-peer=$MCU_SPI_PEER"
+    SMP=4,maxcpus=5
+fi
+rm -f /tmp/z63-gui.sock
+exec "$QEMU" -name z63-gui -machine "nikon-z63$OPT" \
+    -cpu cortex-a53 -smp "$SMP" -bios "$DIR/eg2010_0200i1.bi" \
+    -serial file:/tmp/z63-gui-serial.log -monitor none \
+    -qmp unix:/tmp/z63-gui.sock,server=on,wait=off \
+    -display cocoa -action shutdown=pause "$@"
diff --git a/z63-tools/import_z9lab.py b/z63-tools/import_z9lab.py
new file mode 100644
index 0000000..d90d0bd
--- /dev/null
+++ b/z63-tools/import_z9lab.py
@@ -0,0 +1,117 @@
+#!/usr/bin/env python3
+"""Bring ../z9-qemu's capture-side models into this tree, edited only where
+the Z 6III board has to own something the Z 9 board owned.
+
+    import_z9lab.py [<z9-qemu checkout>]       (default ../z9-qemu)
+
+../z9-qemu (WonderLantern, GPL-2.0-or-later; its qemu/nikon-z9-lab.c,
+nikon-z9-pixels.h and nikon-raw-pixels.h) reached the Z 9's live view with a
+set of capture models: the sensor-interface event block at 0x15080000, the
+ISP_APB configuration/submission blocks, engines 0x150c/0x150d/0x1524 (+MVD),
+0x1543, 0x151/0x152, statistics and a RAW -> NV12/NV16 pipeline fed from a
+local Bayer file. The Z 6III is the same EXPEED 7 generation; the board
+takes those models as they are and puts them in front of its own register
+windows (hw/arm/nikon-z63-z9lab.h), so that where the Z 9 model answers,
+its answer is used, and where it declines the board's own window does.
+
+The edits, each asserted to match exactly once (or the stated count):
+
+  1. the type is a plain Object named "nikon-z63-z9lab", not a machine;
+  2. the state gains ram_size (was MACHINE(s)->ram_size) and a compat flag;
+  3. with the compat flag, unknown_access() records a miss and returns,
+     instead of printing and stopping -- the board decides what a miss means;
+  4. the two lines that set the Z 9's CPU patch fields (wl_event_peer/
+     wl_event_block, from its arm-service-events.patch) are removed, and the
+     runtime-clock-state report shows that patch's counters as zero: this
+     tree has no such patch, and the service-core event model is refused;
+  5. the machine class fields go, and nikon_z9_init stays only as unused
+     reference (the attachment below replaces it);
+  6. an attachment section is appended: object creation, switches, and the
+     capture interrupts and timers on the board's GIC.
+
+Nothing else in the files is changed. Re-run after updating ../z9-qemu and
+review the diff; a failed assertion means the source moved under an edit.
+"""
+import hashlib
+import sys
+from pathlib import Path
+
+here = Path(__file__).resolve().parent
+tree = here.parent
+src = Path(sys.argv[1] if len(sys.argv) > 1 else tree.parent / "z9-qemu") / "qemu"
+lab = (src / "nikon-z9-lab.c").read_text()
+sha = hashlib.sha256(lab.encode()).hexdigest()
+
+
+def edit(old, new, count=1):
+    global lab
+    n = lab.count(old)
+    if n != count:
+        sys.exit("expected %d match(es), found %d:\n%s" % (count, n, old))
+    lab = lab.replace(old, new)
+
+
+head = """/*
+ * Nikon Z 6III -- ../z9-qemu's capture-side models, carried in.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * This file is qemu/nikon-z9-lab.c from ../z9-qemu (WonderLantern's Z 9
+ * bring-up board; GPL-2.0-or-later), sha256 %s,
+ * written by z63-tools/import_z9lab.py with the edits that script lists:
+ * a plain object instead of a machine, a compat flag that turns its strict
+ * stop into a reported miss, its CPU-patch lines removed, and an attachment
+ * section at the end. How the Z 6III board uses it, and what has been
+ * checked against this image, is in hw/arm/nikon-z63-z9lab.h. Do not edit
+ * by hand: change the script, or ../z9-qemu, and re-run it.
+ */
+""" % sha
+
+edit('#define TYPE_NIKON_Z9_LAB MACHINE_TYPE_NAME("nikon-z9-lab")',
+     '#define TYPE_NIKON_Z9_LAB "nikon-z63-z9lab"')
+edit("struct NikonZ9State {\n    MachineState parent;\n",
+     "struct NikonZ9State {\n    Object parent;\n"
+     "    uint64_t ram_size;      /* z63: was MACHINE(s)->ram_size */\n"
+     "    bool compat;            /* z63: misses are reported, not stopped */\n"
+     "    bool compat_miss;\n"
+     "    uint64_t compat_misses;\n")
+edit("MACHINE(s)->ram_size", "s->ram_size", 4)
+edit("static void unknown_access(NikonZ9State *s, hwaddr addr, uint64_t value,\n"
+     "                           unsigned size, bool write)\n{\n",
+     "static void unknown_access(NikonZ9State *s, hwaddr addr, uint64_t value,\n"
+     "                           unsigned size, bool write)\n{\n"
+     "    if (s->compat) {\n"
