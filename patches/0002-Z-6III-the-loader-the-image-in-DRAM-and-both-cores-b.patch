@@ -0,0 +1,82 @@
+/*
+ * Nikon Z 6III -- the VPIPE-CTL block at 0x15200000.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Generated by z63-tools/make_window.py from `eg2010_0200i1.bi` (md5
+ * b024ec7148e24ec0493e27d4d0f20b0e), read through the IDA database
+ * `z63_eg.elf` (md5 0fedcc0523da1dac8127a8010ccf978b) -- the database that
+ * matches the shipped image. `vr2070.elf` is a different image whose
+ * register layout is nearly identical and whose function addresses mostly
+ * agree, which makes reading this image's PCs through it produce plausible,
+ * wrong answers.
+ *
+ * Reached from sub_40C75C50, which loads the base out of the single runtime pointer at 0xa02e7b0c0 and writes 1 to +0x00 and +0x04 at 0x40c75c80/0x40c75c84. Nothing in the image holds this address as a constant -- window_pointers.py finds no pointer into 0x15200000-0x15210000 -- so the pointer is written at run time and the block is named only by this one slot.
+ *
+ * The register set
+ * ----------------
+ * 152 offsets, highest 0xfcc, from 43 functions in
+ * 0x40c70000-0x40c80000. Extracted with --array-base 0xa02e7b0c0, so the base is loaded out of a runtime
+ * pointer array. That array's slots are filled at run time and hold the
+ * bases of several device types, so this offset set is the union over all
+ * of them and is wider than this block's own register file. Modelling a
+ * register here that belongs to a sibling costs nothing -- nothing else
+ * maps this window -- but it can mask an access worth seeing, so this is
+ * the first block to re-derive if something here looks wrong.
+ *
+ * The extraction is a forward dataflow over the basic-block graph, not a
+ * scan in address order: these accessors pick an offset with a branch or a
+ * CSEL chain, and an address-order walk applies one path's offset to a
+ * register another path overwrote. See the header of handle_offsets.py.
+ *
+ * What is a declared choice
+ * -------------------------
+ * Storage. Where the firmware read-modify-writes a register, reading back
+ * what was written is its own stated expectation, not an invention.
+ *
+ * 15 of these offsets are only ever read, never written -- the shape of a
+ * status register. For those, storage is a DECLARED CHOICE: this model
+ * returns the reset value and nothing here knows what the hardware would
+ * report. A firmware poll on a bit real silicon raises would hang rather
+ * than stop, and z63-tools/where_blocked.py is the instrument for that.
+ *
+ * An offset not in this set still stops the machine with its PC, which is
+ * the only way the next one gets found.
+ */
+
+#ifndef HW_ARM_NIKON_Z63_VPIPE_CTL_H
+#define HW_ARM_NIKON_Z63_VPIPE_CTL_H
+
+#define Z63_VPCTL_BASE    0x15200000ULL
+#define Z63_VPCTL_SIZE    0x1000
+#define Z63_VPCTL_STRIDE  0x0000
+
+static const uint16_t z63_vpipe_ctl_offsets[] = {
+    0x0000, 0x0004, 0x0008, 0x000c, 0x0010, 0x0014, 0x0018, 0x0020,
+    0x0024, 0x0028, 0x0030, 0x003c, 0x0040, 0x0044, 0x0048, 0x004c,
+    0x0050, 0x0054, 0x0058, 0x005c, 0x0060, 0x0064, 0x0068, 0x006c,
+    0x0070, 0x0074, 0x0078, 0x007c, 0x0080, 0x0084, 0x0088, 0x008c,
+    0x0090, 0x0094, 0x0098, 0x009c, 0x00a0, 0x00a4, 0x00a8, 0x00ac,
+    0x00b0, 0x00b4, 0x00b8, 0x00bc, 0x00c0, 0x00c4, 0x00c8, 0x00cc,
+    0x00d0, 0x00d4, 0x00d8, 0x00dc, 0x00e0, 0x00e4, 0x00e8, 0x00ec,
+    0x00f0, 0x00f4, 0x00f8, 0x0100, 0x0104, 0x0108, 0x010c, 0x0110,
+    0x0114, 0x0118, 0x011c, 0x0120, 0x0124, 0x0128, 0x0130, 0x0138,
+    0x0140, 0x0144, 0x0148, 0x0150, 0x0158, 0x0164, 0x0168, 0x016c,
+    0x0170, 0x0174, 0x0178, 0x017c, 0x0180, 0x0184, 0x0188, 0x0190,
+    0x0198, 0x01a0, 0x01a4, 0x01a8, 0x01b0, 0x01b8, 0x01c0, 0x01c4,
+    0x01c8, 0x01cc, 0x01d0, 0x01d4, 0x01d8, 0x01dc, 0x01e0, 0x01e4,
+    0x01e8, 0x01ec, 0x0440, 0x0444, 0x0454, 0x04b4, 0x04b8, 0x04bc,
+    0x04c0, 0x04f4, 0x04f8, 0x04fc, 0x0500, 0x0504, 0x0508, 0x050c,
+    0x0840, 0x0844, 0x0854, 0x08b4, 0x08b8, 0x08bc, 0x08c0, 0x08f4,
+    0x08f8, 0x08fc, 0x0900, 0x0904, 0x0908, 0x090c, 0x0c40, 0x0c44,
+    0x0c54, 0x0cb4, 0x0cb8, 0x0cbc, 0x0cc0, 0x0cf4, 0x0cf8, 0x0cfc,
+    0x0d00, 0x0d04, 0x0d08, 0x0d0c, 0x0fc0, 0x0fc4, 0x0fc8, 0x0fcc,
+};
+
+/* Only ever read by the firmware -- the declared choice above. */
+static const uint16_t z63_vpipe_ctl_status_offsets[] = {
+    0x0018, 0x0048, 0x004c, 0x01c0, 0x01c4, 0x01c8, 0x01cc, 0x01d0,
+    0x01d4, 0x01d8, 0x01dc, 0x01e0, 0x01e4, 0x01e8, 0x01ec,
+};
