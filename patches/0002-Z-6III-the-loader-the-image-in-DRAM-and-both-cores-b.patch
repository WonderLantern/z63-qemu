+/* ------------------------------------------------------------------ */
+/* Interrupt numbers, from the image's own name table.                 */
+/*                                                                    */
+/* rodata 0x41847000, 0x20 bytes per entry, SPI n at +0x20n. Generated */
+/* by z63-tools/spi_names.py; do not edit by hand.                     */
+/*                                                                    */
+/* The firmware's own registration proves the numbering: its handler   */
+/* install sub_40C00704 takes a GIC INTID, and the descriptor lookup   */
+/* sub_40C00660 computes `base + 16 * (intid - 32)`, so INTID = SPI +  */
+/* 32 exactly as the GIC specifies. The display init registers INTIDs  */
+/* 99, 100, 101, 102 and 105, which are SPIs 67, 68, 69, 70 and 73 --  */
+/* DISP_0, DISP_1, DISP_1B, DISP_DWCH and MIPI_DSI_TX. That agreement  */
+/* between two unrelated sources is why this table can be trusted.     */
+/*                                                                    */
+/* A name here is the SoC's, not a claim that the block is modelled.   */
+/* ------------------------------------------------------------------ */
+
+#ifndef HW_ARM_NIKON_Z63_SPI_H
+#define HW_ARM_NIKON_Z63_SPI_H
+
+/* sub_40C00704 and the GIC both speak INTIDs; this file lists SPIs. */
+#define Z63_INTID(spi)  ((spi) + 32)
+
+#define Z63_SPI_AXI_TRANSACTION_ERR                  0
