+    0x0208, 0x020c, 0x0210, 0x0214, 0x0218, 0x021c, 0x0220, 0x0224,
+    0x0228, 0x022c, 0x0230, 0x0234, 0x0238, 0x023c, 0x0240, 0x0244,
+    0x0248, 0x024c, 0x0250, 0x0254, 0x0258, 0x025c, 0x0260, 0x0264,
+    0x0268, 0x026c, 0x0270, 0x0274, 0x0278, 0x027c, 0x0280, 0x0284,
+    0x0288, 0x028c, 0x0290, 0x0294, 0x0298, 0x029c, 0x02a0, 0x02a4,
+    0x02a8, 0x02ac, 0x02b0, 0x02b4, 0x02b8, 0x02bc, 0x02c0, 0x02c4,
+    0x02c8, 0x02cc, 0x02d0, 0x02d4, 0x02d8, 0x02e0, 0x02e4, 0x02ec,
+    0x02f0, 0x02f8, 0x0304, 0x0310, 0x0314, 0x0318, 0x0320, 0x0324,
+    0x0328, 0x033c, 0x0340, 0x0344, 0x0348, 0x034c, 0x0350, 0x0354,
+    0x0370, 0x0374, 0x0390, 0x0394, 0x0398, 0x039c, 0x03a0, 0x03a4,
+    0x03a8,
+};
+
+/* Only ever read by the firmware -- the declared choice above. */
+static const uint16_t z63_isp_apb_status_offsets[] = {
