@@ -0,0 +1,110 @@
+/*
+ * Nikon Z 6III -- the DSP1C80 block at 0x1c800000.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Generated by z63-tools/make_window.py from `eg2010_0200i1.bi` (md5
+ * b024ec7148e24ec0493e27d4d0f20b0e), read through the IDA database
+ * `z63_eg.elf` (md5 0fedcc0523da1dac8127a8010ccf978b) -- the database that
+ * matches the shipped image. `vr2070.elf` is a different image whose
+ * register layout is nearly identical and whose function addresses mostly
+ * agree, which makes reading this image's PCs through it produce plausible,
+ * wrong answers.
+ *
+ * Unidentified, in the DSP region of the firmware's own address map (0x1b000000-0x20000000). Reached by the crank as a write of 0 to +0x020 from pc 0x40c0a550, where sub_40C0A52C loads the base out of its handle at +8. The firmware pairs this base with 0x17800000 in .data descriptor records near flat 0x45502984, so the two belong to one device. Note +0x052 is read as a halfword, which this 4-byte window does not serve; if that access turns up it will stop with its PC and this window needs widening.
+ *
+ * The register set
+ * ----------------
+ * 9 offsets, highest 0x054, from 7 functions in
+ * 0x40c0a200-0x40c0a720. Extracted with the device base arrives in a descriptor field at +8, so the
+ * offsets below are what the driver applies to it.
+ *
+ * The extraction is a forward dataflow over the basic-block graph, not a
+ * scan in address order: these accessors pick an offset with a branch or a
+ * CSEL chain, and an address-order walk applies one path's offset to a
+ * register another path overwrote. See the header of handle_offsets.py.
+ *
+ * What is a declared choice
+ * -------------------------
+ * Storage. Where the firmware read-modify-writes a register, reading back
+ * what was written is its own stated expectation, not an invention.
+ *
+ * 1 of these offsets are only ever read, never written -- the shape of a
+ * status register. For those, storage is a DECLARED CHOICE: this model
+ * returns the reset value and nothing here knows what the hardware would
+ * report. A firmware poll on a bit real silicon raises would hang rather
+ * than stop, and z63-tools/where_blocked.py is the instrument for that.
+ *
+ * An offset not in this set still stops the machine with its PC, which is
+ * the only way the next one gets found.
+ */
+
+#ifndef HW_ARM_NIKON_Z63_DSP1C80_H
+#define HW_ARM_NIKON_Z63_DSP1C80_H
+
+/*
+ * The instances: three, and the image names all three itself.
+ *
+ * The base arrives in the driver's handle at +8, so an offset scan of the
+ * text cannot see it -- but the driver's own init writes the handle, and
+ * that is in the text:
+ *
+ *     40c0a254  MOVK X8,  #0x1C80,LSL#16     ; 0x1c800000
+ *     40c0a258  MOVK X9,  #0x1D80,LSL#16     ; 0x1d800000
+ *     40c0a25c  MOVK X10, #0x1FC0,LSL#16     ; 0x1fc00000
+ *     40c0a280  STR  X8,  [X19,#8]           ; instance 0
+ *     40c0a284  STR  X9,  [X19,#0x48]        ; instance 1
+ *     40c0a288  STR  X10, [X19,#0x88]        ; instance 2
+ *
+ * So the set is closed at three, on a 0x40 handle stride, and this list
+ * does not grow by guessing. The crank met them in the order 0x1c800000
+ * (pc 0x40c0a550), 0x1d800000, 0x1fc00000 -- all three from the same PC,
+ * which is what a per-instance loop looks like from outside.
+ *
+ * A scan of .data for 0x10000-aligned words in the firmware's DSP region
+ * suggests nine other bases there (0x1b000000, 0x1b110000, 0x1b1b0000,
+ * 0x1c000000, 0x1d000000, 0x1d210000, 0x1d8e0000, 0x1e900000, 0x1f180000).
+ * Nothing shows this driver owning any of them and they are deliberately
+ * NOT mapped here: an access to one should stop with its PC and be given
+ * its own window, not be absorbed by this one. An earlier revision of this
+ * header did list six of them, picked off that scan; the text above
+ * replaced the guess.
+ */
+static const struct { const char *name; hwaddr base; } z63_dsp1c80[] = {
+    { "DSP-0x1C800000", 0x1c800000ULL },  /* handle +0x08 */
+    { "DSP-0x1D800000", 0x1d800000ULL },  /* handle +0x48 */
+    { "DSP-0x1FC00000", 0x1fc00000ULL },  /* handle +0x88 */
+};
+
+#define Z63_DSP1C80_BASE    0x1c800000ULL
+/* 0x3000, not 0x1000: the union set above reaches +0x2000. */
+#define Z63_DSP1C80_SIZE    0x3000
+#define Z63_DSP1C80_STRIDE  0x0000
+
+
+/*
+ * The offset set below is the UNION of what the two DSP windows' accessors
+ * name (0x1b800000: 0x000 0x004 0x008 0x020 0x024 0x028 0x02c 0x050 0x054
+ * 0x060 0x2000; 0x1c800000: 0x000 0x004 0x008 0x020 0x024 0x028 0x040
+ * 0x050 0x052 0x054). One driver cluster, 0x40c2dee0-0x40c2e340,
+ * materialises every base of both, and both are opened by the same
+ * read-modify-write of +0x020 clearing bit 0 -- so they are one block type
+ * and each accessor set is a partial view of the same register file. The
+ * crank proved the point: with 0x1b800000 given only its own eleven
+ * offsets it stopped at +0x040, which is in the other set.
+ *
+ * +0x052 is read as a halfword and is not in this array, because this
+ * window serves 4-byte accesses only; if that read turns up it will stop
+ * with its PC and say so.
+ */
+static const uint16_t z63_dsp1c80_offsets[] = {
+    0x0000, 0x0004, 0x0008, 0x0020, 0x0024, 0x0028, 0x002c, 0x0040,
+    0x0050, 0x0054, 0x0060, 0x2000,
+};
+
+/* Only ever read by the firmware -- the declared choice above. */
+static const uint16_t z63_dsp1c80_status_offsets[] = {
+    0x0054,
+};
+
+#endif /* HW_ARM_NIKON_Z63_DSP1C80_H */
