+#!/usr/bin/env python3
+"""Find every little-endian pointer in the firmware image that lands inside a
+given MMIO window.
+
+Usage: window_pointers.py <eg image> <load va> <lo> <hi> [--width 8|4]
+
+Some register addresses never appear as an immediate and are never reached by
+a constant offset from a descriptor: the firmware keeps a table of absolute
+addresses and loads one by index. The table at rodata 0x4164bf18 is the case
+that motivated this -- fifteen 0x30-byte records whose fields +0x08..+0x28
+are absolute addresses in 0x15083000..0x150833ec -- and a register named only
+there is invisible to both an immediate scan and handle_offsets.py.
+
+A hit is a 64-bit (or 32-bit) aligned word whose value is inside the window.
+That is evidence the firmware holds that address, not proof it dereferences
+it, so the caller still has to decide what to do with each one.
+"""
+import struct, sys
+
+img, load_va, lo, hi = sys.argv[1], int(sys.argv[2], 0), int(sys.argv[3], 0), int(sys.argv[4], 0)
+width = 8
+if "--width" in sys.argv:
+    width = int(sys.argv[sys.argv.index("--width") + 1])
+
+data = open(img, "rb").read()
+fmt = "<Q" if width == 8 else "<I"
+hits = {}
+for off in range(0, len(data) - width + 1, 4):
+    v = struct.unpack_from(fmt, data, off)[0]
+    if lo <= v < hi:
+        hits.setdefault(v, []).append(off)
+
+print(f"{len(hits)} distinct addresses in [{lo:#x},{hi:#x}) "
+      f"named by {sum(len(v) for v in hits.values())} {width*8}-bit words")
+for v in sorted(hits):
+    sites = hits[v]
+    where = " ".join(f"va={load_va+o:#x}" for o in sites[:3])
+    print(f"  {v:#011x}  {len(sites):2d}x  {where}")
