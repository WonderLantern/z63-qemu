+/*
+ * Nikon Z 6III -- the EXS1780 block at 0x17800000.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Generated by z63-tools/make_window.py from `eg2010_0200i1.bi` (md5
+ * b024ec7148e24ec0493e27d4d0f20b0e), read through the IDA database
+ * `z63_eg.elf` (md5 0fedcc0523da1dac8127a8010ccf978b) -- the database that
+ * matches the shipped image. `vr2070.elf` is a different image whose
+ * register layout is nearly identical and whose function addresses mostly
+ * agree, which makes reading this image's PCs through it produce plausible,
+ * wrong answers.
+ *
+ * Unidentified. docs/storage-registers.md section 8 records this window as "not storage": the code region that drives it (0x40c5deb4-0x40c5e934) shares not one function with the SD HAL. It sits in the EXS region of the firmware's own address map. The crank reached it as a read of +0x118 from pc 0x40c5dfd0, where sub_40C5DFA4 polls bit 9 and skips a 0x1388-count wait when it is set.
+ *
+ * The register set
+ * ----------------
+ * 29 offsets, highest 0x1034, from 9 functions in
+ * 0x40c5deb4-0x40c5e934. Extracted with --const-window, so the whole register address is a materialised
+ * constant in the text and the driver does not go through a descriptor
+ * at all; the offsets below are those constants minus 0x17800000.
+ *
+ * The extraction is a forward dataflow over the basic-block graph, not a
+ * scan in address order: these accessors pick an offset with a branch or a
+ * CSEL chain, and an address-order walk applies one path's offset to a
+ * register another path overwrote. See the header of handle_offsets.py.
+ *
+ * What is a declared choice
+ * -------------------------
+ * Storage. Where the firmware read-modify-writes a register, reading back
+ * what was written is its own stated expectation, not an invention.
+ *
+ * 4 of these offsets are only ever read, never written -- the shape of a
+ * status register. For those, storage is a DECLARED CHOICE: this model
+ * returns the reset value and nothing here knows what the hardware would
+ * report. A firmware poll on a bit real silicon raises would hang rather
+ * than stop, and z63-tools/where_blocked.py is the instrument for that.
+ *
+ * An offset not in this set still stops the machine with its PC, which is
+ * the only way the next one gets found.
+ */
+
+#ifndef HW_ARM_NIKON_Z63_EXS1780_H
+#define HW_ARM_NIKON_Z63_EXS1780_H
+
+#define Z63_EXS1780_BASE    0x17800000ULL
+#define Z63_EXS1780_SIZE    0x1100
+#define Z63_EXS1780_STRIDE  0x0000
+
+static const uint16_t z63_exs1780_offsets[] = {
+    0x0000, 0x0004, 0x0008, 0x000c, 0x0014, 0x0110, 0x0114, 0x0118,
+    0x0120, 0x0128, 0x0130, 0x0138, 0x014c, 0x0154, 0x0410, 0x0424,
+    0x0428, 0x042c, 0x043c, 0x0440, 0x0808, 0x080c, 0x0814, 0x0818,
+    0x081c, 0x1008, 0x100c, 0x1010, 0x1034,
+};
+
+/* Only ever read by the firmware -- the declared choice above. */
+static const uint16_t z63_exs1780_status_offsets[] = {
+    0x0808, 0x080c, 0x0818, 0x081c,
+};
