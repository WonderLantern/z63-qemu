+/*
+ * Nikon Z 6III -- the blocks behind the runtime pointer array at 0xa02dc47xx.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * One driver, one register set, several instances, and the instance bases
+ * are not in the image. Each accessor materialises the address of a slot in
+ * a pointer array in BSS and loads the base out of it:
+ *
+ *     MOV  X8, #0x47d8 ; MOVK X8,#0x2dc,LSL#16 ; MOVK X8,#0xa,LSL#32
+ *     LDR  X20, [X8]              ; 0xa02dc47d8 -> 0x15040000
+ *     LDR  W8, [X20] ...          ; 0x40c2383c, set then clear bit 0 of +0x00
+ *
+ *     MOV  X8, #0x47f0 ; ...      ; 0xa02dc47f0 -> 0x15000000
+ *     LDR  X8, [X8]
+ *     STR  W22, [X8]              ; 0x40c2425c, writes -1 to +0x00
+ *
+ * The slots are 0x18 apart. They cannot be read out of the image: the array
+ * is at flat 0x457b57d8 (runtime minus the measured .data delta
+ * 0x9bd60f000) and the image ends at flat 0x4561719f, so it is BSS and is
+ * filled at run time. There is no static enumeration of this family to be
+ * had -- each instance becomes known when the firmware first touches it and
+ * the machine stops with the PC that names its slot.
+ *
+ * That is why this file is a base *list*. Adding the next instance is one
+ * line here once its stop names it, not a new investigation: the register
+ * set is already known, because a harvest seeded at any one slot returns the
+ * union over every device the array serves. Two independent harvests, seeded
+ * at 0xa02dc47d8 and 0xa02dc47f0, each returned the same 680 offsets.
+ *
+ * The register set
+ * ----------------
+ * 680 offsets, highest 0xc024, from 390 functions in
+ * 0x40c20000-0x40c30000, by z63-tools/handle_offsets.py --array-base: a
+ * forward dataflow over the basic-block graph.
+ *
+ * Because the set is the union over the array's device types, it is wider
+ * than any one block's register file. That costs nothing -- nothing else
+ * maps these windows -- but it can absorb an access worth seeing, so this is
+ * among the first families to re-derive if something here looks wrong. The
+ * window size is 0x10000, from the highest offset in the set, and is not
+ * independently established.
+ *
+ * What is a declared choice
+ * -------------------------
+ * Storage. 125 offsets are only ever read, never written; for those the
+ * reset value is returned and nothing here knows what hardware reports.
+ * Giving every instance the same set and the same size is also a declared
+ * choice, resting on the shared driver and the two agreeing harvests.
+ *
+ * An offset not in the set still stops the machine with its PC.
+ */
+
+#ifndef HW_ARM_NIKON_Z63_ISPBAND_H
+#define HW_ARM_NIKON_Z63_ISPBAND_H
+
+#define Z63_ISPBAND_SIZE  0x10000
+
+/* Each instance, with the pointer slot that named it and the PC that stopped. */
+static const struct {
+    const char *name;
+    hwaddr base;
+} z63_ispband[] = {
+    { "BLK-0x15000000", 0x15000000ULL },  /* slot 0xa02dc47f0, pc 0x40c2425c */
+    { "BLK-0x15040000", 0x15040000ULL },  /* slot 0xa02dc47d8, pc 0x40c2383c */
