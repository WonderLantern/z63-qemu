diff --git a/z63-tools/block_identify.py b/z63-tools/block_identify.py
new file mode 100755
index 0000000..9bc042e
--- /dev/null
+++ b/z63-tools/block_identify.py
@@ -0,0 +1,85 @@
+"""Name an unmodelled MMIO block from the firmware itself.
+
+For a page, take the functions that reference it and look at the string
+literals *those* functions reference. A subsystem names itself that way, with
+no guessing from the address: 0x1a000000..0x1ac00000 answers EF_UVC / MTX_UAC
+/ IAP2CTLSVC, and 0x10000000 answers mele.c / MeSendHciCommand. It fails on
+the two largest blocks, because low-level register drivers are leaf functions
+with nothing to log.
+
+Needs a function table with per-function string references; see
+docs/mmio-coverage.md for how the one used here was produced.
+
+    z63-tools/block_identify.py <cache-dir> <eg2010_0200i1.bi>
+"""
+import collections, json, pathlib, struct, sys, bisect
+
+BASE = 0x40160000
+TEXT = (0x8000, 0x8000 + 0x16de40c)
+LO, HI = 0x08000000, 0x20000000
+
+
+def sites(path):
+    d = pathlib.Path(path).read_bytes()
+    out = collections.defaultdict(set)
+    wide = {}
+    lo, hi = TEXT
+    for off in range(lo, min(hi, len(d) - 4), 4):
+        w = struct.unpack_from('<I', d, off)[0]
+        va = BASE + off
+        v = None
+        if (w & 0x7f800000) == 0x52800000:
+            rd = w & 0x1f
+            wide[rd] = ((w >> 5) & 0xffff) << (16 * ((w >> 21) & 3)); v = wide[rd]
+        elif (w & 0x7f800000) == 0x72800000:
+            rd = w & 0x1f; sh = 16 * ((w >> 21) & 3)
+            wide[rd] = (wide.get(rd, 0) & ~(0xffff << sh)) | (((w >> 5) & 0xffff) << sh)
+            v = wide[rd]
+        elif (w & 0x9f000000) == 0x90000000:
+            rd = w & 0x1f
+            imm = (((w >> 5) & 0x7ffff) << 2) | ((w >> 29) & 3)
+            if imm >> 20: imm -= 1 << 21
+            wide[rd] = (va & ~0xfff) + imm * 4096
+        if v is not None and LO <= v < HI:
+            out[v & ~0xfff].add(va)
+    return out
+
+
+def main():
+    P = pathlib.Path(sys.argv[1])
+    eg = sys.argv[2]
+    feat = {int(k): v for k, v in json.loads((P / 'cache/z63_feat.json').read_text()).items()}
+    starts = sorted(feat)
+    def owner(a):
+        i = bisect.bisect_right(starts, a) - 1
+        if i < 0: return None
+        s = starts[i]
+        return s if a < s + feat[s]['size'] else None
+
+    pages = sites(eg)
+    # group pages into blocks: same 1 MiB window
+    blocks = collections.defaultdict(lambda: {'pages': set(), 'sites': 0, 'funcs': set()})
+    for page, refs in pages.items():
+        b = blocks[page & ~0xfffff]
+        b['pages'].add(page); b['sites'] += len(refs)
+        for r in refs:
+            o = owner(r)
+            if o is not None: b['funcs'].add(o)
+
+    ranked = sorted(blocks.items(), key=lambda kv: -kv[1]['sites'])
+    for base, b in ranked[:14]:
+        strings = collections.Counter()
+        for fn in b['funcs']:
+            for s in feat[fn]['strings']:
+                strings[s] += 1
+        print("=== %#011x  %d sites, %d pages, %d functions"
+              % (base, b['sites'], len(b['pages']), len(b['funcs'])))
+        for s, n in strings.most_common(7):
+            print("      %2d  %s" % (n, s[:88]))
+        if not strings:
+            print("      (no string references in the referencing functions)")
+        print()
+
+
+if __name__ == '__main__':
+    main()
