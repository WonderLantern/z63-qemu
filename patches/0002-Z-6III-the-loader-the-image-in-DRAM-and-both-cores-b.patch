+# The address the RTOS currently stops on.
+#
+# smoke.sh compares the first stop against this. A stop anywhere else is
+# news: either the crank moved forward, in which case update this file in the
+# same change, or a model that used to work has stopped working. While this
+# line holds an address, smoke.sh skips the Linux check -- a refused access
+# stops the whole machine, so CPU3 never gets its chance, and that is a fact
+# about where the RTOS has got to rather than anything wrong with Linux.
+# Clear the line when the crank runs out of blockers.
+
+# Cleared: the RTOS runs 45 s with no unmodelled access at all, no
+# undefined instruction and no exception report on its own console.
+# Leaving this line absent is what turns the Linux check on.
+
+# History, most recent first. Each line is the stop, the PC that made it, and
+# what modelling it took. See docs/register-windows.md for the method.
+#
+#   (none)       --              smoke.sh PASSES both checks: the RTOS runs
+#                                45 s with nothing stopping, and Linux
+#                                reaches a BusyBox prompt in the same
+#                                machine (146 serial lines). 40,917 distinct
+#                                blocks with Linux running.
+#   0x01b200000  pc 0x04163aa38  sequential writes from the image's memcpy:
+#                                DSP local memory, mapped RAM
+#                                (Z63_DSPMEM_BASE)
+#   0x01b800040  pc 0x040c2df68  +0x40 was in the other DSP window's set;
+#                                the two sets are now unioned
+#   0x01b800020  pc 0x040c2df0c  materialised constant, DSP region
+#                                -> nikon-z63-dsp1b80.h
+#   0x0150402c4  pc 0x040c239dc  a FALSE stop: the offset is written by a
+#                                loop whose extent is an argument, so no
+#                                static set can contain it. The two ispband
+#                                windows are `dense` now; see the note in
+#                                nikon-z63-regwindow.h
+#   0x01fc00020  pc 0x040c0a550  third instance; the image names all three
+#                                in the driver's own handle init at
+#                                0x40c0a254-0x40c0a288, so the list is closed
+#   0x01d800020  pc 0x040c0a550  the same driver's next instance; the base
+#                                list in nikon-z63-dsp1c80.h came from .data
+#   0x01c800020  pc 0x040c0a550  descriptor field [handle+8], DSP region
+#                                -> nikon-z63-dsp1c80.h
+#   0x016807f10  (RTOS console)  not a stop -- an external abort the guest
+#                                reported itself, as task [STSQNOR], because
+#                                XDMAC's ops refused a 64-bit store. `valid`
+#                                now admits 8 bytes and `impl` splits them.
+#   0x015d8001c  pc 0x040c0bea8  materialised constant, ISP_AHB_AXI region
+#                                -> nikon-z63-blk15d8.h
+#   0x017800118  pc 0x040c5dfd0  materialised constant; the two windows
+#                                docs/storage-registers.md section 8 had
+#                                left unmapped on purpose
+#                                -> nikon-z63-exs1780.h, -exs1784.h
+#   0x7ffffffb0  pc 0x040168a04  NOT a fault record, as first recorded: the
+#                                sync vector's own STP X0,X1,[SP] with an SP
+#                                that was never set, because the fault it was
+#                                handling came of executing zeros. Cleared by
+#                                placing the image in DRAM where the
+#                                firmware's initial page tables expect it --
+#                                see z63_image_in_dram in hw/arm/nikon-z63.c.
+#   (none)       --              before XDMAC: the RTOS ran clean and
+#                                and reaches a BusyBox prompt. What blocks
+#                                now is not an unmodelled access but a
+#                                missing interrupt -- see "After the crank"
+#                                in docs/register-windows.md.
+#   0x017820230  pc 0x04028d310  SD vendor reg was classed write-only
+#   0x00f00001c  pc 0x040c1a624  UART port 1: the block has three ports
+#   0x015180014  pc 0x040c0aaf0  devices 0x1cc/0x1cd/0x1ce -> nikon-z63-dev1cc.h
+#   0x0160207f8  pc 0x040c5b314  CODEC, offsets at call sites -> nikon-z63-codec.h
+#   0x01510000c  pc 0x040c0d898  devices 0x1cf/0x1d0       -> nikon-z63-dev1cf.h
+#   0x015240044  pc 0x040c13970  pointer slot 0xa02dc3d88  -> nikon-z63-blk1524.h
+#   0x015000000  pc 0x040c2425c  pointer slot 0xa02dc47f0  -> nikon-z63-ispband.h
+#   0x015040000  pc 0x040c2383c  pointer slot 0xa02dc47d8  -> nikon-z63-ispband.h
+#   0x0153c0044  pc 0x040c24974  cleared by consolidating  -> nikon-z63-blkfam.h
+#   0x015440308  pc 0x040c25568  materialised constant     -> nikon-z63-blkfam.h
+#   0x015340014  pc 0x040c27ed0  devices 0x185/0x186       -> nikon-z63-blkfam.h
+#   0x015200000  pc 0x040c75c80  pointer at 0xa02e7b0c0    -> nikon-z63-vpipe-ctl.h
+#   0x00c86f014  pc 0x040c15e90  AUX pair                  -> nikon-z63-aux.h
+#   0x00e70073c  pc 0x040c14664  serial bus, instance 7    -> nikon-z63-spibus.h
+#   0x0150c0018  pc 0x040c1fd58  ISP_APB device 0x1a0      -> nikon-z63-isp-apb.h
+#   0x015080044  pc 0x040c2c9c4  sensor interface          -> nikon-z63-sensorif.h
diff --git a/z63-tools/handle_offsets.py b/z63-tools/handle_offsets.py
new file mode 100644
index 0000000..843487d
--- /dev/null
+++ b/z63-tools/handle_offsets.py
@@ -0,0 +1,410 @@
+#!/usr/bin/env python3
+"""Find every byte offset a driver applies to a device base it loads out of a
+descriptor field.
+
+    handle_offsets.py --port 8084 --range 0x40c2a000 0x40c2e000
+                      [--field 8] [--limit 0x5000] [--json out.json]
+                      [--window-base 0x0e700000] [--array-base 0xa02dc41a8]
+                      [--const-window 0x15440000 0x15450000]
+                      [--call-arg 0x40c5b300:0,0x40c5b2e8:0]
+
+Two base shapes occur. By default the device base is the descriptor field
+itself (`LDR Xn,[X0,#8]`). With --window-base, the base is a constant in the
+text and the descriptor field is an instance *index*:
+
+    MOV  X8, #0            ; \
+    MOVK X8, #0xe70,LSL#16 ;  > 0x0e700000
+    LDR  W9, [X0,#8]       ; the instance number
+    ADD  X9, X8, X9,LSL#8  ; base + index * 0x100
+    LDR  W10, [X9,#0x3c]!
+
+Offsets are then reported relative to one instance, which is what a QEMU
+window with a stride wants.
+
+With --array-base the base is loaded out of a runtime pointer array, which
+is the third shape and the one no static scan of the text can follow:
+
+    MOV  X9, #0x41a8          ; \
+    MOVK X9, #0x2dc,LSL#16    ;  > 0xa02dc41a8, a .data pointer array
+    MOVK X9, #0xa,LSL#32      ; /
+    LDR  W8, [X22,#4]         ; the instance index
+    LDR  X23, [X9,X8,LSL#3]   ; the device base
+    LDR  W8, [X23,#0x14]
+
+The array is filled at run time, so which base each slot holds is not in the
+image; what is in the image is that every register this driver touches is at
+one of the offsets it applies to such a pointer.
+
+--const-window is the fourth shape and the plainest: the whole register
+address is a materialised constant, and the driver does not go through a
+descriptor at all.
+
+    MOV  X8, #0x308
+    MOVK X8, #0x1544,LSL#16   ; 0x15440308, register and base in one
+    STR  WZR, [X8]
+    STR  WZR, [X8,#4]
+
+Every constant the dataflow builds whose value lands in the window counts as
+a register, as does every immediate-offset access through such a register.
+
+--call-arg is for the fifth shape, where the driver has one generic accessor
+pair and the register offset is an *argument*, so it appears at the call
+sites and not in the accessor at all:
+
+    sub_40C5B300:               a caller:
+      BL   sub_40C5B258           MOV  W0, #0x7f8
+      STR  W19, [X0,X20]          MOV  W1, ...
+                                  BL   sub_40C5B300
+
+Each `callee:reg` pair says which argument register of which callee holds the
+offset; every BL to that callee with a known constant in that register
+contributes one offset. Nothing is recorded for a call whose argument the
+dataflow cannot pin down, which is the usual trade: this finds the offsets
+the firmware names statically, not every offset it can reach.
+
+Several EXPEED 7 blocks are reached only through a descriptor: the base never
+appears as an immediate, and the driver is a family of tiny accessors that
+each start
+
+    LDR Xn, [X0,#8]          ; the device base, out of the handle
+
+and then apply a constant offset. This walks those functions and reports the
+offsets, so a QEMU register window can be built from what the firmware
+actually names rather than from guesses or from one VM stop at a time.
+
+Why this is a CFG analysis and not a linear scan
+------------------------------------------------
+The accessors are written as a branch or a CSEL chain picking one register
+out of several, and the chosen offset is applied in a block the scan reaches
+in address order rather than in execution order. sub_40C2BD0C is the case
+that forced this:
+
+    LDR  X8, [X0,#8]
+    CMP  W1, #2
+    B.EQ 0x40c2bd38
+    ADD  X9,  X8, #0x16c      <- false path
+    ADD  X10, X8, #0x22c
+    ADD  X8,  X8, #0x10c
+    CSEL X8, X10, X8, NE
+    CSEL X8, X9,  X8, EQ
+    B    0x40c2bd3c
+    ADD  X8,  X8, #0x1cc      <- true path, X8 is still the base here
+    STR  W2, [X8]             <- +0x10c, +0x16c, +0x1cc or +0x22c
+
+Walking that in address order applies the true path's +0x1cc to the register
+the false path just overwrote, which both loses the four real offsets and
+invents three that the firmware never touches. So the walk is a forward
+worklist over the basic-block graph, a register holds the *set* of offsets it
+may hold, and a join is a union -- a may-analysis, because the question is
+which offsets the firmware reaches for some argument.
+
+A register whose definition the walk cannot prove is dropped rather than
+guessed, and an offset outside --limit is discarded: a descriptor field is
+only this device's base, and the next instance's base bounds the window.
+"""
+import json, re, sys, collections, urllib.request
+
+ap = sys.argv[1:]
+def opt(name, default=None, n=1):
+    if name not in ap:
+        return default
+    i = ap.index(name)
+    return ap[i + 1] if n == 1 else ap[i + 1:i + 1 + n]
+
+port = opt("--port", "8084")
+lo, hi = (int(v, 0) for v in opt("--range", n=2))
+field = int(opt("--field", "8"), 0)
+limit = int(opt("--limit", "0x10000"), 0)
+out_json = opt("--json")
+window_base = opt("--window-base")
+window_base = int(window_base, 0) if window_base else None
+array_base = opt("--array-base")
+array_base = int(array_base, 0) if array_base else None
+call_args = {}
+if "--call-arg" in ap:
+    for spec in opt("--call-arg").split(","):
+        callee, reg = spec.split(":")
+        call_args[int(callee, 0)] = "X" + reg.strip()
+const_window = opt("--const-window", n=2) if "--const-window" in ap else None
+if const_window:
+    const_window = tuple(int(v, 0) for v in const_window)
+    limit = const_window[1] - const_window[0]
+
+def query(sql):
+    req = urllib.request.Request(f"http://localhost:{port}/query",
+                                 data=sql.encode(), method="POST")
+    with urllib.request.urlopen(req, timeout=600) as r:
+        res = json.load(r)["results"][0]
+    if res.get("error"):
+        sys.exit(f"idasql: {res['error']}")
+    return res["rows"]
+
+insns = collections.defaultdict(list)
+# CAST everywhere: idasql returns these columns as text, and a bare
+# numeric comparison against a text column silently matches nothing --
+# which showed up as an empty edge set and a dataflow that degraded to a
+# linear scan without saying so.
+for fa, a, dis in query(f"SELECT func_addr,addr,disasm FROM instructions "
+                        f"WHERE CAST(addr AS INTEGER)>={lo} "
+                        f"AND CAST(addr AS INTEGER)<{hi} ORDER BY addr"):
+    insns[int(fa)].append((int(a), ' '.join(dis.split())))
+
+blocks = collections.defaultdict(list)
+for fa, sa, ea, _ in query(f"SELECT func_addr,start_addr,end_addr,size FROM "
+                           f"blocks WHERE CAST(start_addr AS INTEGER)>={lo} "
+                           f"AND CAST(start_addr AS INTEGER)<{hi}"):
+    blocks[int(fa)].append((int(sa), int(ea)))
+
+succ = collections.defaultdict(list)
+# cfg_edges is a virtual table: it only yields rows for an *equality*
+# constraint on func_addr. A range predicate returns nothing at all, with
+# no error, which left the dataflow running with an empty edge set and
+# silently degraded it to the linear scan this tool exists to replace.
+fns = sorted(insns)
+for i in range(0, len(fns), 200):
+    chunk = ",".join(str(f) for f in fns[i:i + 200])
+    for fa, fb, tb, _ in query(f"SELECT func_addr,from_block,to_block,"
+                               f"edge_type FROM cfg_edges "
+                               f"WHERE func_addr IN ({chunk})"):
+        succ[int(fb)].append(int(tb))
+
+multi = [f for f in fns if len(blocks.get(f, [])) > 1]
+without = [f for f in multi if not any(b in succ for b, _ in blocks[f])]
+# The point of this check is the silent-degradation case, where the edge
+# query matched nothing at all and the dataflow quietly became the linear
+# scan this tool exists to replace. A handful of functions with no edges is
+# ordinary -- IDA does not always build a graph -- so the threshold is
+# proportional, and the few are named rather than fatal.
+if multi and len(without) > max(4, len(multi) // 10):
+    sys.exit(f"{len(without)} of {len(multi)} branching functions came back "
+             f"with no CFG edges (first {without[0]:#x}) -- refusing to "
+             f"report offsets from a dataflow with no graph")
+if without:
+    print(f"note: {len(without)} of {len(multi)} branching functions have no "
+          f"CFG edges (first {without[0]:#x}); they are walked in address "
+          f"order, so offsets attributed to them are the weaker kind")
+print(f"{len(fns)} functions, {len(multi)} with branches, "
+      f"{sum(len(v) for v in succ.values())} edges")
+
+IMM = r'#(-?0x[0-9A-Fa-f]+|-?\d+)'
+re_handle = re.compile(r'^LDR\s+(X\d+),\s*\[(X\d+),#%d\]$' % field)
+re_mov_r  = re.compile(r'^MOV\s+([WX]\d+),\s*([WX]\d+)$')
+re_mov_i  = re.compile(r'^(?:MOV|MOVZ)\s+([WX]\d+),\s*' + IMM + r'$')
+re_movk   = re.compile(r'^MOVK\s+([WX]\d+),\s*' + IMM + r'(?:,LSL#(\d+))?$')
+re_add_i  = re.compile(r'^(ADD|SUB)\s+(X\d+),\s*(X\d+),\s*' + IMM +
+                       r'(?:,LSL#(\d+))?$')
+re_add_r  = re.compile(r'^(ADD|SUB)\s+(X\d+),\s*(X\d+),\s*([WX]\d+)'
+                       r'(?:,\s*(?:LSL|UXTW|SXTW)\s*#?(\d+))?$')
+re_mem    = re.compile(r'^(LDR|STR|LDUR|STUR|LDRB|STRB|LDRH|STRH|LDP|STP)\s+'
+                       r'([WXwx]\d+|WZR|XZR)(?:,\s*(?:[WXwx]\d+|WZR|XZR))?'
+                       r',\s*\[(X\d+)(?:,\s*' + IMM + r')?\](?:,\s*' + IMM + r')?')
+re_csel   = re.compile(r'^(?:CSEL|CSINC|CSINV|CSNEG)\s+(X\d+),\s*(X\d+),\s*(X\d+),')
+re_defs   = re.compile(r'^[A-Z][A-Z0-9.]*\s+([WX]\d+)')
+
+def val(s):
+    return int(s, 16) if s.lower().lstrip('-').startswith('0x') else int(s)
+
+def x(r):
+    return 'X' + r[1:]
+
+hits = collections.defaultdict(set)
+
+def run_block(fa, body, state):
+    """Execute one basic block, record hits, return the outgoing state."""
+    base, const = dict(state[0]), dict(state[1])
+    for a, dis in body:
+        m = re_handle.match(dis)
+        if m:
+            base[m.group(1)] = frozenset({0})
+            const.pop(m.group(1), None)
+            continue
+        if array_base is not None:
+            # the index is optional: a block may be named by a single
+            # runtime pointer rather than by a slot in an array.
+            m = re.match(r'^LDR\s+(X\d+),\s*\[(X\d+)'
+                         r'(?:,\s*[WX]\d+(?:,\s*(?:LSL|UXTW|SXTW)\s*#?\d+)?)?'
+                         r'\]$', dis)
+            if m and const.get(m.group(2)) == array_base:
+                base[m.group(1)] = frozenset({0})
+                const.pop(m.group(1), None)
+                continue
+        m = re_mem.match(dis)
+        if m:
+            op, rt, rn, off, post = m.groups()
+            if rn in base:
+                size = {'LDRB': 1, 'STRB': 1, 'LDRH': 2, 'STRH': 2}.get(
+                    op, 4 if rt[0] in 'Ww' else 8)
+                kind = 'w' if op[0] == 'S' else 'r'
+                for b in base[rn]:
+                    o = b + (val(off) if off else 0)
+                    if 0 <= o < limit:
+                        hits[o].add((fa, a, kind, size))
+                if post:
+                    base[rn] = frozenset(b + val(post) for b in base[rn])
+            if op[0] == 'L':
+                base.pop(x(rt), None); const.pop(x(rt), None)
+            continue
+        m = re_add_i.match(dis)
+        if m:
+            op, rd, rn, imm, sh = m.groups()
+            k = val(imm) << (int(sh) if sh else 0)
+            if op == 'SUB':
+                k = -k
+            if window_base is not None and op == 'ADD' and \
+                    const.get(rn) == window_base:
+                base[rd] = frozenset({k})
+                const.pop(rd, None)
+                continue
+            if rn in base:
+                base[rd] = frozenset(b + k for b in base[rn])
+            else:
+                base.pop(rd, None)
+            if rn in const:
+                const[rd] = const[rn] + k
+            else:
+                const.pop(rd, None)
+            continue
+        m = re_add_r.match(dis)
+        if m:
+            op, rd, rn, rm, sh = m.groups()
+            if window_base is not None and op == 'ADD' and \
+                    const.get(rn) == window_base:
+                # base + index << k: the instance base, offset zero
+                base[rd] = frozenset({0})
+                const.pop(rd, None)
+                continue
+            k = None
+            if x(rm) in const:
+                k = const[x(rm)] << (int(sh) if sh else 0)
+                if op == 'SUB':
+                    k = -k
+            if rn in base and k is not None:
+                base[rd] = frozenset(b + k for b in base[rn])
+            elif x(rm) in base and rn in const and op == 'ADD':
+                base[rd] = frozenset(b + const[rn] for b in base[x(rm)])
+            else:
+                base.pop(rd, None)
+            const.pop(rd, None)
+            continue
+        m = re_mov_i.match(dis)
+        if m:
+            const[x(m.group(1))] = val(m.group(2))
+            base.pop(x(m.group(1)), None)
+            continue
+        m = re_movk.match(dis)
+        if m:
+            rd, imm, sh = x(m.group(1)), val(m.group(2)), int(m.group(3) or 0)
+            if rd in const:
+                const[rd] = (const[rd] & ~(0xffff << sh)) | (imm << sh)
+            base.pop(rd, None)
+            continue
+        m = re_mov_r.match(dis)
+        if m:
+            rd, rn = x(m.group(1)), x(m.group(2))
+            for d in (base, const):
+                if rn in d:
+                    d[rd] = d[rn]
+                else:
+                    d.pop(rd, None)
+            continue
+        m = re_csel.match(dis)
+        if m:
+            rd, rn, rm = m.groups()
+            if rn in base and rm in base:
+                base[rd] = base[rn] | base[rm]
+            else:
+                base.pop(rd, None)
+            const.pop(rd, None)
+            continue
+        if call_args:
+            # `B` as well as `BL`: these accessors are routinely tail
+            # called, and a tail call is a call. sub_40C5B368 writes two
+            # words, +0x7f8 with a BL and +0x7fc with a B, and matching only
+            # BL found the first and missed the second.
+            m = re.match(r'^BL?\s+(?:sub_|loc_)?([0-9A-Fa-fx]+)$', dis)
+            if m:
+                try:
+                    target = int(m.group(1), 16)
+                except ValueError:
+                    target = None
+                if target in call_args:
+                    reg = call_args[target]
+                    if reg in const and 0 <= const[reg] < limit:
+                        hits[const[reg]].add((fa, a, 'a', 4))
+                # a call clobbers the argument and result registers
+                for r in ('X0', 'X1', 'X2', 'X3', 'X4', 'X5', 'X6', 'X7'):
+                    base.pop(r, None); const.pop(r, None)
+                continue
+
+        m = re_defs.match(dis)
+        if m:
+            base.pop(x(m.group(1)), None); const.pop(x(m.group(1)), None)
+
+        if const_window:
+            lo_w, hi_w = const_window
+            for r, v in list(const.items()):
+                if lo_w <= v < hi_w:
+                    # the constant is itself a register address
+                    hits[v - lo_w].add((fa, a, 'c', 4))
+                    base[r] = frozenset({v - lo_w})
+    return (base, const)
+
+def join(a, b):
+    """May-analysis join: a register is base-derived if it is on any path in."""
+    out = []
+    for da, db in zip(a, b):
+        m = dict(da)
+        for r, v in db.items():
+            if r in m:
+                m[r] = (m[r] | v) if isinstance(v, frozenset) else (
+                    m[r] if m[r] == v else None)
+                if m[r] is None:
+                    del m[r]
+            else:
+                m[r] = v
+        out.append(m)
+    return tuple(out)
+
+for fa, body in sorted(insns.items()):
+    bl = sorted(blocks.get(fa, [])) or [(body[0][0], body[-1][0] + 4)]
+    code = {s: [(a, d) for a, d in body if s <= a < e] for s, e in bl}
+    entry = bl[0][0]
+    state = {entry: ({}, {})}
+    work = [entry]
+    seen = collections.Counter()
+    while work:
+        b = work.pop()
+        seen[b] += 1
+        if b not in code or seen[b] > 8:      # the bound is for loops
+            continue
+        out = run_block(fa, code[b], state[b])
+        for t in succ.get(b, []):
+            if t not in code:
+                continue
+            merged = join(state[t], out) if t in state else out
+            if t not in state or merged != state[t]:
+                state[t] = merged
+                work.append(t)
+
+what = (f"passed as an argument to {len(call_args)} accessor(s)" if call_args else
+        f"materialised in [{const_window[0]:#x},{const_window[1]:#x})"
+        if const_window else
+        f"off the instance base of {window_base:#x}" if window_base is not None
+        else f"off a base loaded from the array at {array_base:#x}"
+        if array_base is not None
+        else f"off [handle+{field}]")
+print(f"{len(hits)} distinct offsets {what} below {limit:#x}, "
+      f"from {len(insns)} functions in [{lo:#x},{hi:#x})")
+res = {}
+for off in sorted(hits):
+    s = hits[off]
+    res[hex(off)] = {
+        "kinds": sorted({k for _, _, k, _ in s}),
+        "funcs": sorted({hex(f) for f, _, _, _ in s}),
+    }
+if out_json:
+    json.dump(res, open(out_json, "w"), indent=1)
+    print("wrote", out_json)
+else:
+    for off, v in res.items():
+        print(f"  +{off:>8s}  {''.join(v['kinds']):2s}  {len(v['funcs'])} fn")
diff --git a/z63-tools/make_window.py b/z63-tools/make_window.py
new file mode 100644
index 0000000..e602121
--- /dev/null
+++ b/z63-tools/make_window.py
@@ -0,0 +1,162 @@
+#!/usr/bin/env python3
+"""Turn a block's firmware evidence into a QEMU register-window header.
+
+    make_window.py --name AUX --macro Z63_AUX --file nikon-z63-aux.h \
+                   --base 0x0c86e000 --stride 0x1000 --instances 2 \
+                   --range 0x40c15000 0x40c17000 [--port 8084] [--field 8]
+                   [--note "a sentence the generator cannot know"]
+                   [--const-window]   # the base is a materialised constant
+
+It runs handle_offsets.py in whichever base mode fits (a descriptor base by
+default, a constant window base when --stride is given and the firmware
+indexes the array), writes the offset arrays, and records in the header how
+the set was obtained, how many functions it came from, and which offsets the
+firmware only reads -- the ones where storage is a declared choice rather
+than the firmware's own expectation.
+
+What it deliberately does not do is claim to know what the block is. That
+sentence is for a person to write, with --note or by editing afterwards.
+"""
+import json, subprocess, sys, os, tempfile
+
+ap = sys.argv[1:]
+def opt(name, default=None, n=1):
+    if name not in ap:
+        return default
+    i = ap.index(name)
+    return ap[i + 1] if n == 1 else ap[i + 1:i + 1 + n]
+
+name      = opt("--name")
+array     = opt("--array-base")
+macro     = opt("--macro")
+outfile   = opt("--file")
+base      = int(opt("--base"), 0)
+stride    = int(opt("--stride", "0"), 0)
+instances = int(opt("--instances", "1"), 0)
+lo, hi    = (int(v, 0) for v in opt("--range", n=2))
+port      = opt("--port", "8084")
+field     = opt("--field", "8")
+note      = opt("--note", "")
+constwin  = "--const-window" in ap
+span      = stride if stride else int(opt("--size", hex(0x1000)), 0)
+size      = stride * instances if stride else span
+
+here = os.path.dirname(os.path.abspath(__file__))
+tmp = tempfile.NamedTemporaryFile(suffix=".json", delete=False).name
+cmd = [sys.executable, "-I", os.path.join(here, "handle_offsets.py"),
+       "--port", port, "--range", hex(lo), hex(hi),
+       "--limit", hex(span), "--field", field, "--json", tmp]
+if constwin:
+    cmd += ["--const-window", hex(base), hex(base + size)]
+elif stride and not array:
+    cmd += ["--window-base", hex(base)]
+if array:
+    cmd += ["--array-base", array]
+print(" ".join(cmd))
+how = subprocess.run(cmd, capture_output=True, text=True)
+sys.stdout.write(how.stdout)
+if how.returncode:
+    sys.exit(how.stderr or "handle_offsets.py failed")
+
+off = json.load(open(tmp))
+all_items = sorted(int(k, 16) for k in off)
+# the window serves 4-byte accesses, so only 4-aligned offsets go in the
+# bitmap; a byte or halfword access to one of the others would stop, which
+# is the right outcome -- it would mean this window needs a wider model.
+unaligned = [o for o in all_items if o & 3]
+items = [o for o in all_items if not (o & 3)]
+ro = sorted(int(k, 16) for k, v in off.items()
+            if v["kinds"] == ["r"] and not (int(k, 16) & 3))
+nfun = len({f for v in off.values() for f in v["funcs"]})
+if not items:
+    sys.exit("no offsets found -- check the code range and the base mode")
+
+def fmt(l, per=8):
+    return "\n".join("    " + " ".join(f"0x{o:04x}," for o in l[i:i + per])
+                     for i in range(0, len(l), per))
+
+mode = (f"--const-window, so the whole register address is a materialised\n"
+        f" * constant in the text and the driver does not go through a descriptor\n"
+        f" * at all; the offsets below are those constants minus {base:#x}"
+        if constwin else
+        f"--array-base {array}, so the base is loaded out of a runtime\n"
+        f" * pointer array. That array's slots are filled at run time and hold the\n"
+        f" * bases of several device types, so this offset set is the union over all\n"
+        f" * of them and is wider than this block's own register file. Modelling a\n"
+        f" * register here that belongs to a sibling costs nothing -- nothing else\n"
+        f" * maps this window -- but it can mask an access worth seeing, so this is\n"
+        f" * the first block to re-derive if something here looks wrong"
+        if array else
+        f"--window-base {base:#x}, so the firmware builds the array base as a\n"
+        f" * constant and indexes it; offsets below are one instance's and apply at\n"
+        f" * all {instances}, {stride:#x} apart"
+        if stride else
+        f"the device base arrives in a descriptor field at +{int(field, 0)}, so the\n"
+        f" * offsets below are what the driver applies to it")
+
+guard = "HW_ARM_" + os.path.basename(outfile).replace('-', '_').replace('.', '_').upper()
+lname = name.lower().replace('-', '_')
+
+hdr = f'''/*
+ * Nikon Z 6III -- the {name} block at {base:#x}.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Generated by z63-tools/make_window.py from `eg2010_0200i1.bi` (md5
+ * b024ec7148e24ec0493e27d4d0f20b0e), read through the IDA database
+ * `z63_eg.elf` (md5 0fedcc0523da1dac8127a8010ccf978b) -- the database that
+ * matches the shipped image. `vr2070.elf` is a different image whose
+ * register layout is nearly identical and whose function addresses mostly
+ * agree, which makes reading this image's PCs through it produce plausible,
+ * wrong answers.
+{(" *" + chr(10) + " * " + note + chr(10)) if note else ""} *
+ * The register set
+ * ----------------
+ * {len(items)} offsets, highest {items[-1]:#05x}, from {nfun} functions in
+ * {lo:#x}-{hi:#x}. Extracted with {mode}.
+ *
+ * The extraction is a forward dataflow over the basic-block graph, not a
+ * scan in address order: these accessors pick an offset with a branch or a
+ * CSEL chain, and an address-order walk applies one path's offset to a
+ * register another path overwrote. See the header of handle_offsets.py.
+ *
+ * What is a declared choice
+ * -------------------------
+ * Storage. Where the firmware read-modify-writes a register, reading back
+ * what was written is its own stated expectation, not an invention.
+ *
+ * {len(ro)} of these offsets are only ever read, never written -- the shape of a
+ * status register. For those, storage is a DECLARED CHOICE: this model
+ * returns the reset value and nothing here knows what the hardware would
+ * report. A firmware poll on a bit real silicon raises would hang rather
+ * than stop, and z63-tools/where_blocked.py is the instrument for that.
+ *
+ * An offset not in this set still stops the machine with its PC, which is
+ * the only way the next one gets found.
+ */
+
+#ifndef {guard}
+#define {guard}
+
+#define {macro}_BASE    {base:#010x}ULL
+#define {macro}_SIZE    {size:#06x}
+#define {macro}_STRIDE  {stride:#06x}
+
+static const uint16_t z63_{lname}_offsets[] = {{
+{fmt(items)}
+}};
+
+/* Only ever read by the firmware -- the declared choice above. */
+static const uint16_t z63_{lname}_status_offsets[] = {{
+{fmt(ro)}
+}};
+
+#endif /* {guard} */
+'''
+open(os.path.join(here, "..", "hw", "arm", outfile), "w").write(hdr)
+os.unlink(tmp)
+print(f"wrote hw/arm/{outfile}: {len(items)} offsets, {len(ro)} read-only, "
+      f"{nfun} functions")
+print("offsets:", " ".join(hex(o) for o in items))
+if unaligned:
+    print("not 4-aligned, left out:", " ".join(hex(o) for o in unaligned))
diff --git a/z63-tools/mmio_scan.py b/z63-tools/mmio_scan.py
new file mode 100755
index 0000000..3158500
--- /dev/null
+++ b/z63-tools/mmio_scan.py
@@ -0,0 +1,214 @@
+#!/usr/bin/env python3
+"""Which MMIO pages does the Z 6III RTOS image reference, and which are mapped?
+
+A linear decode of the EG image's text for the three ways an AArch64 build
+materialises a device address -- MOVZ/MOVK sequences, ADRP, and 64-bit literal
+pool loads -- keeping every value inside the SoC's peripheral band. Counts are
+per 4 KiB page, the granularity a QEMU memory region is mapped at, and count
+distinct code sites, so one busy loop cannot outvote a whole subsystem.
+
+The board's own address map is parsed out of hw/arm/nikon-z63.c, so the gap
+list stays correct as regions are added.
+
+Two limits worth knowing. A count measures how often an absolute address in
+that page is *built*, which is not the same as how often the block is used: a
+driver that keeps its base in a struct and adds offsets shows up once. And a
+page with no count is not necessarily unused -- it may be reached entirely
+through such a base. Treat the list as a ranking of leads, not a census.
+
+    z63-tools/mmio_scan.py <eg2010_0200i1.bi> [--board hw/arm/nikon-z63.c]
+"""
+import argparse, bisect, collections, json, pathlib, re, struct, sys
+
+IMAGE_BASE = 0x40160000
+# bootstrap 0..0x8000, text 0x8000..+0x16de40c, from the component's own SOLID
+# descriptor at EG 0x8000.
+TEXT = (0x8000, 0x8000 + 0x16de40c)
+# The peripheral band. The board's lowest region is the boot ROM page at
+# 0x08201000 and the device tree declares nothing below it; every hit under
+# 0x08000000 in practice was a plain integer constant, not an address.
+BAND = (0x08000000, 0x20000000)
+# Initialised data, from the same SOLID descriptor. Peripheral bases that a
+# driver keeps in a struct never appear as an instruction immediate, so a
+# text-only scan cannot see them at all -- which is how an earlier version of
+# this script concluded that the Z 8 board's display bases were unused here,
+# when 0x15480000 and 0x15C80000 are in fact reached through the descriptor at
+# VA 0xA02808438. Scanning .data for band-valued pointers finds those.
+DATA = (0x5099000, 0x5099000 + 0x3d5021)
+DATA_VA = 0xa02808000
+
+
+def board_regions(path):
+    """(name, base) for every Z63_*BASE-looking constant in the board."""
+    text = pathlib.Path(path).read_text()
+    defs = {}
+    for m in re.finditer(r'#define\s+(Z63_[A-Z0-9_]+)\s+(0x[0-9a-fA-F]+)(?:ULL)?',
+                         text):
+        defs[m.group(1)] = int(m.group(2), 16)
+    for m in re.finditer(r'#define\s+(Z63_[A-Z0-9_]+)\s+\(([^)]*)\)', text):
+        expr = m.group(2).replace('MiB', '*1048576').replace('KiB', '*1024')
+        try:
+            defs[m.group(1)] = int(eval(expr, {}, dict(defs)))
+        except Exception:
+            pass
+    picked = [(v, n) for n, v in defs.items()
+              if BAND[0] <= v < BAND[1] and
+              ('BASE' in n or 'MAGIC' in n or 'ENTRY' in n)]
+    # Sorted by base, because the caller bisects on it.
+    # Bases that live in an array rather than a #define -- the main DMA banks
+    # are declared as z63_dma_bases[], and a *_BASE-only scan reports them as
+    # gaps.
+    for m in re.finditer(r'(\w+)\s*\[[^\]]*\]\s*=\s*\{([^}]*)\}', text):
+        name = m.group(1)
+        for hexv in re.findall(r'0x[0-9a-fA-F]{6,9}', m.group(2)):
+            v = int(hexv, 16)
+            if BAND[0] <= v < BAND[1]:
+                picked.append((v, name + '[]'))
+    return [(n, v) for v, n in sorted(set(picked))]
+
+
+def data_pointers(path):
+    """page -> {VA in .data holding a pointer into it}"""
+    d = pathlib.Path(path).read_bytes()
+    out = collections.defaultdict(set)
+    lo, hi = DATA
+    for off in range(lo, min(hi, len(d) - 8), 8):
+        v = struct.unpack_from('<Q', d, off)[0]
+        if BAND[0] <= v < BAND[1] and v % 4 == 0:
+            out[v & ~0xfff].add(DATA_VA + (off - lo))
+    return out
+
+
+def sites(path):
+    """page -> {code address where a materialisation of it starts}
+
+    Keyed on where the sequence *starts*, not on the instruction that happens
+    to complete the value. A 64-bit address is built as MOVZ + MOVK x3, and
+    the value is already in the peripheral band after the second instruction,
+    so counting every instruction that leaves it in band counts one
+    materialisation three times -- which is exactly what an earlier version of
+    this script did, inflating every figure in docs/mmio-coverage.md by about
+    3x. Recording the run's first instruction collapses them to one.
+    """
+    d = pathlib.Path(path).read_bytes()
+    out = collections.defaultdict(set)
+    wide = {}
+    start = {}          # register -> VA where its current run began
+    pending = {}        # register -> (value, run start) not yet flushed
+    lo, hi = TEXT
+    for off in range(lo, min(hi, len(d) - 8), 4):
+        w = struct.unpack_from('<I', d, off)[0]
+        va = IMAGE_BASE + off
+        value = None
+        rd = None
+        if (w & 0x7f800000) == 0x52800000:                 # MOVZ: run begins
+            rd = w & 0x1f
+            wide[rd] = ((w >> 5) & 0xffff) << (16 * ((w >> 21) & 3))
+            start[rd] = va
+            value = wide[rd]
+        elif (w & 0x7f800000) == 0x72800000:               # MOVK: run continues
+            rd = w & 0x1f
+            shift = 16 * ((w >> 21) & 3)
+            wide[rd] = (wide.get(rd, 0) & ~(0xffff << shift)) | \
+                       (((w >> 5) & 0xffff) << shift)
+            start.setdefault(rd, va)
+            value = wide[rd]
+        elif (w & 0x9f000000) == 0x90000000:               # ADRP: run begins
+            rd = w & 0x1f
+            imm = (((w >> 5) & 0x7ffff) << 2) | ((w >> 29) & 3)
+            if imm >> 20:
+                imm -= 1 << 21
+            wide[rd] = (va & ~0xfff) + imm * 4096
+            start[rd] = va
+        elif (w & 0xff000000) == 0x58000000:               # LDR literal
+            rd = w & 0x1f
+            imm = (w >> 5) & 0x7ffff
+            if imm >> 18:
+                imm -= 1 << 19
+            pool = va + imm * 4 - IMAGE_BASE
+            if 0 <= pool + 8 <= len(d):
+                value = struct.unpack_from('<Q', d, pool)[0]
+                start[rd] = va
+        # A register address is 4-byte aligned -- both blocks reversed so far
+        # are accessed only with LDR W / STR W. Without this filter the
+        # ranking fills up with plain integers that merely look like
+        # addresses: 0x10000000 is 256 MiB, 0x10624DD3 is a division
+        # reciprocal, and 0x15555555 is another. Each was referenced by
+        # hundreds of functions and ranked near the top.
+        # Only a *completed* run counts. A 64-bit DRAM address is built low
+        # half first, so 0xA1AA00000 passes through 0x1AA00000 -- which looks
+        # exactly like a peripheral address until the `MOVK #0xA,LSL#32`
+        # arrives. An earlier version recorded every intermediate value and
+        # so reported the USB gadget's DMA buffers in DRAM as an MMIO
+        # register file. Buffer the candidate per register and flush it only
+        # when the run ends.
+        if value is not None:
+            pending[rd] = (value, start.get(rd, va))
+        elif rd is not None:
+            pending.pop(rd, None)
+        for reg, (v, site) in list(pending.items()):
+            if reg == rd:
+                continue                      # run may still continue
+            if BAND[0] <= v < BAND[1] and v % 4 == 0:
+                out[v & ~0xfff].add(site)
+            pending.pop(reg)
+    for reg, (v, site) in pending.items():
+        if BAND[0] <= v < BAND[1] and v % 4 == 0:
+            out[v & ~0xfff].add(site)
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('image')
+    ap.add_argument('--board', default='hw/arm/nikon-z63.c')
+    ap.add_argument('--span', type=lambda s: int(s, 0), default=0x100000,
+                    help='how far above a declared base a page still counts as '
+                         'covered (default 1 MiB; generous on purpose, so the '
+                         'gap list under-reports rather than invents)')
+    ap.add_argument('--top', type=int, default=40)
+    ap.add_argument('--json')
+    args = ap.parse_args()
+
+    regions = board_regions(args.board)
+    bases = [b for _n, b in regions]
+
+    def covered(page):
+        i = bisect.bisect_right(bases, page) - 1
+        if i < 0 or page - bases[i] > args.span:
+            return None
+        name, base = regions[i]
+        return name if base & ~0xfff == page else name + '+'
+
+    pages = sites(args.image)
+    pointers = data_pointers(args.image)
+    rows = sorted(((len(r), p, covered(p)) for p, r in pages.items()),
+                  reverse=True)
+    pointer_only = sorted(p for p in pointers if p not in pages)
+    gaps = [r for r in rows if r[2] is None]
+    print("board regions in the band : %d" % len(regions))
+    print("MMIO pages referenced     : %d" % len(rows))
+    print("covered by a region       : %d" % (len(rows) - len(gaps)))
+    print("not covered               : %d" % len(gaps))
+    print("\n%-7s %-13s %s" % ("sites", "page", "nearest board region"))
+    for n, page, name in rows[:args.top]:
+        print("%-7d %#011x %s" % (n, page, name or '-'))
+    print("\npages reached only through an initialised .data pointer, so "
+          "invisible to the text scan: %d" % len(pointer_only))
+    for page in pointer_only[:args.top]:
+        holders = sorted(pointers[page])
+        print("%-7s %#011x %-22s held at %s"
+              % ('ptr', page, covered(page) or '-',
+                 ", ".join("%#x" % h for h in holders[:3])))
+    if args.json:
+        pathlib.Path(args.json).write_text(json.dumps(
+            {'regions': [{'name': n, 'base': '%#x' % b} for n, b in regions],
+             'pages': [{'page': '%#x' % p, 'sites': n, 'region': c}
+                       for n, p, c in rows],
+             'pointer_only': [{'page': '%#x' % p, 'region': covered(p),
+                               'held_at': ['%#x' % h for h in sorted(pointers[p])]}
+                              for p in pointer_only]}, indent=1))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/z63-tools/region_table.py b/z63-tools/region_table.py
new file mode 100755
index 0000000..4165233
--- /dev/null
+++ b/z63-tools/region_table.py
@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+"""Decode the SoC's own physical memory region table out of the eg image.
+
+The image carries the map: 29 entries at `.data` VA 0xA02BD2380, stride 0x28,
+fields {start, size, attr, name*, start}. The name field is a `.data` VA, so
+it needs the init delta to reach the file -- the same 0x9BD60F000 that turns a
+RAM pointer in a static initialiser back into a NOR offset.
+
+It is a better naming key than any address scan, for two reasons: it covers
+address space rather than interrupt lines, and it self-validates. `TOP`,
+`UART` and `NoC` land on bases the board had already chosen independently, and
+entries 15/16/17 reproduce the image window and the load base exactly.
+
+With --pages <mmio_scan json> it labels each page in that scan with the region
+it falls in, which is the work list for modelling.
+
+    z63-tools/region_table.py <eg2010_0200i1.bi> [--pages scan.json]
+"""
+import argparse, json, pathlib, struct
+
+IMAGE_BASE = 0x40160000
+TABLE = 0x455C3380            # flat; = .data VA 0xA02BD2380
+INIT_DELTA = 0x9BD60F000      # .data VA - this = flat/NOR offset
+COUNT = 29
+STRIDE = 0x28
+# Inferred from how the entries group, not from documentation.
+ATTR = {0: 'RAM', 2: 'exec image', 4: 'ROM/flash', 0x80000000: 'device'}
+
+
+def decode(path):
+    eg = pathlib.Path(path).read_bytes()
+
+    def name(data_va):
+        off = data_va - INIT_DELTA - IMAGE_BASE
+        if 0 <= off < len(eg):
+            return eg[off:off + 28].split(b'\0')[0].decode('ascii', 'replace')
+        return '?'
+
+    rows = []
+    for i in range(COUNT):
+        start, size, attr, namep, _again = struct.unpack_from(
+            '<5Q', eg, TABLE - IMAGE_BASE + i * STRIDE)
+        rows.append({'index': i, 'start': start, 'size': size, 'end': start + size,
+                     'attr': attr, 'attr_name': ATTR.get(attr, '%#x' % attr),
+                     'name': name(namep)})
+    return rows
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('image')
+    ap.add_argument('--pages', help='mmio_scan.py --json output to label')
+    ap.add_argument('--json')
+    args = ap.parse_args()
+    rows = decode(args.image)
+
+    chained = sum(1 for a, b in zip(rows, rows[1:]) if a['end'] == b['start'])
+    print("%-3s %-13s %-13s %-13s %-11s %s"
+          % ("#", "start", "end", "size", "attr", "name"))
+    for r in rows:
+        print("%-3d %#012x  %#012x  %#012x  %-11s %s"
+              % (r['index'], r['start'], r['end'], r['size'],
+                 r['attr_name'], r['name']))
+    print("\n%d entries, %d of %d adjacencies chain exactly"
+          % (len(rows), chained, len(rows) - 1))
+
+    if args.pages:
+        scan = json.loads(pathlib.Path(args.pages).read_text())
+        def region(page):
+            for r in rows:
+                if r['start'] <= page < r['end']:
+                    return r
+            return None
+        gaps = [(p['sites'], int(p['page'], 16)) for p in scan['pages']
+                if p['region'] is None]
+        gaps.sort(reverse=True)
+        print("\nunmodelled pages, labelled by the SoC's own region:")
+        print("%-7s %-13s %-11s %s" % ("sites", "page", "attr", "region"))
+        for sites, page in gaps:
+            r = region(page)
+            print("%-7d %#012x %-11s %s"
+                  % (sites, page, r['attr_name'] if r else '-',
+                     r['name'] if r else 'OUTSIDE every declared region'))
+    if args.json:
+        pathlib.Path(args.json).write_text(json.dumps(rows, indent=1))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/z63-tools/rsp.py b/z63-tools/rsp.py
new file mode 100755
index 0000000..571ef64
--- /dev/null
+++ b/z63-tools/rsp.py
@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+"""Minimal GDB-remote client: break at an address, report the argument registers.
+
+QEMU's gdbstub is the only instrument that answers "what value was this
+called with" for code the image reaches through a runtime-built vtable, which
+is most of the application. Static analysis cannot follow those calls.
+
+    rsp.py <port> <break addr> [more addrs ...] [--hits N]
+    rsp.py <port> --write <addr>=<u32> [<addr>=<u32> ...] [--run SECONDS]
+
+--write goes through the guest address space, so it reaches device models the
+same way a guest store would. It is for testing a model against a layout
+taken from documentation -- programming a register file by hand and seeing
+whether the model accepts it -- and never for making the guest appear to work.
+"""
+import socket, sys, time
+
+class Rsp:
+    def __init__(self, port):
+        self.s = socket.create_connection(("127.0.0.1", port), timeout=180)
+        self.buf = b""
+    def send(self, cmd):
+        pkt = b"$" + cmd + b"#%02x" % (sum(cmd) & 0xff)
+        self.s.sendall(pkt)
+        while True:
+            c = self.s.recv(1)
+            if c == b"+":
+                break
+            if not c:
+                raise EOFError
+    def recv(self):
+        while True:
+            i = self.buf.find(b"#")
+            if i >= 0 and len(self.buf) >= i + 3:
+                body = self.buf[1:i]
+                self.buf = self.buf[i + 3:]
+                self.s.sendall(b"+")
+                return body
+            d = self.s.recv(65536)
+            if not d:
+                raise EOFError
+            self.buf += d
+    def cmd(self, c):
+        self.send(c)
+        return self.recv()
+
+argv = sys.argv[1:]
+hits = 1
+if "--hits" in argv:
+    i = argv.index("--hits")
+    hits = int(argv[i + 1])
+    del argv[i:i + 2]
+args = argv
+writes = []
+if "--write" in argv:
+    i = argv.index("--write")
+    rest = argv[i + 1:]
+    del argv[i:]
+    for spec in rest:
+        if spec.startswith("--"):
+            break
+        a, v = spec.split("=")
+        writes.append((int(a, 0), int(v, 0)))
+    args = argv
+run_for = 0.0
+if "--run" in sys.argv:
+    run_for = float(sys.argv[sys.argv.index("--run") + 1])
+
+port = int(args[0]); addrs = [int(a, 0) for a in args[1:]]
+
+r = Rsp(port)
+r.cmd(b"qSupported:multiprocess+")
+if writes:
+    for a, v in writes:
+        payload = v.to_bytes(4, "little").hex().encode()
+        resp = r.cmd(b"M%x,4:%s" % (a, payload))
+        print(f"write {a:#x} = {v:#x}: {resp.decode() or 'empty'}")
+    r.send(b"c")
+    if run_for:
+        time.sleep(run_for)
+    sys.exit(0)
+print("stopped at attach:", r.cmd(b"?").decode())
+for a in addrs:
+    resp = r.cmd(b"Z0,%x,4" % a)
+    print(f"breakpoint at {a:#x}: {resp.decode() or 'OK(empty)'}")
+seen_x0 = {}
+printed = set()
+for n in range(hits):
+    r.send(b"c")
+    stop = r.recv().decode()
+    g = r.cmd(b"g").decode()
+    regs = [int.from_bytes(bytes.fromhex(g[i*16:(i+1)*16]), "little") for i in range(34)]
+    pc = regs[32]
+    seen_x0.setdefault(regs[0], 0)
+    seen_x0[regs[0]] += 1
+    if n < 4 or regs[0] not in printed:
+        printed.add(regs[0])
+        print(f"hit {n}: stop={stop[:24]} pc={pc:#x}")
+        print("   x0=%#x x1=%#x x2=%#x x3=%#x" % tuple(regs[0:4]))
+        print("   x19=%#x x20=%#x x21=%#x lr=%#x" % (regs[19], regs[20], regs[21], regs[30]))
+print("distinct x0 values seen:", {hex(k): v for k, v in sorted(seen_x0.items())})
diff --git a/z63-tools/scanout_check.sh b/z63-tools/scanout_check.sh
new file mode 100755
index 0000000..80df593
--- /dev/null
+++ b/z63-tools/scanout_check.sh
@@ -0,0 +1,54 @@
+#!/bin/sh
+# Does the LCD scanout model work?
+#
+# The firmware has not programmed the display controller yet, so the machine
+# alone cannot answer this: nikon-z63-scanout.h correctly refuses to produce a
+# frame and says which register is missing. That is the right behaviour and it
+# is also untestable on its own.
+#
+# So this programs the controller by hand, over the gdbstub, with the minimum
+# tuple that ../n-research/z8-qemu's docs/native-lcd-minimum-tuple.md
+# established from the Z 8 image -- mode 0, 1024x682, format 0, one ROI slot,
+# a DMA address in DRAM and a 4096-byte stride -- and asserts that the model
+# accepts it and reports a first frame.
+#
+# This tests the *model* against a documented layout. It does not make the
+# guest work and it is not part of smoke.sh, because a frame produced from
+# registers a human wrote is not evidence about the firmware.
+#
+#   z63-tools/scanout_check.sh <components-dir> [port]
+set -e
+cd "$(dirname "$0")/.."
+DIR=${1:?usage: scanout_check.sh <components-dir> [port]}
+PORT=${2:-45699}
+EG="$DIR/eg2010_0200i1.bi"
+QEMU=./build/qemu-system-aarch64
+[ -x "$QEMU" ] || { echo "no $QEMU -- build first"; exit 1; }
+
+RUN=$(mktemp -d)
+trap 'pkill -f "machine nikon-z63" 2>/dev/null; rm -rf "$RUN"' EXIT
+
+"$QEMU" -machine nikon-z63,rom-page-stub=on -cpu cortex-a53 -smp 4 \
+    -bios "$EG" -serial null -monitor none -display none \
+    -gdb "tcp::$PORT" > "$RUN/log" 2>&1 &
+sleep 40
+
+B=$((0x15480000))
+python3 -I z63-tools/rsp.py "$PORT" --write \
+    $((B + 0x15cc))=0 $((B + 0x1530))=0 \
+    $((B + 0x132c))=1024 $((B + 0x1328))=682 \
+    $((B + 0x2200))=0 $((B + 0x2208))=0 \
+    $((B + 0x2400))=$((1024 | (682 << 16))) \
+    $((B + 0x2440))=0x0a000000 $((B + 0x2444))=0xa \
+    $((B + 0x2580))=4096 $((B + 0x2600))=0 \
+    $((B + 0x2640))=1 --run 6 > "$RUN/writes" 2>&1
+
+sleep 2
+if grep -q 'Z63_SCANOUT: first frame' "$RUN/log"; then
+    echo "ok -- $(grep 'first frame' "$RUN/log" | sed 's/.*first frame -- //')"
+    echo "PASS"
+else
+    echo "FAIL -- the model did not accept the documented minimum tuple."
+    grep Z63_SCANOUT "$RUN/log" | tail -3
+    exit 1
+fi
diff --git a/z63-tools/smoke.sh b/z63-tools/smoke.sh
new file mode 100755
index 0000000..c51c93a
--- /dev/null
+++ b/z63-tools/smoke.sh
@@ -0,0 +1,112 @@
+#!/bin/sh
+# Regression for the Z 6III research machine. One command, three checks.
+#
+#   1. The RTOS stops at the recorded frontier and nowhere earlier.
+#   2. Linux reaches a BusyBox prompt on CPU3 -- but only once the RTOS has
+#      no frontier left. While the crank is still turning this is skipped,
+#      not failed: a refused access stops the whole machine, so the Linux
+#      core never gets its chance, and that is a fact about where the RTOS
+#      has got to rather than anything wrong with the Linux side.
+#
+# A device model that is correct but never exercised shows up as "no change"
+# here, which is the expected result for anything on a path the booting
+# firmware does not take. A model that is *wrong* about an offset the firmware
+# does touch shows up as a stop with a PC, which is the point.
+#
+# During Phase 2 the RTOS always stops somewhere: a stop is how the crank
+# turns. So "no stop at all" is not the pass condition and never will be
+# until the crank reaches the end. What this checks instead is that the stop
+# is the one we already know about -- the address in z63-tools/frontier. A
+# stop at any other address is news, and needs a person to decide whether the
+# frontier moved forward or a model that used to work stopped working. When
+# it has moved forward, write the new address into that file as part of the
+# same change that moved it.
+#
+# The Linux check is the exit condition of the RTOS work, not a gate on it.
+# It runs when the frontier file records no address.
+#
+# The loader matters: without it the firmware's own boot-ROM service page
+# branches into 0x40000000-0x40160000 and finds nothing. Pass it in LOADER
+# (a dump of the window from 0x40000000); the board then needs no stub.
+#
+#   LOADER=../nikon/out/z63/rtos/eg_z63_0x40000000.bin \
+#       z63-tools/smoke.sh <components-dir> [seconds]
+set -e
+cd "$(dirname "$0")/.."
+DIR=${1:?usage: smoke.sh <dir holding eg2010_0200i1.bi and li2010_0200i1.bi> [seconds]}
+WAIT=${2:-180}
+EG="$DIR/eg2010_0200i1.bi"
+LI="$DIR/li2010_0200i1.bi"
+if [ -n "${LOADER:-}" ] && [ -f "$LOADER" ]; then
+    OPT="loader=$LOADER"
+else
+    OPT="rom-page-stub=on"
+    echo "note: no LOADER=<dump of 0x40000000>; falling back to the stub."
+fi
+QEMU=./build/qemu-system-aarch64
+[ -x "$QEMU" ] || { echo "no $QEMU -- build first"; exit 1; }
+[ -f "$EG" ] || { echo "no $EG"; exit 1; }
+
+RUN=$(mktemp -d)
+trap 'pkill -f "machine nikon-z63" 2>/dev/null; rm -rf "$RUN"' EXIT
+
+echo "== 1/2  RTOS alone"
+"$QEMU" -machine "nikon-z63,$OPT" -cpu cortex-a53 -smp 4 \
+    -bios "$EG" -serial null -monitor none -display none \
+    -qmp "unix:$RUN/q1.sock,server=on,wait=off" > "$RUN/rtos.log" 2>&1 &
+RTOS=$!
+sleep 45
+kill $RTOS 2>/dev/null || true
+wait $RTOS 2>/dev/null || true
+FRONTIER=$(sed -n 's/^frontier *//p' z63-tools/frontier 2>/dev/null | head -1)
+GOT=$(grep -oE 'addr=0x[0-9a-f]+' "$RUN/rtos.log" | head -1 | cut -d= -f2)
+if [ -z "$GOT" ]; then
+    echo "   ok -- nothing stopped in 45s (the crank has run out of blockers)"
+elif [ "$GOT" = "$FRONTIER" ]; then
+    echo "   ok -- stopped at the recorded frontier $GOT, and nowhere earlier"
+else
+    echo "   FAIL -- stopped at $GOT, not the recorded frontier ${FRONTIER:-<unset>}:"
+    grep 'stopping (unmodeled device\|unmodeled read\|unmodeled write' \
+        "$RUN/rtos.log" | head -3
+    echo "   If the frontier moved forward, record it in z63-tools/frontier."
+    exit 1
+fi
+
+[ -f "$LI" ] || { echo "== 2/2  skipped, no $LI"; exit 0; }
+
+if [ -n "$FRONTIER" ]; then
+    echo "== 2/2  skipped -- the RTOS still stops at $FRONTIER, so a whole-"
+    echo "        machine stop reaches CPU3 before Linux can print. This"
+    echo "        check is the exit condition of the RTOS crank, not a gate"
+    echo "        on it; clear the frontier line to turn it back on."
+    echo
+    echo "PASS"
+    exit 0
+fi
+
+echo "== 2/2  RTOS + LI payload, expecting a shell"
+"$QEMU" -machine "nikon-z63,$OPT,li-image=$LI,cpu3-entry=0xa07800000" \
+    -cpu cortex-a53 -smp 4 -bios "$EG" -serial "file:$RUN/serial.log" \
+    -monitor none -display none > "$RUN/full.log" 2>&1 &
+FULL=$!
+n=0
+while [ $n -lt "$WAIT" ]; do
+    grep -q BusyBox "$RUN/serial.log" 2>/dev/null && break
+    sleep 5
+    n=$((n + 5))
+done
+kill $FULL 2>/dev/null || true
+wait $FULL 2>/dev/null || true
+if grep -q 'stopping (unmodeled device' "$RUN/full.log"; then
+    echo "   FAIL -- unmodelled access:"
+    grep 'stopping (unmodeled device' "$RUN/full.log" | head -3
+    exit 1
+fi
+if ! grep -q BusyBox "$RUN/serial.log" 2>/dev/null; then
+    echo "   FAIL -- no BusyBox prompt within ${WAIT}s. Serial tail:"
+    tail -5 "$RUN/serial.log" 2>/dev/null || echo "   (serial log empty)"
+    exit 1
+fi
+echo "   ok -- $(grep -c '' "$RUN/serial.log") serial lines, BusyBox reached"
+echo
+echo "PASS"
diff --git a/z63-tools/snor_user_extract.py b/z63-tools/snor_user_extract.py
new file mode 100755
index 0000000..12e581c
--- /dev/null
+++ b/z63-tools/snor_user_extract.py
@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+"""Extract the real SNOR_USER region from a full NOR dump.
+
+    snor_user_extract.py <dump.elf|dump.bin> <out.bin> [--json out.json]
+
+The firmware *update package* contains only two components, the loader/RTOS
+image (`eg`) and the Linux payload (`li`), and the partition table at rodata
+0x4531fd24 proves that: its first two entries are those two slots and the
+remaining forty-two describe flash that neither component covers. Those are
+the factory-written per-unit bodies -- parameter tables, calibration, audio
+and sequence resources -- and PTP service 0xF032 cannot read them either,
+because its blocklist covers 0x40000000-0x48000000 exactly.
+
+A **full NOR dump taken from a body** does contain them, and that is what
+this reads. `/Users/admin/LiBr/nikon/ida/z63_eg.elf` is one: its single LOAD
+segment spans 0x40160000-0x47fffff0, so it holds the whole window rather than
+just the package component, which is why it is 132 MB against the package's
+88.8 MB. The content is unmistakably real -- `ENDM` trailers exactly where the
+partition table's body sizes put them, an `AUDIO` body at 0x462e0000, a part
+number after the trailer at 0x462ffffc, and ANSI-coloured console strings at
+0x45980000.
+
+This is per-unit data from somebody's camera. It is fine to run your own
+emulator on your own dump; it is not something to publish. The output carries
+the dump's hash so a run can always say which body it came from.
+
+Anything the dump does not cover is filled with 0xff, the erased state of
+NOR flash, and the record says how many bytes that was.
+"""
+import hashlib
+import json
+import struct
+import sys
+from pathlib import Path
+
+SNOR_BASE = 0x45980000
+SNOR_SIZE = 0x02680000
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def elf_segments(data):
+    if data[:4] != b'\x7fELF':
+        return None
+    is64 = data[4] == 2
+    if not is64:
+        return None
+    phoff, = struct.unpack_from('<Q', data, 0x20)
+    phentsize, phnum = struct.unpack_from('<HH', data, 0x36)
+    out = []
+    for i in range(phnum):
+        o = phoff + i * phentsize
+        p_type, = struct.unpack_from('<I', data, o)
+        if p_type != 1:          # PT_LOAD
+            continue
+        p_offset, p_vaddr, _p_paddr, p_filesz, p_memsz = struct.unpack_from(
+            '<QQQQQ', data, o + 8)
+        out.append((p_vaddr, p_offset, p_filesz, p_memsz))
+    return out
+
+
+def main():
+    argv = sys.argv[1:]
+    json_out = None
+    if '--json' in argv:
+        i = argv.index('--json')
+        json_out = argv[i + 1]
+        del argv[i:i + 2]
+    if len(argv) != 2:
+        sys.exit("usage: snor_user_extract.py <dump> <out.bin> [--json f]")
+
+    src = Path(argv[0])
+    data = src.read_bytes()
+    segs = elf_segments(data)
+
+    region = bytearray(b'\xff' * SNOR_SIZE)
+    covered = 0
+    sources = []
+    if segs:
+        for vaddr, off, filesz, _memsz in segs:
+            lo = max(vaddr, SNOR_BASE)
+            hi = min(vaddr + filesz, SNOR_BASE + SNOR_SIZE)
+            if hi <= lo:
+                continue
+            region[lo - SNOR_BASE:hi - SNOR_BASE] = \
+                data[off + (lo - vaddr):off + (hi - vaddr)]
+            covered += hi - lo
+            sources.append(dict(vaddr=hex(vaddr), took=hex(hi - lo),
+                                from_offset=hex(off + (lo - vaddr))))
+    else:
+        # a flat dump: the caller must say where it starts, and the only
+        # layout this firmware uses is the image base
+        base = 0x40160000
+        lo, hi = SNOR_BASE, min(base + len(data), SNOR_BASE + SNOR_SIZE)
+        if hi > lo:
+            region[lo - SNOR_BASE:hi - SNOR_BASE] = \
+                data[lo - base:hi - base]
+            covered = hi - lo
+            sources.append(dict(flat_base=hex(base), took=hex(hi - lo)))
+
+    if covered == 0:
+        sys.exit(f"{src} covers none of 0x{SNOR_BASE:x}-"
+                 f"0x{SNOR_BASE + SNOR_SIZE:x}; is it a full NOR dump?")
+
+    Path(argv[1]).write_bytes(bytes(region))
+    record = dict(
+        classification='real per-unit serial-NOR content from a body dump; '
+                       'not for publication',
+        region=dict(base=hex(SNOR_BASE), size=hex(SNOR_SIZE)),
+        dump=str(src), dump_bytes=len(data), dump_sha256=sha(data),
+        covered_bytes=covered,
+        filled_with_ff=SNOR_SIZE - covered,
+        segments_used=sources,
+        output_sha256=sha(bytes(region)),
+        source_sha256=sha(Path(__file__).read_bytes()),
+        synthetic=False,
+    )
+    text = json.dumps(record, indent=1)
+    if json_out:
+        Path(json_out).write_text(text)
+    print(text)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/z63-tools/snor_user_input.py b/z63-tools/snor_user_input.py
new file mode 100755
index 0000000..1379c6d
--- /dev/null
+++ b/z63-tools/snor_user_input.py
@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+"""Build the minimum SNOR_USER framing the Z 6III's own reader checks.
+
+    snor_user_input.py <eg2010_0200i1.bi> <out.bin> [--json out.json]
+
+WHAT THIS IS NOT
+----------------
+It is **not** recovered calibration, not a parameter table, not a flash dump
+and not anything measured from a camera. Every byte it writes is one of the
+four characters `ENDM`, and nothing else in the region is touched. It exists
+so a firmware reader that refuses an empty partition can get past its
+validity check, and for no other reason. A body that satisfies a marker check
+makes the firmware proceed; it does not make the firmware right, and any
+value the firmware then computes from the surrounding zeros is meaningless.
+
+WHY THOSE BYTES
+---------------
+The serial NOR beyond the firmware image -- 0x45980000-0x48000000, which the
+SoC's own region table calls SNOR_USER -- holds factory-written, per-unit
+bodies. They are in no firmware package, so an emulator has nothing to put
+there and the region reads as zeros.
+
+The image carries the partition map at rodata 0x4531fd24, 0x28 per entry.
+Field +0x04 is the base, +0x14 the partition size and +0x18 the body size.
+Where the two differ, the gap is the trailer. `sub_40D7675C` is the validator
+and its last act is explicit about what the trailer must contain:
+
+    v = sub_40D76F88(...);
+    if (v[3] == 77 && v[2] == 68 && v[0] == 69 && v[1] == 78) return ok;
+
+69, 78, 68, 77 -- 'E', 'N', 'D', 'M'. The same four bytes terminate string
+lists elsewhere in the image, at 0x441b802b and 0x454faf1c, so `ENDM` is this
+firmware's end marker generally and not a resource-specific magic.
+
+This reads the partition table out of the image passed on the command line
+rather than hardcoding it, so it cannot silently describe a different build.
+"""
+import hashlib
+import json
+import struct
+import sys
+from pathlib import Path
+
+LOAD = 0x40160000
+TABLE = 0x4531fd24
+STRIDE = 0x28
+SNOR_BASE = 0x45980000
+SNOR_SIZE = 0x02680000
+MARKER = b'ENDM'
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def partitions(image):
+    out = []
+    for i in range(256):
+        off = TABLE - LOAD + i * STRIDE
+        if off + STRIDE > len(image):
+            break
+        f = struct.unpack_from('<10I', image, off)
+        flags, base, size, body = f[0], f[1], f[5], f[6]
+        if not (0x40000000 <= base < 0x48000000):
+            break
+        if size == 0 and body == 0 and flags == 0:
+            break
+        out.append(dict(index=i, flags=flags, base=base, size=size, body=body))
+    return out
+
+
+def main():
+    argv = sys.argv[1:]
+    json_out = None
+    if '--json' in argv:
+        i = argv.index('--json')
+        json_out = argv[i + 1]
+        del argv[i:i + 2]
+    args = argv
+    if len(args) != 2:
+        sys.exit(__doc__.splitlines()[2].strip())
+    image = Path(args[0]).read_bytes()
+    out = Path(args[1])
+
+    parts = partitions(image)
+    if not parts:
+        sys.exit(f"no partition table at {TABLE:#x} -- wrong image?")
+
+    region = bytearray(SNOR_SIZE)
+    written = []
+    for p in parts:
+        if p['base'] < SNOR_BASE or p['body'] == 0 or p['body'] == p['size']:
+            continue
+        at = p['base'] + p['body']
+        if not (SNOR_BASE <= at and at + 4 <= SNOR_BASE + SNOR_SIZE):
+            continue
+        region[at - SNOR_BASE:at - SNOR_BASE + 4] = MARKER
+        written.append(dict(partition=p['index'], base=hex(p['base']),
+                            size=hex(p['size']), body=hex(p['body']),
+                            marker_at=hex(at)))
+
+    out.write_bytes(bytes(region))
+    record = dict(
+        classification='synthetic end markers only; not recovered '
+                       'calibration, not a parameter table, not a flash dump',
+        marker=MARKER.decode(),
+        bytes_written=4 * len(written),
+        region=dict(base=hex(SNOR_BASE), size=hex(SNOR_SIZE)),
+        partition_table=hex(TABLE),
+        partitions_total=len(parts),
+        partitions_marked=len(written),
+        markers=written,
+        evidence='sub_40D7675C compares the trailer against 69,78,68,77',
+        firmware_sha256=sha(image),
+        output_sha256=sha(bytes(region)),
+        source_sha256=sha(Path(__file__).read_bytes()),
+        body_recovered=False,
+        hardware_calibration=False,
+    )
+    text = json.dumps(record, indent=1)
+    if json_out:
+        Path(json_out).write_text(text)
+    print(text)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/z63-tools/spi_names.py b/z63-tools/spi_names.py
new file mode 100755
index 0000000..7e9c9ad
--- /dev/null
+++ b/z63-tools/spi_names.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+"""Generate hw/arm/nikon-z63-spi.h from the image's own interrupt name table.
+
+The table is at rodata 0x41847000, 0x20 bytes per entry, SPI n at +0x20n.
+Two unrelated sources agree on the numbering, which is why it can be trusted:
+deriving UART_0_RX from it reproduces the board's own Z63_UART_IRQ_SPI 173,
+and the firmware's handler install sub_40C00704 takes a GIC INTID whose
+descriptor lookup sub_40C00660 computes `base + 16 * (intid - 32)` -- so
+INTID = SPI + 32, and the display init's INTIDs 99/100/101/102/105 are
+exactly SPIs 67/68/69/70/73, i.e. DISP_0, DISP_1, DISP_1B, DISP_DWCH and
+MIPI_DSI_TX.
+
+    z63-tools/spi_names.py <eg2010_0200i1.bi> > hw/arm/nikon-z63-spi.h
+"""
+import pathlib, re, sys
+
+IMAGE_BASE = 0x40160000
+TABLE = 0x41847000
+STRIDE = 0x20
+NAME = re.compile(rb'^[A-Z][A-Za-z0-9_\-]{2,30}$')
+HEADER = '''/* ------------------------------------------------------------------ */
+/* Interrupt numbers, from the image's own name table.                 */
+/*                                                                    */
+/* rodata 0x41847000, 0x20 bytes per entry, SPI n at +0x20n. Generated */
+/* by z63-tools/spi_names.py; do not edit by hand.                     */
+/*                                                                    */
+/* The firmware's own registration proves the numbering: its handler   */
+/* install sub_40C00704 takes a GIC INTID, and the descriptor lookup   */
+/* sub_40C00660 computes `base + 16 * (intid - 32)`, so INTID = SPI +  */
+/* 32 exactly as the GIC specifies. The display init registers INTIDs  */
+/* 99, 100, 101, 102 and 105, which are SPIs 67, 68, 69, 70 and 73 --  */
+/* DISP_0, DISP_1, DISP_1B, DISP_DWCH and MIPI_DSI_TX. That agreement  */
+/* between two unrelated sources is why this table can be trusted.     */
+/*                                                                    */
+/* A name here is the SoC's, not a claim that the block is modelled.   */
+/* ------------------------------------------------------------------ */
+
+#ifndef HW_ARM_NIKON_Z63_SPI_H
+#define HW_ARM_NIKON_Z63_SPI_H
+
+/* sub_40C00704 and the GIC both speak INTIDs; this file lists SPIs. */
+#define Z63_INTID(spi)  ((spi) + 32)
+'''
+
+
+def main():
+    eg = pathlib.Path(sys.argv[1]).read_bytes()
+    base = TABLE - IMAGE_BASE
+    names, gap = {}, 0
+    for i in range(4096):
+        off = base + i * STRIDE
+        if off + STRIDE > len(eg):
+            break
+        text = eg[off:off + STRIDE].split(b'\0')[0]
+        if text and NAME.match(text):
+            names[i] = text.decode()
+            gap = 0
+        else:
+            gap += 1
+            if gap > 40 and names:
+                break
+    print(HEADER)
+    for spi, name in sorted(names.items()):
+        print("#define Z63_SPI_%-34s %3d" % (name, spi))
+    print("\n/* %d named SPIs, highest index %d. */" % (len(names), max(names)))
+    print("\n#endif /* HW_ARM_NIKON_Z63_SPI_H */")
+
+
+if __name__ == '__main__':
+    main()
diff --git a/z63-tools/trace_report.py b/z63-tools/trace_report.py
new file mode 100755
index 0000000..06625d9
--- /dev/null
+++ b/z63-tools/trace_report.py
@@ -0,0 +1,80 @@
+#!/usr/bin/env python3
+"""Aggregate a QEMU MMIO trace into a per-register report.
+
+Run the machine with QEMU's own tracepoints -- no board change needed:
+
+    qemu-system-aarch64 -machine nikon-z63,rom-page-stub=on -bios <eg> ... \
+        --trace enable=memory_region_ops_read \
+        --trace enable=memory_region_ops_write -D /tmp/z63-trace.log
+
+then  tools/trace_report.py /tmp/z63-trace.log
+
+The useful column is the number of distinct values a register returned. An
+address read many times that always answers the same value is a guest polling
+a model that cannot change: that is the register to give behaviour to next. An
+address whose answers keep changing is already doing its job.
+"""
+import argparse, collections, re, sys
+
+LINE = re.compile(
+    r"memory_region_ops_(read|write) cpu (\d+) mr \S+ "
+    r"addr (0x[0-9a-f]+) value (0x[0-9a-f]+) size (\d+) name '([^']*)'")
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('log')
+    ap.add_argument('--top', type=int, default=20)
+    args = ap.parse_args()
+
+    reads = collections.Counter()
+    writes = collections.Counter()
+    values = collections.defaultdict(collections.Counter)
+    region = collections.Counter()
+    total = 0
+    with open(args.log) as f:
+        for line in f:
+            m = LINE.match(line)
+            if not m:
+                continue
+            kind, _cpu, addr, value, _size, name = m.groups()
+            total += 1
+            key = (name, int(addr, 16))
+            region[name] += 1
+            if kind == 'read':
+                reads[key] += 1
+                values[key][value] += 1
+            else:
+                writes[key] += 1
+
+    if not total:
+        sys.exit("no memory_region_ops_* lines in %s" % args.log)
+    print("accesses: %d\n" % total)
+    print("%-26s %8s" % ("region", "accesses"))
+    for name, n in region.most_common():
+        print("%-26s %8d" % (name, n))
+
+    print("\nmost-read registers")
+    print("%-26s %-13s %7s %7s  %s"
+          % ("region", "addr", "reads", "values", "answers"))
+    for (name, addr), n in reads.most_common(args.top):
+        v = values[(name, addr)]
+        sample = ", ".join("%s x%d" % (k, c) for k, c in v.most_common(3))
+        print("%-26s %#011x %7d %7d  %s"
+              % (name, addr, n, len(v), sample[:58]))
+
+    stuck = [(n, k) for k, n in reads.items() if n >= 8 and len(values[k]) == 1]
+    stuck.sort(reverse=True)
+    if stuck:
+        print("\nread repeatedly, one answer only -- candidates for behaviour")
+        for n, (name, addr) in stuck[:args.top]:
+            print("  %-26s %#011x %6d reads, always %s"
+                  % (name, addr, n, next(iter(values[(name, addr)]))))
+
+    print("\nmost-written registers")
+    for (name, addr), n in writes.most_common(10):
+        print("  %-26s %#011x %7d" % (name, addr, n))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/z63-tools/where_blocked.py b/z63-tools/where_blocked.py
new file mode 100755
index 0000000..9ada852
--- /dev/null
+++ b/z63-tools/where_blocked.py
@@ -0,0 +1,184 @@
+#!/usr/bin/env python3
+"""Where did the RTOS stop making progress, and what did it call?
+
+Boots the machine under `-d exec` and answers it two ways.
+
+**Where progress stopped** is measured as the last time a block ran that had
+never run before. After that point the guest executes only code it has
+already executed, which is the honest definition of "no longer making
+progress" — it survives a task looping, and it does not depend on guessing
+which address ranges are "the application".
+
+An earlier version of this script used address ranges for that instead, and
+it was wrong: it classified 0x40C00000-0x40E00000 as BSP and platform, so the
+clock sequencer at 0x40C2F300 — which is the application's own work, called
+straight from the display init — did not count, and the frontier was reported
+about 500 blocks too early. The range table below is still printed, because
+knowing which subsystems ran at all is useful, but it no longer decides
+anything.
+
+**The growth curve** shows the shape: how many new blocks appear in each
+hundredth of the run. A healthy boot has a long tail; a stall has a cliff.
+
+    z63-tools/where_blocked.py <components-dir> [--seconds 60] [--idasql 8084]
+"""
+import argparse, collections, json, os, re, signal, subprocess, sys, tempfile
+import time, urllib.request
+
+TRACE = re.compile(r'^Trace \d+: 0x[0-9a-f]+ \[([0-9a-f]+)/([0-9a-f]+)/')
+
+# Address ranges, from the SOLID descriptor and from which code the reversing
+# so far has attributed where. Only the boundary between "application" and
+# "kernel plus the BSP tick" matters for the verdict.
+REGIONS = [
+    (0x40160000, 0x40168000, 'bootstrap',        False),
+    (0x40168000, 0x401a0000, 'kernel',           False),
+    (0x401a0000, 0x40280000, 'kernel/mm',        False),
+    (0x40280000, 0x402b0000, 'EXS drivers',      True),
+    (0x402b0000, 0x40400000, 'display/card HAL', True),
+    (0x40400000, 0x40c00000, 'app and UI',       True),
+    (0x40c00000, 0x40d00000, 'BSP',              False),
+    (0x40d00000, 0x40e00000, 'platform',         False),
+    (0x40e00000, 0x41000000, 'services',         True),
+    (0x41000000, 0x41200000, 'BSP catalogs',     False),
+    (0x41200000, 0x41847000, 'runtime',          False),
+]
+
+
+def classify(addr):
+    for lo, hi, name, is_app in REGIONS:
+        if lo <= addr < hi:
+            return name, is_app
+    return 'outside the image', False
+
+
+def func_of(port, addr):
+    sql = ("SELECT addr, name, size FROM funcs "
+           "WHERE addr <= %d AND end_addr > %d" % (addr, addr))
+    try:
+        req = urllib.request.Request("http://127.0.0.1:%s/query" % port,
+                                     data=sql.encode())
+        rows = json.load(urllib.request.urlopen(req, timeout=60))
+        rows = rows['results'][0]['rows']
+        if rows:
+            return "%s (%s bytes)" % (rows[0][1], rows[0][2])
+    except Exception as exc:
+        return "idasql unavailable (%s)" % exc
+    return "no function"
+
+
+def run(qemu, eg, seconds, log):
+    cmd = [qemu, '-machine', 'nikon-z63,rom-page-stub=on', '-cpu', 'cortex-a53',
+           '-smp', '4', '-bios', eg, '-serial', 'null', '-monitor', 'none',
+           '-display', 'none', '-d', 'exec', '-D', log]
+    proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
+                            stderr=subprocess.DEVNULL)
+    try:
+        time.sleep(seconds)
+    finally:
+        proc.send_signal(signal.SIGTERM)
+        try:
+            proc.wait(10)
+        except subprocess.TimeoutExpired:
+            proc.kill()
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('components')
+    ap.add_argument('--seconds', type=int, default=60)
+    ap.add_argument('--idasql', default='8084')
+    ap.add_argument('--context', type=int, default=14)
+    ap.add_argument('--keep-trace', action='store_true')
+    args = ap.parse_args()
+
+    here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+    qemu = os.path.join(here, 'build', 'qemu-system-aarch64')
+    eg = os.path.join(args.components, 'eg2010_0200i1.bi')
+    for path in (qemu, eg):
+        if not os.path.exists(path):
+            sys.exit("missing %s" % path)
+
+    log = tempfile.mktemp(prefix='z63-exec-', suffix='.log')
+    print("tracing %d seconds ..." % args.seconds)
+    run(qemu, eg, args.seconds, log)
+
+    rows = []
+    with open(log) as f:
+        for line in f:
+            m = TRACE.match(line)
+            if m:
+                rows.append(int(m.group(2), 16))
+    if not rows:
+        sys.exit("no trace output -- is this QEMU built with TCG logging?")
+    print("%d block executions, %d distinct\n" % (len(rows), len(set(rows))))
+
+    seen = collections.OrderedDict()
+    for i, a in enumerate(rows):
+        name, is_app = classify(a)
+        seen.setdefault(name, [i, i, is_app])
+        seen[name][1] = i
+    print("%-20s %-12s %-12s %s" % ("region", "first", "last", "% through run"))
+    for name, (first, last, is_app) in sorted(seen.items(), key=lambda kv: kv[1][0]):
+        print("%-20s %-12d %-12d %5.1f%%%s"
+              % (name, first, last, 100.0 * last / len(rows),
+                 '   <-- application' if is_app else ''))
+
+    # Growth curve: new blocks per hundredth of the run.
+    seen_set = set()
+    slices = 50
+    width = max(1, len(rows) // slices)
+    curve = []
+    for i, a in enumerate(rows):
+        if i % width == 0:
+            curve.append([i, 0])
+        if a not in seen_set:
+            seen_set.add(a)
+            curve[-1][1] += 1
+    print("\nnew blocks per %d executions:" % width)
+    for pos, new in curve:
+        if new:
+            bar = '#' * min(60, new)
+            print("  %6.1f%%  %-5d %s" % (100.0 * pos / len(rows), new, bar))
+
+    # The frontier: the last block that had never run before.
+    seen_set = set()
+    last = 0
+    for i, a in enumerate(rows):
+        if a not in seen_set:
+            seen_set.add(a)
+            last = i
+    print("\nlast first-execution of any block: %d of %d (%.2f%% through "
+          "the run)" % (last, len(rows), 100.0 * last / len(rows)))
+    print("after it the guest only re-runs code it has already run.")
+
+    # The number to watch. The kernel keeps discovering new paths forever --
+    # a timeout arm, a different scheduler arm, an exception vector -- and
+    # those are not progress. Everything outside the kernel proper is work
+    # the camera is doing, whatever subsystem it belongs to.
+    KERNEL = (0x40168000, 0x401a0000)
+    seen_set = set()
+    work = 0
+    for i, a in enumerate(rows):
+        if a not in seen_set:
+            seen_set.add(a)
+            if not (KERNEL[0] <= a < KERNEL[1]):
+                work = i
+    print("last first-execution outside the kernel: %d (%.2f%%)"
+          % (work, 100.0 * work / len(rows)))
+    last = work
+    print("\n%-9s %-13s %s" % ("position", "block", "containing function"))
+    lo = max(0, last - args.context)
+    hi = min(len(rows), last + args.context)
+    for i in range(lo, hi):
+        a = rows[i]
+        tag = '  <== FRONTIER' if i == last else ''
+        print("%-9d %#011x  %-46s%s" % (i, a, func_of(args.idasql, a), tag))
+    if args.keep_trace:
+        print("\ntrace kept at %s" % log)
+    else:
+        os.unlink(log)
+
+
+if __name__ == '__main__':
+    main()
