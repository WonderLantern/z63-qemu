+    s->engine1540_descriptors[i] = value; s->engine1540_descriptor_writes++;
+    fprintf(stderr, "Z9_1540_DESCRIPTOR offset=%x value=%" PRIx64 "; parameters only, no processing\n", (unsigned)(addr - 0x15400000), value);
