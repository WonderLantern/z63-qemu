new file mode 100644
index 0000000..3afca3a
--- /dev/null
+++ b/hw/arm/nikon-z9-capture-nv16.h
@@ -0,0 +1,224 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Functional capture stream: actual owned NV16 RAM -> configured outputs.
+ * Internal 16-bit packing and Nikon filter/ISP algorithms are not emulated.
+ * The semantic stream retains NV16; fixed-point phases/scales use a declared
+ * nearest-sample convention. No CPU state, OS flags or camera files supplied.
+ */
+static uint64_t capture_nv16_address(const uint32_t *c, unsigned off)
+{
+    return c[off / 4] | ((uint64_t)(c[(off + 4) / 4] & 15) << 32);
+}
+
+static bool capture_nv16_span(NikonZ9State *s, uint64_t p, uint64_t n)
+{
+    return n && n <= 64 * MiB && !(p & 31) &&
+        p >= UINT64_C(0x800000000) && p <= UINT64_C(0x900000000) - n &&
+        dma_ram_range(s, p, n);
+}
+
+static unsigned capture_nv16_coordinate(const uint32_t *f, unsigned at, bool y)
+{
+    uint64_t phase = f[(y ? 0xc : 8) / 4];
+    uint64_t scale = f[(y ? 0x14 : 0x10) / 4];
+    return ((phase + at * scale) << f[0x20 / 4]) >> 14;
+}
+
+static bool capture_nv16_prepare(NikonZ9State *s)
+{
+    const uint32_t *src = s->engine1518[0].config;
+    const uint32_t *a = s->engine1542_config[1];
+    const uint32_t *c = s->engine1542_config[11];
+    unsigned w = src[0x80 / 4] & 0x7fff, h = src[0x80 / 4] >> 16;
+    unsigned stride = src[0x88 / 4];
+    uint64_t p[8], n[8], total = 0;
+    uint64_t fifo0 = capture_nv16_address(src, 0x110);
+    uint64_t fifo1 = capture_nv16_address(src, 0x118);
+    if (s->capture_nv16_requested || (s->engine1542_pending[11] & 0x20) ||
+        (s->engine1542_pending[1] & 0x11) ||
+        (s->engine1518[0].pending & (1u << 20)) ||
+        !w || w > 16384 || (w & 1) || !h || h > 8192 ||
+        stride < w || stride > 32768 || src[0x8c / 4] != stride ||
+        src[0xbc / 4] != 2 || src[0xc0 / 4] != 1 ||
+        src[0xc4 / 4] != 0x20 || src[0xd4 / 4] != 0x20 ||
+        src[0xb0 / 4] != ((w * 2 + 255) & ~255) ||
+        src[0xb4 / 4] != src[0xb0 / 4] ||
+        fifo0 != UINT64_C(0xe0000000) || fifo1 != fifo0 + src[0xb0 / 4] / 2 ||
+        (c[4 / 4] != 0x103 && c[4 / 4] != 0x100) || c[8 / 4] != 2 || c[0xc / 4] ||
+        capture_nv16_address(c, 0x200) != fifo0 || capture_nv16_address(c, 0x208) != fifo1 ||
+        a[0x4c / 4] != w || a[0x50 / 4] != h ||
+        a[0x38 / 4] != src[0xb0 / 4] || a[0x3c / 4] != src[0xb4 / 4] ||
+        capture_nv16_address(a, 0x20) != fifo0 || capture_nv16_address(a, 0x28) != fifo1) {
+        return false;
+    }
+    p[0] = capture_nv16_address(src, 0x100);
+    p[1] = capture_nv16_address(src, 0x108);
+    n[0] = n[1] = (uint64_t)stride * h;
+    for (unsigned j = 0; j < 3; j++) {
+        const uint32_t *b = s->engine1542_config[6 + j];
+        const uint32_t *f = s->engine1542_config[18 + j];
+        unsigned ow = f[0x2c / 4], oh = f[0x30 / 4], pitch = b[0x38 / 4];
+        if ((f[0] != 2 && f[0] != 4) || (f[1] != 1 && f[1] != 4) ||
+            f[0x18 / 4] != w || f[0x1c / 4] != h || f[0x24 / 4] || f[0x28 / 4] ||
+            !ow || (ow & 1) || ow > 16384 || !oh || oh > 8192 ||
+            pitch < ow || pitch > 32768 || b[0x3c / 4] != pitch || b[0x40 / 4] != 0x22 ||
+            b[0xc / 4] != 0x41000010 ||
+            !f[0x10 / 4] || !f[0x14 / 4] || f[0x20 / 4] > 7 ||
+            capture_nv16_coordinate(f, ow - 1, false) >= w ||
+            capture_nv16_coordinate(f, oh - 1, true) >= h) { return false; }
+        p[2 + j * 2] = capture_nv16_address(b, 0x20);
+        p[3 + j * 2] = capture_nv16_address(b, 0x28);
+        n[2 + j * 2] = n[3 + j * 2] = (uint64_t)pitch * oh;
+        total += n[2 + j * 2] * 2;
+    }
+    if (total > 192 * MiB) { return false; }
+    for (unsigned j = 0; j < 8; j++) {
+        if (!capture_nv16_span(s, p[j], n[j])) { return false; }
+        for (unsigned k = 0; k < j; k++) {
+            if (p[j] < p[k] + n[k] && p[k] < p[j] + n[j]) { return false; }
+        }
+    }
+    memcpy(s->capture_nv16_source, src, sizeof(s->capture_nv16_source));
+    for (unsigned j = 0; j < 3; j++) {
+        memcpy(s->capture_nv16_output[j], s->engine1542_config[6 + j], sizeof(s->capture_nv16_output[j]));
+        memcpy(s->capture_nv16_geometry[j], s->engine1542_config[18 + j], sizeof(s->capture_nv16_geometry[j]));
+    }
+    s->capture_nv16_requested = true; s->capture_nv16_failed = false;
+    s->capture_nv16_requests++;
+    return true;
+}
+
+static void capture_nv16_cancel(NikonZ9State *s)
+{
+    if (s->capture_nv16_requested) {
+        s->capture_nv16_requested = false; s->capture_nv16_cancels++;
+    }
+}
+
+static void capture_nv16_try(NikonZ9State *s)
+{
+    if (!s->capture_nv16_model || !s->capture_nv16_requested || s->capture_nv16_failed ||
+        !s->engine1543_active[1] || s->engine1543_held[1] ||
+        !s->engine1518[0].config[0x30 / 4]) { return; }
+    const uint32_t *src = s->capture_nv16_source;
+    unsigned w = src[0x80 / 4] & 0x7fff, h = src[0x80 / 4] >> 16;
+    unsigned stride = src[0x88 / 4];
+    uint64_t y = capture_nv16_address(src, 0x100), uv = capture_nv16_address(src, 0x108);
+    if (!s->engine151_capture_jobs || s->capture_nv16_consumed151 == s->engine151_capture_jobs ||
+        y != s->engine151_capture_y || uv != s->engine151_capture_uv ||
+        w != s->engine151_capture_width || h != s->engine151_capture_height ||
+        stride != s->engine151_capture_stride) { return; }
+    size_t plane = (size_t)stride * h;
+    uint8_t *input = g_malloc(plane * 2), *outputs[3] = {0};
+    bool ok = address_space_read(&address_space_memory, y, MEMTXATTRS_UNSPECIFIED, input, plane) == MEMTX_OK &&
+        address_space_read(&address_space_memory, uv, MEMTXATTRS_UNSPECIFIED, input + plane, plane) == MEMTX_OK;
+    /* Build every output before any write. Pointers/complete spans were
+     * validated and latched together. No internal port is aliased to RAM. */
+    for (unsigned j = 0; ok && j < 3; j++) {
+        const uint32_t *b = s->capture_nv16_output[j], *f = s->capture_nv16_geometry[j];
+        unsigned ow = f[0x2c / 4], oh = f[0x30 / 4], pitch = b[0x38 / 4];
+        size_t amount = (size_t)pitch * oh;
+        outputs[j] = g_malloc(amount * 2);
+        memset(outputs[j], 0, amount); memset(outputs[j] + amount, 128, amount);
+        for (unsigned r = 0; r < oh; r++) {
+            unsigned sy = capture_nv16_coordinate(f, r, true);
+            for (unsigned x = 0; x < ow; x++) {
+                unsigned sx = capture_nv16_coordinate(f, x, false);
+                outputs[j][(size_t)r * pitch + x] = input[(size_t)sy * stride + sx];
+            }
+            for (unsigned x = 0; x < ow; x += 2) {
+                unsigned sx = capture_nv16_coordinate(f, x, false) & ~1u;
+                outputs[j][amount + (size_t)r * pitch + x] = input[plane + (size_t)sy * stride + sx];
+                outputs[j][amount + (size_t)r * pitch + x + 1] = input[plane + (size_t)sy * stride + sx + 1];
+            }
+        }
+    }
+    for (unsigned j = 0; ok && j < 3; j++) {
+        const uint32_t *b = s->capture_nv16_output[j], *f = s->capture_nv16_geometry[j];
+        size_t amount = (size_t)b[0x38 / 4] * f[0x30 / 4];
+        uint64_t py = capture_nv16_address(b, 0x20), puv = capture_nv16_address(b, 0x28);
+        ok = address_space_write(&address_space_memory, py, MEMTXATTRS_UNSPECIFIED, outputs[j], amount) == MEMTX_OK &&
+            address_space_write(&address_space_memory, puv, MEMTXATTRS_UNSPECIFIED, outputs[j] + amount, amount) == MEMTX_OK;
+    }
+    g_free(input);
+    for (unsigned j = 0; j < 3; j++) { g_free(outputs[j]); }
+    if (!ok) { s->capture_nv16_failed = true; return; }
+    s->capture_nv16_jobs++; s->capture_nv16_input_bytes += plane * 2;
+    s->capture_nv16_consumed151 = s->engine151_capture_jobs;
+    for (unsigned j = 0; j < 3; j++) {
+        const uint32_t *b = s->capture_nv16_output[j], *f = s->capture_nv16_geometry[j];
+        s->capture_nv16_y[j] = capture_nv16_address(b, 0x20);
+        s->capture_nv16_uv[j] = capture_nv16_address(b, 0x28);
+        s->capture_nv16_w[j] = f[0x2c / 4]; s->capture_nv16_h[j] = f[0x30 / 4];
+        s->capture_nv16_stride[j] = b[0x38 / 4];
+        s->capture_nv16_bytes += (uint64_t)b[0x38 / 4] * f[0x30 / 4] * 2;
+    }
+    s->capture_nv16_requested = false;
+    /* The original application waits for A1 input boundary bit4 separately
+     * from C1 output completion bit5. Emit both input boundaries only after
+     * the actual complete stream/output writes, with the original A1 input
+     * gate enabled. Native509 otherwise reaches the thumbnail stage with
+     * both source-frame ready bytes still zero. No task flags are supplied. */
+    if (s->engine1542_config[1][0x10 / 4] == 1) {
+        s->engine1542_pending[1] |= 0x11;
+    }
+    /* Original ISR dispatches C1 as41160031, raw bit5 subscribed by20.
+     * Source ISR dispatches bit20 as the asynchronous source-done event.
+     * Functional completion is issued only after all six actual RAM writes. */
+    s->engine1542_pending[11] |= 0x20;
+    s->engine1518[0].pending |= 1u << 20;
+    raw_pipeline_irq_update(s); engine1518_update_irq(&s->engine1518[0]);
+    engine15e2_deferred_input_notify(s);
+    fprintf(stderr, "Z9_CAPTURE_NV16 jobs=%" PRIu64 " source=%" PRIx64 "/%" PRIx64
+        " main=%" PRIx64 "/%" PRIx64 " geometry=%ux%u; actual RAM, functional nearest sampling\n",
+        s->capture_nv16_jobs, y, uv, s->capture_nv16_y[0], s->capture_nv16_uv[0], w, h);
+}
+
+static int capture_nv16_jpeg_owner(NikonZ9State *s)
+{
+    if (!s->capture_nv16_model || !s->capture_nv16_jobs) { return -1; }
+    const uint32_t *c = s->engine15e2_config[0];
+    for (unsigned j = 0; j < 3; j++) {
+        if (s->capture_nv16_jpeg_consumed[j] != s->capture_nv16_jobs &&
+            c[0x418 / 4] == s->capture_nv16_w[j] && c[0x41c / 4] == s->capture_nv16_h[j] &&
+            c[0x410 / 4] == s->capture_nv16_stride[j] &&
+            ((uint64_t)c[0x430 / 4] << 4) == s->capture_nv16_y[j] &&
+            ((uint64_t)c[0x434 / 4] << 4) == s->capture_nv16_uv[j]) { return j; }
+    }
+    return -1;
+}
+
+static bool get_capture_nv16_model(Object *obj, Error **errp)
+{ return NIKON_Z9_LAB(obj)->capture_nv16_model; }
+
+static void set_capture_nv16_model(Object *obj, bool value, Error **errp)
+{
+    NikonZ9State *s = NIKON_Z9_LAB(obj);
+    if (s->image_ram.ram || s->image_ram.rom_device) {
+        error_setg(errp, "capture-nv16-pipeline-model is immutable after realization"); return;
+    }
+    s->capture_nv16_model = value;
+}
+
+static char *get_capture_nv16_state(Object *obj, Error **errp)
+{
+    NikonZ9State *s = NIKON_Z9_LAB(obj);
+    GString *out = g_string_new(NULL);
+    g_string_append_printf(out, "{\"enabled\":%s,\"requested\":%s,\"failed\":%s,"
+        "\"requests\":%" PRIu64 ",\"jobs\":%" PRIu64 ",\"bytes\":%" PRIu64 ","
+        "\"input_bytes\":%" PRIu64 ",\"cancels\":%" PRIu64 ",\"consumed151job\":%" PRIu64 ","
+        "\"source_pending\":%u,\"receiver_pending\":%u,\"input_pending\":%u,\"outputs\":[",
+        s->capture_nv16_model ? "true" : "false", s->capture_nv16_requested ? "true" : "false",
+        s->capture_nv16_failed ? "true" : "false", s->capture_nv16_requests, s->capture_nv16_jobs,
+        s->capture_nv16_bytes, s->capture_nv16_input_bytes, s->capture_nv16_cancels,
+        s->capture_nv16_consumed151, s->engine1518[0].pending, s->engine1542_pending[11],
+        s->engine1542_pending[1]);
+    for (unsigned j = 0; j < 3; j++) {
+        g_string_append_printf(out, "%s{\"y\":%" PRIu64 ",\"uv\":%" PRIu64 ","
+            "\"width\":%u,\"height\":%u,\"stride\":%u,\"jpeg_consumed_job\":%" PRIu64 "}",
+            j ? "," : "", s->capture_nv16_y[j], s->capture_nv16_uv[j],
+            s->capture_nv16_w[j], s->capture_nv16_h[j], s->capture_nv16_stride[j], s->capture_nv16_jpeg_consumed[j]);
+    }
+    g_string_append(out, "],\"physical_algorithm_verified\":false,\"physical_stream_packing_verified\":false,"
+        "\"native_file_saved\":false,\"scope\":\"owned151 NV16 RAM through semantic internal stream to three latched real outputs; functional fixed-point nearest sampling, no physical ISP/packing/file proof\"}");
+    return g_string_free(out, false);
+}
diff --git a/hw/arm/nikon-z9-d980.h b/hw/arm/nikon-z9-d980.h
new file mode 100644
index 0000000..d176d30
--- /dev/null
+++ b/hw/arm/nikon-z9-d980.h
@@ -0,0 +1,234 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Functional external Bayer writer for the observed D980 mode2 profile.
+ * Packed12 little-endian pairs and CFA-cell resampling are explicit lab
+ * assumptions. Native format2/stride values alone do not prove the physical
+ * wire packing, optical margins or actual sensor precision. */
+static bool primary_d980_description(NikonZ9State *s, const uint32_t *c,
+    unsigned slot, unsigned *width, unsigned *height, unsigned *stride,
+    uint64_t *encoded, uint64_t *physical)
+{
+    *width = c[1] >> 16;
+    *height = c[2] >> 16;
+    *stride = c[4];
+    unsigned bank = c[7];
+    unsigned bits = c[0] == 1 && s->primary_d980_packed14_model ? 14 : 12;
+    if (!s->raw_pixels || (c[0] != 2 && !(c[0] == 1 && s->primary_d980_packed14_model)) || (c[1] & 0xffff) || (c[2] & 0xffff) ||
+        !*width || !*height || ((*width | *height) & 1) ||
+        *width > NIKON_RAW_MAX_DIMENSION || *height > NIKON_RAW_MAX_DIMENSION ||
+        (uint64_t)*width * *height > NIKON_RAW_MAX_SAMPLES ||
+        *stride != ((((*width * bits + 7) / 8) + 31) & ~31u) ||
+        (uint64_t)*stride * *height > 128 * MiB ||
+        c[3] || c[5] != 1 || c[6] != 1 || c[8] != 1 || c[9] || c[10] || c[11] ||
+        bank > 1 || slot > 3) {
+        return false;
+    }
+    unsigned word = 12 + bank * 8 + slot * 2;
+    *encoded = c[word] | ((uint64_t)c[word + 1] << 32);
+    if (*encoded & 31) { return false; }
+    return raw_pipeline_address(s, *encoded, (uint64_t)*stride * *height, physical);
+}
+
+static bool primary_d980_ready(NikonZ9State *s)
+{
+    unsigned w, h, pitch;
+    uint64_t encoded, physical;
+    const uint32_t *c = s->primary_d980_latched;
+    if (!primary_d980_description(s, c, 0, &w, &h, &pitch, &encoded, &physical)) {
+        return false;
+    }
+    unsigned bank = c[7];
+    for (unsigned slot = 1; slot < 4; slot++) {
+        unsigned word = 12 + bank * 8 + slot * 2;
+        if ((c[word] || c[word + 1]) &&
+            !primary_d980_description(s, c, slot, &w, &h, &pitch, &encoded, &physical)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static uint8_t *primary_d980_pack12(const NikonRawPixels *p,
+                                  unsigned width, unsigned height, unsigned stride)
+{
+    uint8_t *pixels = g_malloc0((size_t)stride * height);
+    for (unsigned y = 0; y < height; y++) {
+        unsigned sy = ((uint64_t)(y / 2) * (p->height / 2) / (height / 2)) * 2 + (y & 1);
+        uint8_t *row = pixels + (size_t)y * stride;
+        for (unsigned x = 0; x < width; x += 2) {
+            unsigned sx = ((uint64_t)(x / 2) * (p->width / 2) / (width / 2)) * 2;
+            uint16_t a = MIN(4095, ((uint64_t)p->samples[(size_t)sy * p->width + sx] * 4095 + p->white / 2) / p->white);
+            uint16_t b = MIN(4095, ((uint64_t)p->samples[(size_t)sy * p->width + sx + 1] * 4095 + p->white / 2) / p->white);
+            unsigned off = x * 3 / 2;
+            row[off] = a;
+            row[off + 1] = (a >> 8) | ((b & 15) << 4);
+            row[off + 2] = b >> 4;
+        }
+    }
+    return pixels;
+}
+
+/* Little-endian contiguous14-bit groups are an explicit lab hypothesis.
+ * The native mode1 and pitch alone do not establish physical wire packing. */
+static uint8_t *primary_d980_pack14(const NikonRawPixels *p,
+                                  unsigned width, unsigned height, unsigned stride)
+{
+    uint8_t *pixels = g_malloc0((size_t)stride * height);
+    for (unsigned y = 0; y < height; y++) {
+        unsigned sy = ((uint64_t)(y / 2) * (p->height / 2) / (height / 2)) * 2 + (y & 1);
+        uint8_t *row = pixels + (size_t)y * stride;
+        for (unsigned x = 0; x < width; x += 4) {
+            unsigned count = MIN(4, width - x);
+            uint64_t packed = 0;
+            for (unsigned j = 0; j < count; j++) {
+                unsigned sx = ((uint64_t)((x + j) / 2) * (p->width / 2) / (width / 2)) * 2 + ((x + j) & 1);
+                uint16_t value = MIN(16383, ((uint64_t)p->samples[(size_t)sy * p->width + sx] * 16383 + p->white / 2) / p->white);
+                packed |= (uint64_t)value << (j * 14);
+            }
+            for (unsigned byte = 0; byte < (count * 14 + 7) / 8; byte++) {
+                row[x * 14 / 8 + byte] = packed >> (byte * 8);
+            }
+        }
+    }
+    return pixels;
+}
+
+static bool primary_d980_receive(NikonZ9State *s, bool single_input)
+{
+    if (!s->primary_d980_stream_model || (!single_input && !s->event_timing_active) ||
+        s->primary_reset_stage || !(s->engine150c_active & 0x4000) ||
+        (s->engine_150c_init[0x18 / 4] & 0x4000) || s->primary_d980_pending) {
+        return false;
+    }
+    unsigned w, h, pitch, slot = s->primary_d980_slot;
+    uint64_t encoded, physical;
+    /* The native descriptor has four slots; only nonzero submitted slots
+     * participate. Slot cycling is a functional model, not chip timing. */
+    unsigned bank = s->primary_d980_latched[7];
+    if (!s->primary_d980_latched[12 + bank * 8 + slot * 2] &&
+        !s->primary_d980_latched[13 + bank * 8 + slot * 2]) {
+        slot = 0;
+    }
+    if (!primary_d980_description(s, s->primary_d980_latched, slot,
+                                 &w, &h, &pitch, &encoded, &physical)) {
+        s->primary_d980_rejects++;
+        unknown_access(s, 0x150d9800, s->primary_d980_latched[0], 4, true);
+        return false;
+    }
+    if (!s->primary_d980_cache || w != s->primary_d980_cache_width ||
+        h != s->primary_d980_cache_height || pitch != s->primary_d980_cache_stride || s->primary_d980_latched[0] != s->primary_d980_cache_format) {
+        g_free(s->primary_d980_cache);
+        s->primary_d980_cache = s->primary_d980_latched[0] == 1 ?
+            primary_d980_pack14(s->raw_pixels, w, h, pitch) :
+            primary_d980_pack12(s->raw_pixels, w, h, pitch);
+        s->primary_d980_cache_width = w;
+        s->primary_d980_cache_height = h;
+        s->primary_d980_cache_stride = pitch;
+        s->primary_d980_cache_format = s->primary_d980_latched[0];
+    }
+    size_t bytes = (size_t)pitch * h;
+    if (address_space_write(&address_space_memory, physical, MEMTXATTRS_UNSPECIFIED,
+                            s->primary_d980_cache, bytes) != MEMTX_OK) {
+        s->primary_d980_rejects++;
+        unknown_access(s, 0x150d9920, encoded, 4, true);
+        return false;
+    }
+    s->primary_d980_frames++;
+    s->primary_d980_bytes += bytes;
+    s->primary_d980_last_encoded = encoded;
+    s->primary_d980_last_physical = physical;
+    s->primary_d980_slot = (slot + 1) & 3;
+    /* Z9 original40caf3ec and ZR40eb8e18 map logical4000 to
+     * primary group1 bit26. Publish only after every output byte exists. */
+    s->primary_d980_pending = 0x4000000;
+    engine150c_stop_irq_update(s);
+    return true;
+}
+
+static void primary_d980_tick(NikonZ9State *s)
+{
+    primary_d980_receive(s, false);
+}
+
+static void primary_d980_single_cancel(NikonZ9State *s)
+{
+    s->primary_d980_prepare_cancelled += s->primary_d980_prepared;
+    s->primary_d980_prepared = false;
+    s->primary_d980_single_cancelled += s->primary_d980_single_armed;
+    s->primary_d980_single_armed = false;
+    if (s->primary_d980_single_timer) { timer_del(s->primary_d980_single_timer); }
+}
+
+static void primary_d980_single_tick(void *opaque)
+{
+    NikonZ9State *s = opaque;
+    if (!s->primary_d980_single_armed) { return; }
+    if (s->primary_reset_stage || !(s->engine150c_active & 0x4000) ||
+        s->event_timing_active || ++s->primary_d980_single_attempts > 64) {
+        primary_d980_single_cancel(s);
+        return;
+    }
+    /* Original460: periodic source stopped, primary4000 enabled, front
+     * preparation2->3, then source bitmap200. One external frame and 33ms
+     * input pacing are hypotheses, not physical exposure/readout timing.
+     * A later mode0 may release preparation; only actual stop/reset cancels
+     * this separate input. Never fabricate a front/status result. */
+    if ((s->event_control_1508[3] & 0x201) == 0x201 &&
+        primary_d980_receive(s, true)) {
+        s->primary_d980_single_armed = false;
+        s->primary_d980_single_epoch = s->primary_d980_input_epoch;
+        s->primary_d980_single_frames++;
+        if (s->primary_d980_source_notify_model) {
+            /* Notify the existing source wait only after the complete DMA.
+             * Both original callbacks map group1 bit29 to wait400000;
+             * no OS wait state or ISR acknowledgement is written here. */
+            uint64_t boundaries = s->raw_source_boundaries;
+            raw_source_boundary_receive(s, true);
+            s->primary_d980_source_notifications += s->raw_source_boundaries != boundaries;
+        }
+        if (s->primary_d980_channel_boundary_model) {
+            /* The complete input frame precedes this existing channel clock
+             * boundary. Shared channel pending/ACK semantics remain intact;
+             * primary stop/reset does not acknowledge a channel on its behalf. */
+            s->primary_d980_channel_boundaries++;
+            s->primary_d980_channel_coalesced += !!(s->event_pending_1508 & 1);
+            s->event_pending_1508 |= 1;
+            s->event_channel_inputs++;
+            event_channel_update_irq(s);
+        }
+        return;
+    }
+    timer_mod(s->primary_d980_single_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 33333333);
+}
+
+static void primary_d980_single_arm(NikonZ9State *s)
+{
+    s->primary_d980_single_armed = true;
+    s->primary_d980_single_attempts = 0;
+    s->primary_d980_single_requests++;
+    timer_mod(s->primary_d980_single_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 33333333);
+}
+
+static void primary_d980_single_mode(NikonZ9State *s, unsigned channel,
+                                    uint32_t previous, uint32_t value)
+{
+    if (!s->primary_d980_single_model || channel || previous != 2 || value != 3 ||
+        s->primary_reset_stage || s->event_timing_active) {
+        return;
+    }
+    if (!(s->engine150c_active & 0x4000)) {
+        if (s->primary_d980_prepared_start_model && s->primary_reset_count &&
+            !s->primary_d980_prepared && !s->primary_d980_single_armed) {
+            s->primary_d980_prepared = true;
+            s->primary_d980_prepare_requests++;
+        }
+        return;
+    }
+    if (!s->primary_d980_input_epoch ||
+        s->primary_d980_single_epoch == s->primary_d980_input_epoch ||
+        s->primary_d980_single_armed) {
+        return;
+    }
+    primary_d980_single_arm(s);
+}
diff --git a/hw/arm/nikon-z9-jpeg.h b/hw/arm/nikon-z9-jpeg.h
new file mode 100644
index 0000000..6fc6522
--- /dev/null
+++ b/hw/arm/nikon-z9-jpeg.h
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* WonderLantern functional JPEG backend, independent of camera firmware.
+ * Input: bounded full-range NV16 RAM and explicit natural-order quantizers.
+ * Output: actual baseline JPEG bytes; this helper emits no device status.
+ * Uses the separately installed open-source libjpeg-turbo C API. */
+#ifndef WONDERLANTERN_NV16_JPEG_H
+#define WONDERLANTERN_NV16_JPEG_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <setjmp.h>
+#include <jpeglib.h>
+
+typedef struct WonderLanternJPEGError {
+    struct jpeg_error_mgr api;
+    jmp_buf jump;
+} WonderLanternJPEGError;
+
+typedef struct WonderLanternJPEGContext {
+    struct jpeg_compress_struct codec;
+    WonderLanternJPEGError error;
+    unsigned char *output;
+    unsigned long output_bytes;
+    unsigned char *row;
+} WonderLanternJPEGContext;
+
+static void wonderlantern_jpeg_error(j_common_ptr codec)
+{
+    WonderLanternJPEGError *error = (WonderLanternJPEGError *)codec->err;
+    longjmp(error->jump, 1);
+}
+
+/* Caller owns the returned malloc buffer; failure returns no partial bytes.
+ * Both full input planes and the maximum output size must be explicit. */
+static int wonderlantern_nv16_jpeg_scaled(const uint8_t *y, size_t y_bytes,
+                                  const uint8_t *uv, size_t uv_bytes,
+                                  unsigned width, unsigned height, unsigned stride,
+                                  const uint8_t quantizers[2][64], size_t capacity,
+                                  unsigned scale_shift,
+                                  unsigned char **output, size_t *output_bytes)
+{
+    *output = NULL; *output_bytes = 0;
+    if (!y || !uv || !quantizers || !width || !height || (width & 1) ||
+        width > 16384 || height > 16384 || stride < width || stride > 32768 ||
+        (size_t)stride * height > 64u * 1024u * 1024u ||
+        y_bytes != (size_t)stride * height || uv_bytes != y_bytes ||
+        !capacity || capacity > 128u * 1024u * 1024u || scale_shift > 2 ||
+        !(width >> scale_shift) || !(height >> scale_shift)) { return 0; }
+    /* Declared functional nearest input sampling for original codec scale2.
+     * Source remains complete even-width NV16; encoded JPEG width may be odd.
+     * No guest input, intermediate RAM or allocator metadata is changed. */
+    unsigned encoded_width = width >> scale_shift;
+    for (unsigned table = 0; table < 2; table++) {
+        for (unsigned at = 0; at < 64; at++) {
+            if (!quantizers[table][at]) { return 0; }
+        }
+    }
+    WonderLanternJPEGContext *ctx = calloc(1, sizeof(*ctx));
+    if (!ctx) { return 0; }
+    ctx->codec.err = jpeg_std_error(&ctx->error.api);
+    ctx->error.api.error_exit = wonderlantern_jpeg_error;
+    if (setjmp(ctx->error.jump)) {
+        jpeg_destroy_compress(&ctx->codec);
+        free(ctx->row); free(ctx->output); free(ctx); return 0;
+    }
+    jpeg_create_compress(&ctx->codec);
+    jpeg_mem_dest(&ctx->codec, &ctx->output, &ctx->output_bytes);
+    ctx->codec.image_width = encoded_width;
+    ctx->codec.image_height = height >> scale_shift;
+    ctx->codec.input_components = 3; ctx->codec.in_color_space = JCS_YCbCr;
+    jpeg_set_defaults(&ctx->codec);
+    ctx->codec.comp_info[0].h_samp_factor = 2;
+    ctx->codec.comp_info[0].v_samp_factor = 1;
+    for (unsigned component = 1; component < 3; component++) {
+        ctx->codec.comp_info[component].h_samp_factor = 1;
+        ctx->codec.comp_info[component].v_samp_factor = 1;
+    }
+    for (unsigned table = 0; table < 2; table++) {
+        unsigned int values[64];
+        for (unsigned at = 0; at < 64; at++) { values[at] = quantizers[table][at]; }
+        jpeg_add_quant_table(&ctx->codec, table, values, 100, TRUE);
+    }
+    ctx->codec.optimize_coding = TRUE;
+    ctx->codec.dct_method = JDCT_ISLOW;
+    ctx->row = malloc((size_t)encoded_width * 3);
+    if (!ctx->row) {
+        jpeg_destroy_compress(&ctx->codec); free(ctx->output); free(ctx); return 0;
+    }
+    jpeg_start_compress(&ctx->codec, TRUE);
+    while (ctx->codec.next_scanline < ctx->codec.image_height) {
+        size_t base = ((size_t)ctx->codec.next_scanline << scale_shift) * stride;
+        for (unsigned x = 0; x < encoded_width; x++) {
+            unsigned source_x = x << scale_shift;
+            ctx->row[x * 3] = y[base + source_x];
+            ctx->row[x * 3 + 1] = uv[base + (source_x & ~1u)];
+            ctx->row[x * 3 + 2] = uv[base + (source_x & ~1u) + 1];
+        }
+        JSAMPROW row = ctx->row;
+        jpeg_write_scanlines(&ctx->codec, &row, 1);
+    }
+    jpeg_finish_compress(&ctx->codec);
+    jpeg_destroy_compress(&ctx->codec); free(ctx->row);
+    if (ctx->output_bytes > capacity) { free(ctx->output); free(ctx); return 0; }
+    *output = ctx->output; *output_bytes = ctx->output_bytes;
+    free(ctx); return 1;
+}
+
+static int wonderlantern_nv16_jpeg(const uint8_t *y, size_t y_bytes,
+                                  const uint8_t *uv, size_t uv_bytes,
+                                  unsigned width, unsigned height, unsigned stride,
+                                  const uint8_t quantizers[2][64], size_t capacity,
+                                  unsigned char **output, size_t *output_bytes)
+{
+    return wonderlantern_nv16_jpeg_scaled(y, y_bytes, uv, uv_bytes, width, height,
+        stride, quantizers, capacity, 0, output, output_bytes);
+}
+
+#endif
diff --git a/hw/arm/nikon-z9-pcie.h b/hw/arm/nikon-z9-pcie.h
new file mode 100644
index 0000000..bae983e
--- /dev/null
+++ b/hw/arm/nikon-z9-pcie.h
@@ -0,0 +1,393 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Opt-in port2 functional DBI/unrolled-ATU adapter for upstream DesignWare.
+ * Native initialization matches these interfaces; physical IP identity and
+ * Nikon interrupt routing are unproved. No IRQ is wired to a guessed GIC pin.
+ */
+#define Z9_PCIE_DBI UINT64_C(0x1a800000)
+#define Z9_PCIE_ATU (Z9_PCIE_DBI + 0x300000)
+#define Z9_PCIE_CPU_WINDOW UINT64_C(0x600000000)
+
+static void z9_pcie_intx_update(NikonZ9State *s)
+{
+    if (s->pcie_intx_model) {
+        qemu_set_irq(s->pcie_legacy_irq, s->pcie_intx_pending &&
+                     s->pcie_wrapper[1][1] && !s->pcie_wrapper[1][0]);
+    }
+}
+
+static void z9_pcie_intx_input(void *opaque, int pin, int level)
+{
+    NikonZ9State *s = opaque;
+    uint32_t bit = 1U << (15 - pin);
+    if (level && !(s->pcie_intx_levels & bit)) {
+        s->pcie_intx_pending |= bit;
+        s->pcie_intx_assertions++;
+    }
+    if (level) {
+        s->pcie_intx_levels |= bit;
+    } else {
+        s->pcie_intx_levels &= ~bit;
+    }
+    z9_pcie_intx_update(s);
+}
+
+static PCIDevice *z9_pcie_root(NikonZ9State *s)
+{
+    return PCI_DEVICE(&DESIGNWARE_PCIE_HOST(s->pcie_dbi_host)->root);
+}
+
+static uint32_t z9_pcie_wrapper_link_input(NikonZ9State *s)
+{
+    PCIBus *bus = &PCI_BRIDGE(z9_pcie_root(s))->sec_bus;
+    /* Functional endpoint-present input for the original low-six-bit link
+     * query. This is not a PHY/LTSSM simulation or a measured Nikon value.
+     * Native4028cf50 selects wrapper+58 before4028d0e8 sets bit0 and polls
+     * +b4 for0x11. The separate+258 path corresponds to the other lane. */
+    bool endpoint = pci_find_device(bus, pci_bus_num(bus), PCI_DEVFN(0, 0));
+    uint32_t value = endpoint && s->pcie_wrapper[1][1] && !s->pcie_wrapper[1][0]
+                     ? 0x11 : 0;
+    if (s->pcie_link_status_reads++ < 16) {
+        fprintf(stderr, "Z9_PCIE_LINK_INPUT endpoint=%u enable=%x reset=%x value=%x; functional input\n",
+                endpoint, s->pcie_wrapper[1][1], s->pcie_wrapper[1][0], value);
+    }
+    return value;
+}
+
+static uint64_t z9_pcie_dbi_read(void *opaque, hwaddr addr, unsigned size)
+{
+    NikonZ9State *s = opaque;
+    if ((size != 1 && size != 2 && size != 4) || (addr & (size - 1))) {
+        unknown_access(s, Z9_PCIE_DBI + addr, 0, size, false);
+        return 0;
+    }
+    if (addr == 0x8bc && size == 4) {
+        return s->pcie_dbi_ro_enable;
+    }
+    s->pcie_dbi_reads++;
+    return pci_host_config_read_common(z9_pcie_root(s), addr, 4096, size);
+}
+
+static void z9_pcie_dbi_write(void *opaque, hwaddr addr, uint64_t value,
+                              unsigned size)
+{
+    NikonZ9State *s = opaque;
+    if ((size != 1 && size != 2 && size != 4) || (addr & (size - 1))) {
+        unknown_access(s, Z9_PCIE_DBI + addr, value, size, true);
+        return;
+    }
+    if (addr == 0x8bc) {
+        if (size != 4 || value > 1) {
+            unknown_access(s, Z9_PCIE_DBI + addr, value, size, true);
+            return;
+        }
+        /* Retained DBI programming-mode control. PCI config writes currently
+         * use upstream writable masks; no blanket bypass of readonly fields. */
+        s->pcie_dbi_ro_enable = value;
+        return;
+    }
+    s->pcie_dbi_writes++;
+    pci_host_config_write_common(z9_pcie_root(s), addr, 4096, value, size);
+}
+
+static bool z9_pcie_atu_select(NikonZ9State *s, hwaddr addr, unsigned size,
+                                unsigned *reg, unsigned *selection)
+{
+    static const unsigned legacy[] = {0x904, 0x908, 0x90c, 0x910,
+                                      0x914, 0x918, 0x91c};
+    unsigned region = addr / 0x200;
+    unsigned offset = addr % 0x100;
+    if (size != 4 || (addr & 3) || region >= DESIGNWARE_PCIE_NUM_VIEWPORTS ||
+        offset >= sizeof(legacy)) {
+        return false;
+    }
+    *reg = legacy[offset / 4];
+    *selection = region | ((addr & 0x100) ? (1U << 31) : 0);
+    return true;
+}
+
+static uint64_t z9_pcie_atu_read(void *opaque, hwaddr addr, unsigned size)
+{
+    NikonZ9State *s = opaque;
+    unsigned reg, selection;
+    if (!z9_pcie_atu_select(s, addr, size, &reg, &selection)) {
+        unknown_access(s, Z9_PCIE_ATU + addr, 0, size, false);
+        return 0;
+    }
+    PCIDevice *d = z9_pcie_root(s);
+    PCIDeviceClass *dc = PCI_DEVICE_GET_CLASS(d);
+    uint32_t previous = dc->config_read(d, 0x900, 4);
+    dc->config_write(d, 0x900, selection, 4);
+    uint32_t value = dc->config_read(d, reg, 4);
+    dc->config_write(d, 0x900, previous, 4);
+    return value;
+}
+
+static void z9_pcie_atu_write(void *opaque, hwaddr addr, uint64_t value,
+                              unsigned size)
+{
+    NikonZ9State *s = opaque;
+    unsigned reg, selection;
+    if (!z9_pcie_atu_select(s, addr, size, &reg, &selection) ||
+        (reg == 0x904 && value != 0 && value != 4 && value != 5) ||
+        (reg == 0x908 && value != 0 && value != 0x80000000) ||
+        ((reg == 0x910 || reg == 0x91c) && value > 255)) {
+        unknown_access(s, Z9_PCIE_ATU + addr, value, size, true);
+        return;
+    }
+    DesignwarePCIERoot *root = &DESIGNWARE_PCIE_HOST(s->pcie_dbi_host)->root;
+    DesignwarePCIEViewport *v = &root->viewports[selection >> 31][selection & 3];
+    if (reg == 0x908 && value) {
+        uint64_t limit = (v->base & ~UINT64_C(0xffffffff)) | v->limit;
+        if (limit < v->base || v->base >= (UINT64_C(1) << 40) ||
+            (selection >> 31 && v->cr[0] != 0)) {
+            unknown_access(s, Z9_PCIE_ATU + addr, value, size, true);
+            return;
+        }
+    }
+    PCIDevice *d = PCI_DEVICE(root);
+    PCIDeviceClass *dc = PCI_DEVICE_GET_CLASS(d);
+    uint32_t previous = dc->config_read(d, 0x900, 4);
+    dc->config_write(d, 0x900, selection, 4);
+    dc->config_write(d, reg, value, 4);
+    dc->config_write(d, 0x900, previous, 4);
+    s->pcie_atu_writes++;
+}
+
+static const MemoryRegionOps z9_pcie_dbi_ops = {
+    .read = z9_pcie_dbi_read, .write = z9_pcie_dbi_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4, .unaligned = true },
+    .impl = { .min_access_size = 1, .max_access_size = 4, .unaligned = true },
+};
+
+static const MemoryRegionOps z9_pcie_atu_ops = {
+    .read = z9_pcie_atu_read, .write = z9_pcie_atu_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4, .unaligned = true },
+    .impl = { .min_access_size = 1, .max_access_size = 4, .unaligned = true },
+};
+
+/* Native port2 setup4028ca18..cb84 programs local32-bit ATU offsets; the
+ * endpoint accessor4028d6e8 uses the separate 0x600000000 CPU aperture.
+ * CFG0 addresses the device on this link, without enumerating the synthetic
+ * upstream root bridge. Ordinary absolute upstream windows remain available
+ * for controlled tests. Physical IP identity/routing are still unproved. */
+static uint64_t z9_pcie_cpu_access(NikonZ9State *s, hwaddr addr,
+                                    uint64_t value, unsigned size, bool write)
+{
+    DesignwarePCIERoot *root = &DESIGNWARE_PCIE_HOST(s->pcie_dbi_host)->root;
+    if ((size != 1 && size != 2 && size != 4 && size != 8) || (addr & (size - 1))) {
+        goto unsupported;
+    }
+    for (unsigned i = 0; i < DESIGNWARE_PCIE_NUM_VIEWPORTS; i++) {
+        DesignwarePCIEViewport *v = &root->viewports[0][i];
+        if (!(v->cr[1] & 0x80000000) || v->base >= UINT64_C(0x100000000) ||
+            v->limit < v->base || addr < v->base || addr > v->limit ||
+            size - 1 > v->limit - addr) {
+            continue;
+        }
+        if (write) {
+            s->pcie_cpu_writes++;
+        } else {
+            s->pcie_cpu_reads++;
+        }
+        if (v->cr[0] == 4) {
+            PCIBus *bus = &PCI_BRIDGE(root)->sec_bus;
+            PCIDevice *endpoint = pci_find_device(bus, pci_bus_num(bus),
+                                                 (v->target >> 16) & 255);
+            uint64_t offset = addr - v->base;
+            if (size > 4 || offset >= 4096 || size > 4096 - offset) {
+                goto unsupported;
+            }
+            if (!endpoint) {
+                return UINT64_MAX;
+            }
+            if (write) {
+                pci_host_config_write_common(endpoint, offset, 4096, value, size);
+                return 0;
+            }
+            return pci_host_config_read_common(endpoint, offset, 4096, size);
+        }
+        if (v->cr[0] == 0) {
+            uint8_t bytes[8];
+            /* Upstream already owns a bounded MEM alias at this local
+             * address, including bridge/BAR decode and bus-master checks. */
+            if (write) {
+                for (unsigned b = 0; b < size; b++) {
+                    bytes[b] = value >> (b * 8);
+                }
+                cpu_physical_memory_write(addr, bytes, size);
+                return 0;
+            }
+            cpu_physical_memory_read(addr, bytes, size);
+            value = 0;
+            for (unsigned b = 0; b < size; b++) {
+                value |= (uint64_t)bytes[b] << (b * 8);
+            }
+            return value;
+        }
+        goto unsupported;
+    }
+unsupported:
+    unknown_access(s, Z9_PCIE_CPU_WINDOW + addr, value, size, write);
+    return 0;
+}
+
+static uint64_t z9_pcie_cpu_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return z9_pcie_cpu_access(opaque, addr, 0, size, false);
+}
+
+static void z9_pcie_cpu_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    z9_pcie_cpu_access(opaque, addr, value, size, true);
+}
+
+static const MemoryRegionOps z9_pcie_cpu_ops = {
+    .read = z9_pcie_cpu_read, .write = z9_pcie_cpu_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 8, .unaligned = true },
+    .impl = { .min_access_size = 1, .max_access_size = 8, .unaligned = true },
+};
