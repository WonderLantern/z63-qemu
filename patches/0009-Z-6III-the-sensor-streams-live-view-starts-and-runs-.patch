+/*
+ * Engine 0x150c's start acknowledgement. ../z9-qemu models the engine's
+ * second status bank -- +0x24c, mask +0x248, W1C, on INTID 0x107 -- for its
+ * Zr profile only, fed from outside (zr-primary-bank1-input). This image
+ * uses the same bank the same way: its 0x107 handler sub_40C1FAD4 reads and
+ * acknowledges +0x24c/+0x258/+0x264, and the callback sub_40CAE850
+ * accumulates +0x24c bits 5 and 6 and, once both have been seen, sets flag
+ * 0x10 of the engine's event object 0xA03051B60. The job thread
+ * (sub_40CADFD0) starts the engine (sub_40CAF2E4: +0x64, then +0x08) and,
+ * when the job enables engine bit 1, waits for that flag before it calls
+ * the start callback (0xA03051B88 = sub_410AC0E8, 0x422D0001), which tells
+ * FrontEnd 0x41D0001; FrontEnd sets 0xA04072F10 bit 2, which its mode-1
+ * start (sub_41031258) waits 400 ms for before it reports the front end
+ * ready to CaptureSequence (CSEQEV10 bit 3).
+ *
+ * What the two bits are is read from where the firmware needs them, not
+ * from a register description: CaptureSequence only starts the sensor
+ * streaming (sub_41166E50 -> the SDES channel start sub_40C29DF8, which
+ * sets the sensor interface's +0x10) after that ready report, so the bits
+ * cannot be frame events from the sensor. They are treated as the engine
+ * acknowledging the start of its primary path: raised once each time
+ * engine bit 1 becomes active (z9 model state engine150c_active), through
+ * the Zr model's own pending/mask/W1C, which then behaves as ../z9-qemu
+ * wrote it. The firmware programs +0x248 = 0x70 before the first start.
+ */
+static void z63_z9lab_150c_started(NikonZ9State *s)
+{
+    static bool named;
+
+    s->zr_primary_bank1_pending |= 0x60;
+    s->zr_primary_bank1_inputs++;
+    zr_primary_bank1_irq_update(s);
+    if (!named) {
+        named = true;
+        fprintf(stderr, "Z63_150C: primary path started; start acknowledged "
+                "(+0x24c bits 5,6, mask 0x%x, INTID 0x107) -- see "
+                "z9lab_attach.c.in\n", s->engine_150c_init[0x248 / 4]);
+    }
+}
+
 Object *z63_z9lab_new(Object *owner, DeviceState *gic, uint64_t ram_size,
                       const char *props, Error **errp);
 bool z63_z9lab_read(Object *obj, hwaddr addr, unsigned size,
@@ -14289,6 +14330,14 @@ Object *z63_z9lab_new(Object *owner, DeviceState *gic, uint64_t ram_size,
         timer_mod(s->raw_pipeline_timer,
                   qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 33333333);
     }
+    if (s->zr_primary_bank1_model) {
+        if (!s->engine150c_stop_model) {
+            error_setg(errp, "z9-capture: zr-primary-bank1-model needs "
+                       "engine150c-stop-model");
+            goto fail;
+        }
+        s->zr_primary_bank1_irq = qdev_get_gpio_in(gic, 0x107 - 32);
+    }
     s->event_aux0_irq = qdev_get_gpio_in(gic, 0x102 - 32);
     s->event_aux1_irq = qdev_get_gpio_in(gic, 0x104 - 32);
     s->event_channel_irq = qdev_get_gpio_in(gic, 0xfe - 32);
@@ -14348,9 +14397,14 @@ bool z63_z9lab_read(Object *obj, hwaddr addr, unsigned size, uint64_t *value)
 bool z63_z9lab_write(Object *obj, hwaddr addr, uint64_t value, unsigned size)
 {
     NikonZ9State *s = NIKON_Z9_LAB(obj);
+    uint32_t was = s->engine150c_active;
 
     s->compat_miss = false;
     unknown_write(s, addr, value, size);
+    if (addr == 0x150c0008 && s->zr_primary_bank1_model &&
+        (s->engine150c_active & ~was & 2)) {
+        z63_z9lab_150c_started(s);
+    }
     return !s->compat_miss;
 }
 
