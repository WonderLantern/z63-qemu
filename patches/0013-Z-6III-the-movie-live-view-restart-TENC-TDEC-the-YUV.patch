+    0x0370, 0x0374, 0x0378, 0x037c, 0x0404,
+    0x0500, 0x0504, 0x0508, 0x050c, 0x0510,
+    0x0514, 0x0518, 0x051c, 0x0520, 0x0524, 0x0528, 0x052c,
+    0x0530, 0x0534, 0x0538, 0x053c, 0x0540, 0x0544, 0x0548, 0x054c,
+    0x0550,
