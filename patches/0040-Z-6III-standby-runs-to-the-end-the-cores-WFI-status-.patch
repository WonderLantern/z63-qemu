diff --git a/hw/arm/nikon-z63-z9lab.c b/hw/arm/nikon-z63-z9lab.c
index d3e4436..1034d1e 100644
--- a/hw/arm/nikon-z63-z9lab.c
+++ b/hw/arm/nikon-z63-z9lab.c
@@ -12237,6 +12237,27 @@ static uint32_t engine1542_mask(unsigned i, unsigned off)
     return 0;
 }
 
+/* Z 6III (z63-lv-frame-done, z9lab_attach.c.in): the words the live
+ * view's histogram writes to the RSZ E unit (instance 14, 0x15430100) --
+ * sub_40C2767C's geometry (from sub_40C26618, base + 0x10100) and the
+ * start 0x40c27670 (sub_40C2614C) -- with the bits each store can set. */
+static uint32_t z63_e_histogram_mask(unsigned off)
+{
+    switch (off) {
+    case 0x00: return 1;            /* start */
+    case 0x04: return 0xf3;         /* 2 + 4 bits */
+    case 0x08: return 0xf;          /* four enables */
+    case 0x0c: return 0x7f7f;       /* two 7-bit fields */
+    case 0x10: return 0xfff;        /* byte | byte << 4 | 3 bits << 8 */
+    case 0x20: case 0x24: case 0x28: case 0x2c:
+        return 0x07ff07ff;          /* 11-bit pairs */
+    case 0x30: return 0x7ff;
+    case 0x40: return 0x1fff1fff;   /* 13-bit pair */
+    case 0x44: return 0x1fff;
+    default: return 0;
+    }
+}
+
 static bool engine1542_read(NikonZ9State *s, hwaddr addr, unsigned size,
                             uint64_t *value)
 {
@@ -12245,6 +12266,10 @@ static bool engine1542_read(NikonZ9State *s, hwaddr addr, unsigned size,
     if (i < 0) {
         return false;
     }
+    if (s->raw_pipeline_output_done && i == 14 && z63_e_histogram_mask(off)) {
+        *value = s->engine1542_config[i][off / 4];
+        return true;
+    }
     if (off == engine1542_status(i)) {
         *value = s->engine1542_pending[i];
         return true;
@@ -12518,6 +12543,19 @@ static bool engine1542_write(NikonZ9State *s, hwaddr addr, uint64_t value,
             unknown_access(s, addr, value, size, true); return true;
         }
     }
+    if (s->raw_pipeline_output_done && i == 14 && z63_e_histogram_mask(off)) {
+        /* z63-lv-frame-done: a start arms E's next frame end, as its
+         * enable does; storage otherwise. */
+        if (value & ~(uint64_t)z63_e_histogram_mask(off)) {
+            unknown_access(s, addr, value, size, true);
+            return true;
+        }
+        s->engine1542_config[i][off / 4] = value;
+        if (off == 0 && value == 1) {
+            s->z63_e_armed = true;
+        }
+        return true;
+    }
     uint32_t mask = engine1542_mask(i, off);
     if (!mask) {
         return false;
@@ -18622,7 +18660,12 @@ static bool z63_z9lab_lane0_ack_on;
