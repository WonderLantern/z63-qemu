     }
     s->event_timing_ticks++;
+    /* z63-vd-statistics (z9lab_attach.c.in): one statistics delivery per
+     * frame boundary, owed while the last one is unacknowledged. */
+    if (s->z63_vd_statistics && statistics_active(s)) {
+        if (s->statistics_pending) {
+            s->statistics_owed = true;
+        } else {
+            statistics_tick(s);
+        }
+    }
     /* Explicit counterfactual: one primary bit2 input at this lab clock
      * boundary. The real callback maps it to 041d0001; neither physical
      * sensor timing nor a pixel transfer is claimed by this input. */
@@ -6179,6 +6216,14 @@ static void event_timing_expire(void *opaque)
     if (s->engine150c_bit6_model) {
         engine150c_bit6_pulse(s);
     }
+    /* z63-lv-frame-done (z9lab_attach.c.in): the RAW pipeline's frame on
