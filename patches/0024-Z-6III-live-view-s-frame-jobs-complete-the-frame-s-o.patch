+    }
     s->event_aux0_inputs++;
     s->event_channel_inputs++;
     /* Opt-in paired auxiliary boundaries. The original4115ab5c maps
@@ -7844,6 +7889,15 @@ static void statistics_update(NikonZ9State *s)
     if (!s->statistics_timer) {
