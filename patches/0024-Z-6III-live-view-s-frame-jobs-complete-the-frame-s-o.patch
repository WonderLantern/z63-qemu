     if (boundary_ms) {
         Z63Z9Boundary *b = g_new0(Z63Z9Boundary, 1);
 
@@ -354,6 +584,7 @@ Object *z63_z9lab_new(Object *owner, DeviceState *gic, uint64_t ram_size,
         }
