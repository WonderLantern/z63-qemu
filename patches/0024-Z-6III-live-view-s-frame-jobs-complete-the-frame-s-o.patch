+            statistics_tick(s);
+        }
+        return;
+    }
     if (!statistics_active(s) || s->statistics_pending) {
         timer_del(s->statistics_timer);
     } else if (!timer_pending(s->statistics_timer)) {
@@ -8971,7 +9025,8 @@ static bool engine150c_stop_write(NikonZ9State *s, hwaddr addr,
                                                 (s->engine150c_bit2_model ? 4 : 0) |
                                                 (s->engine150c_bit6_model ? 0x40 : 0)) :
                            (primary_direct_map(direct_engines, 1, false) | (s->statistics_model ? 0x20 : 0) |
-                            (s->raw_pipeline_model ? 0x60000000 : 0));
+                            (s->raw_pipeline_model ? 0x60000000 : 0) |
+                            (s->z63_path2_end ? 0x80000000u : 0));
         if (size != 4 || (value & ~allowed)) {
             goto invalid;
         }
@@ -10030,6 +10085,9 @@ static bool engine1518_write(NikonZ9State *s, hwaddr addr, uint64_t value,
              * This normal completion is distinct from forced drain bit22. */
             e->pending |= 1u << 21;
         }
+        if (value && !e->config[off / 4]) {
+            e->z63_frames = 0;          /* z63-lv-frame-done */
+        }
         e->config[off / 4] = value;
         engine1518_update_irq(e);
         fprintf(stderr, "Z9_1518_GATE instance=%d value=%" PRIu64 "\n", i, value);
@@ -10978,6 +11036,9 @@ static bool engine1542_write(NikonZ9State *s, hwaddr addr, uint64_t value,
         return true;
     }
     s->engine1542_config[i][off / 4] = value;
+    if (i == 14 && off == 0x50 && (value & 1)) {
+        s->z63_e_armed = true;          /* z63-lv-frame-done */
+    }
     if (s->raw_pipeline_model && i == 10 && off >= 0x200 && off < 0x600 &&
         (off & 0x7f) < 0x40) {
         unsigned bank = (off - 0x200) / 0x200;
@@ -14200,6 +14261,8 @@ typedef struct Z63Z9Boundary {
     uint64_t deliveries, aux_deliveries;
     bool frame_end;                     /* z63-150c-frame-end */
     uint64_t frame_ends;
+    bool path2_end;                     /* z63-150c-path2-end */
+    uint64_t path2_ends;
 } Z63Z9Boundary;
 
 /*
@@ -14244,6 +14307,106 @@ static void z63_z9lab_150c_frame_end(Z63Z9Boundary *b)
     }
 }
 
+/*
+ * Engine 0x150c's +0x210 bit 31, for the engine-bit-2 path. Live view runs
+ * the engine with bits 1 and 2 active (engine150c_active 6), and the
+ * firmware enables +0x210 bits 29, 30 and 31 (+0x20c = 0xe0240048, from
+ * boot, sub_40C202DC). Bits 29 and 30 are the frame ends of engine bits 1
+ * and 16 (above, and ../z9-qemu's own analysis); nothing here raised bit
+ * 31. Its reader: the 0x106 ISR sub_40C1F978 passes +0x204/+0x210/+0x21c
+ * as event 0x41110001 through sub_40CAE2EC to the front end's
+ * sub_410AB2F8, which forwards +0x210 bit 31 as 0x41d0013 (0x410abc00 ->
+ * 0x410abc3c) to its type-0x12 consumers. One of them is the live-view
+ * module's sub_40E69B78, which sets flag 0x80000 of 0xa03d22008 in mode 5;
+ * lane 2 of every live-view frame job but the first (sub_40E789CC, mode 5)
+ * waits for that flag with no timeout, so the second frame never
+ * completed.
+ *
+ * z63-150c-path2-end (default on) raises bit 31 at each frame boundary
+ * while engine bit 2 is live (active, not being stopped) and the
+ * firmware's +0x20c enables it, through the same pending word, mask and
+ * W1C as bits 29/30 (the import admits bit 31 to +0x210's W1C when this is
+ * on). DECLARED: that bit 31 belongs to engine bit 2 is an inference -- it
+ * is the only enabled +0x210 boundary bit left, and engine bit 2 the only
+ * live path without one -- and its timing is the boundary's, not
+ * measured.
+ */
+static void z63_z9lab_150c_path2_end(Z63Z9Boundary *b)
+{
+    NikonZ9State *s = b->s;
+    uint32_t live = s->engine150c_active & ~s->engine150c_stop_requested;
+    uint32_t bit = 0x80000000u & s->engine_150c_init[0x20c / 4] &
+                   ~s->raw_primary_pending;
+
+    if (!b->path2_end || !(live & 4) || !bit) {
+        return;
+    }
+    s->raw_primary_pending |= bit;
+    s->raw_primary_events++;
+    engine150c_stop_irq_update(s);
+    if (b->path2_ends++ == 0) {
+        fprintf(stderr, "Z63_150C: engine bit 2 path frame end (+0x210 bit "
+                "31) at the frame boundary -- see z9lab_attach.c.in\n");
+    }
+}
+
+/*
+ * The sensor's frame timing while capture group 0 is off. ../z9-qemu's
+ * frame timing (event_timing_expire: aux0, channel, global0 bit 7, global1
+ * bit 7, and with this board statistics and engine 0x150c's bit 2) runs
+ * only while groups 0 and 3 of the 0x1508 block are enabled, and restarts
+ * its period whenever they are. This image turns group 0 off and on again
+ * every frame or two while live view runs, a sensor-mode cycle: each frame
+ * sub_41169F08 (from CaptureSequence's sub_40F3F814) stops group 0
+ * (0x4116a050 -> sub_4116E6A8(0)) when the cycle at 0xa04ce11a8 calls for
+ * it; the channel-0 frame callback sub_4115C5D0 (the 0x1508 channel
+ * handler sub_40C2B438 dispatches +0x48 bit 0 to it) counts 0xa04ce11a8 up
+ * to 0xa04ce11aa and tells CaptureSequence 0x203000c, whose handler
+ * (sub_40F3FA6C, 0x40f4009c) arms the restart (event 0x20 -> sub_40F3AD88
+ * -> sub_4116A4BC), which waits for flag 4 of 0xa04ce0da0 -- set by the
+ * global0 callback sub_4115C8A4 on status bit 7, the next frame boundary
+ * -- and turns group 0 back on (sub_4116E694(0)). With the timing stopped
+ * there was no frame to count and no boundary: group 0 stayed off, the
+ * per-frame engine 0x150c and statistics inputs stopped with it, live view
+ * stalled after about a second, and CaptureSequence's frame watchdog ended
+ * it with error 0x40. And with the period restarted at each enable, a
+ * group that is on for less than a period never saw a frame at all.
+ *
+ * z63-sensor-vd (default on): once capture has run, the frame clock keeps
+ * its period while group 3 is on and engine 0x150c's primary path (engine
+ * bit 1) is live and not being stopped -- the image pipeline still expects
+ * the sensor's frames. At a tick with group 0 off it raises only the
+ * sensor's own frame events, channel bit 0 and global0 bit 7, through the
+ * z9 model's pending words, masks and W1C; the capture events (aux0,
+ * statistics, engine 0x150c bit 2, a RAW frame) stay with group 0.
+ * DECLARED: the sensor's frame timing carries on while a capture group is
+ * disabled; nothing of the stream is produced then.
+ */
+static bool z63_sensor_timing(NikonZ9State *s)
+{
+    uint32_t live = s->engine150c_active & ~s->engine150c_stop_requested;
+
+    return s->z63_sensor_vd && s->z63_sensor_started &&
+           s->event1508_timing_model && s->event_timing_period_ns &&
+           (s->event_control_1508[3] & 1) && (live & 2);
+}
+
+static void z63_sensor_frame(NikonZ9State *s)
+{
+    s->event_pending_1508 |= 1;
+    s->event_channel_inputs++;
+    event_channel_update_irq(s);
+    if (s->event1508_global0_model) {
+        s->event_global0_pending |= 0x80;
+        s->event_global0_inputs++;
+        event_global0_update_irq(s);
+    }
+    if (s->z63_sensor_frames++ == 0) {
+        fprintf(stderr, "Z63_1508: sensor frame (channel bit 0, global0 bit "
+                "7) with capture group 0 off -- see z9lab_attach.c.in\n");
+    }
+}
+
 static void z63_z9lab_boundary_tick(void *opaque)
 {
     Z63Z9Boundary *b = opaque;
@@ -14260,6 +14423,7 @@ static void z63_z9lab_boundary_tick(void *opaque)
         b->aux_deliveries++;
     }
     z63_z9lab_150c_frame_end(b);
+    z63_z9lab_150c_path2_end(b);
     b->deliveries++;
     timer_mod(b->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + b->period_ns);
 }
@@ -14338,6 +14502,81 @@ static void z63_z9lab_150c_started(NikonZ9State *s)
  */
 static bool z63_z9lab_lane0_ack_on;
 
+/*
+ * A live-view frame's other completions. In this image a frame is a job
+ * of several lanes (stage table 0xa02bde320), and it completes only when
+ * every lane's stages have run (0x40d1aac0 polls them); each stage waits
+ * on an event a device's interrupt posts. ../z9-qemu's combined pipeline
+ * raises the RSZ's A0 bits 0/4 and C0 bits 0/3 after a frame's writes,
+ * which serves the RSZ's own lane, and live view ran one frame, then
+ * stopped: the job pool ran dry and CaptureSequence's frame watchdog
+ * ended it with error 0x40. What the other lanes wait for:
+ *
+ *   - lane 2, sub_40E789CC: an output writer's frame end, B0..B2 status
+ *     bit 12 (the RSZ ISR sub_40C25CE8 reports B to sub_40CB8700 under
+ *     the subscription 0x1000 the live-view set-up leaves at 0xa02dc48a4;
+ *     the client callback sub_40E6F56C turns it into flag 0x200000);
+ *   - lane 1, sub_40E75790: FRECT_LV (device 0x1ce, 0x151c0000, INTID
+ *     0xf8; this model's engine1518[2]) status bit 27 once a frame, and
+ *     bit 29 when a bank of four rows is done -- sub_40E69FB8 counts bit
+ *     27 modulo 4 at 0xa03d26eb0 and, when the count reaches 3, waits for
+ *     bit 29 (flag 0x800000) before flipping banks (sub_40E5F9B4). The
+ *     firmware enables both in +0x08 (0x39f00000) and clears them through
+ *     +0x0c, as for the stop bits 21/22 above;
+ *   - lane 3, sub_40E76A60: after enabling the RSZ's one-shot E unit
+ *     (0x11 to +0x10150, sub_40C26234), its status bit 0 (+0x10154,
+ *     event 0x41160002);
+ *   - lane 0, sub_40E76080 (second stage): flag 0x200 of 0xa03d22008,
+ *     which sub_40E6DEC8 sets on event 0x410b0002 when the status it is
+ *     given has bit 3. That event is MIPU_LV's (device 0x1d0, 0x15140000,
+ *     INTID 0x10e; this model's engine151[1]): its handler sub_40C0D7C4
+ *     reads +0x44, writes it back and passes it as the event's argument.
+ *     ../z9-qemu's later revision (deb3a75, raw-pipeline-1514-completion-
+ *     model) found the same bit 3 completion after the RAW-derived writes
+ *     in the ZR image.
+ *
+ * z63-lv-frame-done (default on) raises them with the frame's other bits:
+ * B0..B2 bit 12; FRECT_LV, while its gate is open, bit 27 and, on the
+ * third frame since the gate opened and every fourth after, bit 29; E bit
+ * 0 at the first frame after it is enabled; MIPU_LV bit 3, through the
+ * model's own +0x44 pending, +0x40 mask and W1C. And it makes its frames
+ * on the capture tick of the sensor's frame timing -- the tick that also
+ * delivers the frame's statistics and engine 0x150c's bit 2 -- instead of
+ * on a 33.3 ms clock of its own: the sensor-mode cycle below turns capture
+ * group 0 off and on every frame or two in a long exposure, and a RAW
+ * frame made outside a capture tick had no statistics and no exposure-
+ * module frame end, so its job's lane 1 (sub_40E7383C) waited for ever.
+ * A tick whose frame cannot be made yet -- the last one not acknowledged
+ * -- owes it (up to two), and it is made as soon as it can be.
+ * ../z9-qemu's later revision likewise gates its new DMA on that timing.
+ * DECLARED: these meanings are
+ * read from what the firmware subscribes and waits for, not measured, and
+ * bit 29's phase is the one the firmware's own counter expects. Never A
+ * bits 8/12 or B bit 8: sub_40CB8700 takes those as errors and ends the
+ * run (sub_40CBA3FC).
+ */
+static bool z63_z9lab_lv_frame_done_on = true;
+
+/*
+ * Statistics per frame. ../z9-qemu's statistics model delivers a frame of
+ * statistics 33.3 ms after the firmware acknowledged the last one, on a
+ * clock of its own, so the deliveries drift against the sensor's frames.
+ * This image pairs them: each live-view frame job's lane 1 (sub_40E7383C)
+ * waits, with no timeout, for the exposure module's end of that frame --
+ * bit (frame id % 31) of 0xa03d22020, posted from event 0x40f0008
+ * (sub_41020C74 / sub_4102F2B0 -> sub_40F57A70 -> sub_40E80BE4) -- and a
+ * frame that had no statistics never gets one. z63-vd-statistics (default
+ * on) delivers one frame of statistics on each capture tick of the sensor's
+ * frame timing (event_timing_expire), the tick that also makes the RAW
+ * frame (z63-lv-frame-done), and, when the last delivery is still
+ * unacknowledged then, as soon as it is. DECLARED: one statistics frame per
+ * captured sensor frame, which is what the firmware's per-frame bookkeeping
+ * assumes; the content is the model's, as before.
+ */
+static bool z63_z9lab_vd_statistics_on = true;
+
+
+
 static void z63_z9lab_lane0_ack(NikonZ9State *s)
 {
     static uint64_t acks;
@@ -14368,6 +14607,8 @@ Object *z63_z9lab_new(Object *owner, DeviceState *gic, uint64_t ram_size,
     g_auto(GStrv) items = g_strsplit(props ? props : "", ";", -1);
     uint64_t boundary_ms = 0;
     bool frame_end = false;
+    bool path2_end = false;
+    bool sensor_vd = false;
     bool lane0_ack = false;
 
     s->compat = true;
@@ -14391,6 +14632,41 @@ Object *z63_z9lab_new(Object *owner, DeviceState *gic, uint64_t ram_size,
