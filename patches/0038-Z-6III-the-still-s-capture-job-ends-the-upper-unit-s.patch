 4 files changed, 40 insertions(+), 12 deletions(-)

diff --git a/hw/arm/nikon-z63-z9lab.c b/hw/arm/nikon-z63-z9lab.c
index ca7358a..01668ce 100644
--- a/hw/arm/nikon-z63-z9lab.c
+++ b/hw/arm/nikon-z63-z9lab.c
@@ -18682,12 +18682,24 @@ static void z63_z9lab_lane0_ack(NikonZ9State *s)
  *     and the periodic D980 path stays quiet, so the still's data is
  *     written once, at that request. Each still re-arms the writer's done
  *     status (group1 bit 26), which this image never acknowledges.
- *     With the frame, the upper unit's frame ends: +0x204 bit 6, which the
- *     0x106 ISR's callback sub_40CAE2EC passes to the front end as
- *     0x41D0005 (the upper unit's +0x14 bit 0 is clear for this job).
+ *     With the frame, the upper unit's frame ends: +0x204 bit 6;
+ *   - the capture job (0x422D0001, posted by sub_4102C770 with the units
+ *     0x401e) ends only on job flag 1, which the 0x106 ISR's callback
+ *     sub_40CAE2EC raises for bit 6 when the upper's +0x10 or +0x14 bit 0
+ *     is set (sub_40CAD5F0 -> sub_40C1F1B0). Nothing else in the image
+ *     sets them but the upper's configuration (slot +40, sub_40C1DF50),
+ *     and for live view that comes from a per-mode parameter table at
+ *     0x47e80000 + 0x66f0 (sub_411712C8), in resource 0x5f of SNOR_USER,
+ *     which this image's SNOR_USER holds only in part: the table is zeros.
+ *     The capture job's own upper configuration is empty. So the still's
+ *     frame end also sets +0x14 bit 0, until the next configuration of
+ *     the upper writes it again; bit 6 then ends the capture job, whose
+ *     completion (0x41D0001, sub_410B05A8) is the front end's flag 0x4000.
  *
- * DECLARED: when the still frame arrives and that its frame end comes with
- * it. The edits are in import_z9lab.py (section 8) and nikon-z9-d980.h.
+ * DECLARED: when the still frame arrives, that its frame end comes with
+ * it, and that it marks a capture's frame (+0x14 bit 0) in place of the
+ * missing parameter. The edits are in import_z9lab.py (section 8) and
+ * nikon-z9-d980.h.
  */
 
 Object *z63_z9lab_new(Object *owner, DeviceState *gic, uint64_t ram_size,
diff --git a/hw/arm/nikon-z9-d980.h b/hw/arm/nikon-z9-d980.h
index 159a24a..8733410 100644
--- a/hw/arm/nikon-z9-d980.h
+++ b/hw/arm/nikon-z9-d980.h
@@ -183,8 +183,10 @@ static void primary_d980_single_tick(void *opaque)
         s->primary_d980_single_frames++;
         if (s->z63_still) {
             /* z63-still-capture: the upper unit's frame ends with the
-             * still's data, +0x204 bit 6 (z9lab_attach.c.in). */
+             * still's data, +0x204 bit 6, and its +0x14 bit 0 says it
+             * was a capture's frame (z9lab_attach.c.in). */
             s->engine150c_bit6_pending |= 0x40;
+            s->engine_150c_primary[0x14 / 4] |= 1;
             s->z63_still_ends++;
             engine150c_stop_irq_update(s);
         }
