+++ b/run-z63.sh
@@ -0,0 +1,30 @@
+#!/bin/sh
+# Run the Z 6III RTOS research machine.
+# Usage: ./run-z63.sh [-d] [-g] [extra qemu args...]
+#   -d  single-step debug logging (guest_errors + unmapped)
+#   -g  wait for GDB on :1234
+set -e
+cd "$(dirname "$0")"
+
+EG=${EG:-/Users/libr/Desktop/life/nikon/out/z63/Z6_3_0200_modules/eg2010_0200i1.bi}
+QEMU=${QEMU:-./build/qemu-system-aarch64}
+EXTRA="-serial stdio -monitor none -display none"
+DEBUG=""
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        -d) DEBUG="-d guest_errors,unimp -D /tmp/z63-qemu.log" ;;
+        -g) EXTRA="$EXTRA -S -gdb tcp::1234" ;;
+        *)  EXTRA="$EXTRA $1" ;;
+    esac
+    shift
+done
+
+# shellcheck disable=SC2086
+exec "$QEMU" \
+    -machine nikon-z63 \
+    -cpu cortex-a53 \
+    -smp 4 \
+    -bios "$EG" \
+    $DEBUG \
+    $EXTRA
