+    li = os.environ.get('LI')
+    if li and os.path.exists(li):
+        opt += ',li-image=' + li + ',cpu3-entry=0xa07800000'
+    cmd = [qemu, '-machine', opt, '-cpu', 'cortex-a53',
            '-smp', '4', '-bios', eg, '-serial', 'null', '-monitor', 'none',
            '-display', 'none', '-d', 'exec', '-D', log]
     proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
